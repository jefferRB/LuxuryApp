@model LuxuryApp.Models.Identity.EnrolarMfaViewModel

@{
    ViewData["Title"] = "Verificación en dos pasos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .mfa-card {
        max-width: 640px;
        margin: 40px auto;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(15, 23, 42, 0.12);
        padding: 32px;
    }

    .mfa-card h1 {
        font-size: 1.5rem;
        margin-bottom: 8px;
    }

    .mfa-step {
        display: flex;
        gap: 14px;
        margin-top: 22px;
    }

    .mfa-step-number {
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #eef2ff;
        color: #4338ca;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    #mfa-qr {
        margin: 14px 0;
        padding: 12px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        display: inline-block;
    }

    .mfa-key {
        font-family: monospace;
        font-size: 1.05rem;
        letter-spacing: 1px;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        padding: 10px 14px;
        display: inline-block;
        user-select: all;
    }

    .mfa-code-input {
        max-width: 220px;
        font-size: 1.3rem;
        letter-spacing: 6px;
        text-align: center;
    }

    .mfa-active-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ecfdf5;
        color: #047857;
        border-radius: 999px;
        padding: 8px 16px;
        font-weight: 600;
    }
</style>

<div class="mfa-card">
    @if (TempData["SeguridadMensaje"] is string mensaje)
    {
        <div class="alert alert-success">@mensaje</div>
    }

    @if (Model.TwoFactorActivo)
    {
        <h1>Verificación en dos pasos</h1>
        <p class="mfa-active-badge"><i class="bi bi-shield-check"></i> Activa en tu cuenta</p>
        <p class="text-muted mt-3">
            Al iniciar sesión se te pedirá el código de tu aplicación de autenticación.
            Si pierdes el acceso a tu teléfono, usa uno de tus códigos de recuperación.
        </p>

        @if (Model.PuedeDeshabilitar)
        {
            <form asp-controller="Seguridad" asp-action="Deshabilitar" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger"
                        onclick="return confirm('¿Deshabilitar la verificación en dos pasos? Tu cuenta quedará protegida solo por contraseña.');">
                    Deshabilitar verificación en dos pasos
                </button>
            </form>
        }
        else
        {
            <p class="text-muted small mt-3">
                <i class="bi bi-info-circle"></i>
                La verificación en dos pasos es obligatoria para cuentas de plataforma y no puede deshabilitarse.
            </p>
        }
    }
    else
    {
        <h1>Activa la verificación en dos pasos</h1>
        <p class="text-muted">
            Protege tu cuenta con un código de un solo uso además de tu contraseña.
        </p>

        <div class="mfa-step">
            <span class="mfa-step-number">1</span>
            <div>
                <strong>Instala una aplicación de autenticación</strong>
                <p class="text-muted mb-0">Google Authenticator, Microsoft Authenticator o cualquier app compatible (TOTP).</p>
            </div>
        </div>

        <div class="mfa-step">
            <span class="mfa-step-number">2</span>
            <div>
                <strong>Escanea este código QR</strong>
                <div id="mfa-qr" data-otpauth="@Model.OtpauthUri"></div>
                <p class="text-muted mb-1">¿No puedes escanear? Ingresa esta clave manualmente:</p>
                <span class="mfa-key">@Model.ClaveFormateada</span>
            </div>
        </div>

        <div class="mfa-step">
            <span class="mfa-step-number">3</span>
            <div class="w-100">
                <strong>Ingresa el código que muestra la aplicación</strong>
                <form asp-controller="Seguridad" asp-action="Confirmar" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <div class="text-danger" asp-validation-summary="All"></div>
                    <input asp-for="Codigo" class="form-control mfa-code-input" autocomplete="one-time-code"
                           inputmode="numeric" placeholder="000000" autofocus />
                    <button type="submit" class="btn btn-primary mt-3">Verificar y activar</button>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    @if (!Model.TwoFactorActivo)
    {
        <script src="~/lib/qrcodejs/qrcode.min.js"></script>
        <script>
            (function () {
                var container = document.getElementById("mfa-qr");
                if (container && window.QRCode) {
                    new QRCode(container, {
                        text: container.dataset.otpauth,
                        width: 180,
                        height: 180,
                        correctLevel: QRCode.CorrectLevel.M
                    });
                }
            })();
        </script>
    }
}
