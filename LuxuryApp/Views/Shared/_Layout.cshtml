@inject LuxuryApp.Services.Layout.IPrivateNavigationService NavigationService

@{
    var navigation = await NavigationService.BuildAsync(User);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LuxuryApp</title>
    <script>
        (function () {
            var presets = {
                "classic-marble": { background: "marble", surface: "classic" },
                "futuristic-premium": { background: "futuristic", surface: "glass" }
            };

            function hasPreset(value) {
                return Object.prototype.hasOwnProperty.call(presets, value);
            }

            function resolveAppearance() {
                var preset = localStorage.getItem("luxury-appearance-preset");

                if (hasPreset(preset)) {
                    return {
                        preset: preset,
                        background: presets[preset].background,
                        surface: presets[preset].surface
                    };
                }

                var storedBackground = localStorage.getItem("luxury-bg-theme");
                var storedSurface = localStorage.getItem("luxury-surface-theme");

                if (storedBackground === "futuristic" && storedSurface === "glass") {
                    return {
                        preset: "futuristic-premium",
                        background: "futuristic",
                        surface: "glass"
                    };
                }

                if (storedBackground === "marble" && storedSurface === "classic") {
                    return {
                        preset: "classic-marble",
                        background: "marble",
                        surface: "classic"
                    };
                }

                var legacyTheme = localStorage.getItem("luxury-theme");

                if (legacyTheme === "futuristic") {
                    return {
                        preset: "futuristic-premium",
                        background: "futuristic",
                        surface: "glass"
                    };
                }

                return {
                    preset: "classic-marble",
                    background: "marble",
                    surface: "classic"
                };
            }

            try {
                var appearance = resolveAppearance();

                document.documentElement.setAttribute("data-luxury-appearance-preset", appearance.preset);
                document.documentElement.setAttribute("data-luxury-bg-theme", appearance.background);
                document.documentElement.setAttribute("data-luxury-surface-theme", appearance.surface);
                document.documentElement.setAttribute("data-luxury-theme", appearance.background);
                document.documentElement.classList.add("theme-bg-" + appearance.background);
                document.documentElement.classList.add("surface-" + appearance.surface);
            } catch (error) {
                document.documentElement.setAttribute("data-luxury-appearance-preset", "classic-marble");
                document.documentElement.setAttribute("data-luxury-bg-theme", "marble");
                document.documentElement.setAttribute("data-luxury-surface-theme", "classic");
                document.documentElement.setAttribute("data-luxury-theme", "marble");
                document.documentElement.classList.add("theme-bg-marble");
                document.documentElement.classList.add("surface-classic");
            }
        })();
    </script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="~/css/calendar.css" />
    <link rel="stylesheet" href="~/css/mensajes.css" />
    <link rel="stylesheet" href="~/css/Dashboard.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/private-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LuxuryApp.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="layout-background private-shell theme-bg-marble surface-classic theme-marble @(ViewData["FullScreen"] as string)">
    <div class="private-layout-frame">
        <header class="private-header">
            <partial name="_PrivateNavbar" model="navigation" />

        
        </header>

        <div class="container private-content-shell">
            <main role="main" class="pb-4 private-main">
                @RenderBody()
            </main>
        </div>

        <footer class="private-footer text-muted">
            <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
                <span>&copy; 2026 - LuxuryApp</span>
                <a href="/privacidad">Privacidad</a>
            </div>
        </footer>
    </div>

    @if (navigation.IsAuthenticated)
    {
        <div class="modal fade theme-style-modal" id="themeStyleModal" tabindex="-1" aria-labelledby="themeStyleModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content private-theme-modal">
                    <div class="modal-header private-theme-modal-header">
                        <div>
                            <span class="private-theme-modal-kicker">Personalizacion visual</span>
                            <h5 class="modal-title private-theme-modal-title" id="themeStyleModalLabel">Apariencia del espacio de trabajo</h5>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body private-theme-modal-body">
                        <p class="private-theme-modal-copy">
                            Elige una apariencia para el espacio privado. El cambio se aplica de inmediato y se conserva solo en este navegador.
                        </p>

                        <div class="private-theme-grid">
                            <button type="button"
                                    class="private-theme-card"
                                    data-luxury-appearance-option="classic-marble"
                                    aria-pressed="false">
                                <span class="private-theme-card-preview private-theme-card-preview-marble" aria-hidden="true"></span>
                                <span class="private-theme-card-body">
                                    <span class="private-theme-card-title">Clasico marmol</span>
                                    <span class="private-theme-card-copy">Fondo marmol blanco con cards claras y estilo operativo tradicional.</span>
                                </span>
                                <span class="private-theme-card-state">
                                    <i class="bi bi-check-circle-fill d-none" data-luxury-theme-check aria-hidden="true"></i>
                                </span>
                            </button>

                            <button type="button"
                                    class="private-theme-card"
                                    data-luxury-appearance-option="futuristic-premium"
                                    aria-pressed="false">
                                <span class="private-theme-card-preview private-theme-card-preview-futuristic" aria-hidden="true"></span>
                                <span class="private-theme-card-body">
                                    <span class="private-theme-card-title">Futurista premium</span>
                                    <span class="private-theme-card-copy">Fondo azul/morado con paneles glass, tablas oscuras y estilo SaaS moderno.</span>
                                </span>
                                <span class="private-theme-card-state">
                                    <i class="bi bi-check-circle-fill d-none" data-luxury-theme-check aria-hidden="true"></i>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/servicios.js"></script>
    <script src="~/js/categorias.js"></script>
    <script src="~/js/mensajes.js" asp-append-version="true"></script>
    <script src="~/js/puestos.js"></script>
    <script src="~/js/finanzas.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.js"></script>
    <script>
        $(function () {
            $("#datepicker").datepicker({
                changeMonth: true,
                changeYear: true,
                yearRange: "1930:2030",
                dateFormat: "yy-mm-dd"
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
