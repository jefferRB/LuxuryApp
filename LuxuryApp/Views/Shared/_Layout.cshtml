@inject LuxuryApp.Services.Layout.IPrivateNavigationService NavigationService

@{
    var navigation = await NavigationService.BuildAsync(User);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LuxuryApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="~/css/calendar.css" />
    <link rel="stylesheet" href="~/css/mensajes.css" />
    <link rel="stylesheet" href="~/css/Dashboard.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/private-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LuxuryApp.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="layout-background private-shell @(ViewData["FullScreen"] as string)">
    <header class="private-header">
        <partial name="_PrivateNavbar" model="navigation" />
    </header>

    <div class="container">
        <main role="main" class="pb-4 private-main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer private-footer text-muted">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <span>&copy; 2026 - LuxuryApp</span>
            <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/servicios.js"></script>
    <script src="~/js/categorias.js"></script>
    <script src="~/js/mensajes.js"></script>
    <script src="~/js/puestos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.js"></script>
    <script>
        $(function () {
            $("#datepicker").datepicker({
                changeMonth: true,
                changeYear: true,
                yearRange: "1930:2030",
                dateFormat: "yy-mm-dd"
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
