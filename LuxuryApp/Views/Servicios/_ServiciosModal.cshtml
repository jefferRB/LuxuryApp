@using LuxuryApp.Models.Finanzas
@model IReadOnlyList<ServicioListItemViewModel>

<form id="serviciosAntiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="mb-3">

    <button class="btn btn-dark" onclick="mostrarFormularioServicio()">
        ➕ Nuevo Servicio
    </button>

</div>

<div class="mt-3"  id="formServicioContainer"></div>

<table class="table table-striped mt-4">

    <thead>
        <tr>
            <th>Servicio</th>
            <th>Precio</th>
            <th>Duración</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>₡@item.Precio.ToString("N2")</td>

                <td>
                    @(item.DuracionMinutos.HasValue
                                    ? item.DuracionMinutos + " min" 
                    : "—")
                </td>

                <td>
                    @if (item.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </td>

                <td>

                    @if (item.Activo)
                    {
                        <button class="btn btn-sm btn-danger me-1"
                                onclick="toggleServicio(@item.Id)">
                            Desactivar
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-success me-1"
                                onclick="toggleServicio(@item.Id)">
                            Activar
                        </button>
                    }

                    <button class="btn btn-sm btn-outline-dark"
                            onclick="eliminarServicio(@item.Id)">
                        ✖
                    </button>

                </td>
            </tr>
        }

    </tbody>

</table>


