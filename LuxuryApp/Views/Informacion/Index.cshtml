@model LuxuryApp.Models.Informacion.InformacionViewModel

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

	.info-card {
		border: none;
		border-radius: 18px;
		padding: 20px;
		background: white;
		box-shadow: 0 8px 18px rgba(0,0,0,0.05);
		transition: .25s;
		text-align: center;
	}

		.info-card:hover {
			transform: translateY(-5px);
			box-shadow: 0 12px 25px rgba(0,0,0,0.08);
		}

	.kpi-title {
		font-size: 14px;
		color: #6c757d;
	}

	.kpi-value {
		font-size: 24px;
		font-weight: 600;
	}

	.wrapper {
		padding: 30px;
	}

	.container-box {
		background: white;
		border-radius: 25px;
		padding: 35px;
		box-shadow: 0 15px 40px rgba(0,0,0,0.12);
	}

	.top-client-card {
		background: #f8f9fa;
		border-radius: 14px;
		padding: 10px 15px;
		margin-bottom: 8px;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.rank {
		font-weight: 700;
		font-size: 18px;
		width: 30px;
	}

	.chart-container {
		background: white;
		border-radius: 20px;
		padding: 25px;
		box-shadow: 0 8px 20px rgba(0,0,0,0.05);
	}

</style>


<div class="wrapper">

	<div class="container-box">

		<h3 class="text-center mb-5">
			📊 Información del Negocio
		</h3>


		<div class="row g-4">

			<div class="col-md-4">
				<div class="info-card">
					<div class="kpi-title">Mes con más citas</div>
					<div class="kpi-value text-success">
						@Model.MesMasCitas (@Model.TotalMesMasCitas)
					</div>
				</div>
			</div>


			<div class="col-md-4">
				<div class="info-card">
					<div class="kpi-title">Mes con menos citas</div>
					<div class="kpi-value text-danger">
						@Model.MesMenosCitas (@Model.TotalMesMenosCitas)
					</div>
				</div>
			</div>


			<div class="col-md-4">
				<div class="info-card">
					<div class="kpi-title">Día más ocupado</div>
					<div class="kpi-value text-primary">
						@Model.DiaMasOcupado (@Model.TotalDiaMasOcupado)
					</div>
				</div>
			</div>


			<div class="col-md-4">
				<div class="info-card">
					<div class="kpi-title">Hora más ocupada</div>
					<div class="kpi-value text-warning">
						@Model.HoraMasOcupada (@Model.TotalHoraMasOcupada)
					</div>
				</div>
			</div>


			<div class="col-md-4">
				<div class="info-card">
					<div class="kpi-title">Servicio más solicitado</div>
					<div class="kpi-value">
						@Model.ServicioMasSolicitado
					</div>
				</div>
			</div>


			<div class="col-md-4">
				<div class="info-card">
					<div class="kpi-title">Funcionario con más citas</div>
					<div class="kpi-value">
						@Model.FuncionarioMasCitas
					</div>
				</div>
			</div>

		</div>


		<hr class="my-5" />


		<div class="row g-4">

			<div class="col-md-6">
				<div class="chart-container">

					<h5 class="mb-3">
						✂️ Citas por Barbero (Mes Actual)
					</h5>

					<canvas id="barberosChart"></canvas>

				</div>
			</div>


			<div class="col-md-6">
				<div class="chart-container">

					<h5 class="mb-3">
						🧴 Servicios más solicitados
					</h5>

					<canvas id="serviciosChart"></canvas>

				</div>
			</div>


		</div>


		<hr class="my-5" />


		<h4 class="mb-4">
			 Top 10 Clientes
		</h4>


		@{
			int pos = 1;
		}


		@foreach (var c in Model.TopClientes)
		{

			<div class="top-client-card">

				<div class="d-flex align-items-center">

					<div class="rank">
						#@pos
					</div>

					<div>
						<div style="font-size:13px;color:#6c757d">
							@c.Nombre
						</div>

						<div style="font-size:13px;color:#6c757d">
							📞 @c.Telefono
						</div>

					</div>

				</div>

				<span class="badge bg-dark">
					@c.TotalVisitas visitas
				</span>

			</div>

			pos++;

		}


	</div>

</div>



<script>

	const barberosLabels = @Html.Raw(Json.Serialize(Model.BarberosNombres));
	const barberosData = @Html.Raw(Json.Serialize(Model.BarberosCitas));

	new Chart(document.getElementById('barberosChart'),{

	type:'bar',

	data:{
	labels:barberosLabels,

	datasets:[{
	label:'Citas',
	data:barberosData,
	borderRadius:6
	}]
	},

	options:{
	plugins:{legend:{display:false}},
	scales:{
	y:{beginAtZero:true}
	}
	}

	});



	const serviciosLabels = @Html.Raw(Json.Serialize(Model.ServiciosNombres));
	const serviciosData = @Html.Raw(Json.Serialize(Model.ServiciosCantidad));

	new Chart(document.getElementById('serviciosChart'),{

	type:'doughnut',

	data:{
	labels:serviciosLabels,

	datasets:[{
	data:serviciosData
	}]
	}

	});

</script>