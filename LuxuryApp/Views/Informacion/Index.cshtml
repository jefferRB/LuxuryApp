@model LuxuryApp.Models.Informacion.InformacionViewModel

@{
    ViewData["Title"] = "Información del Negocio";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<div class="dashboard-wrapper">

    <div class="dashboard-container">

        <!-- SELECTOR MES / AÑO -->

        <div class="d-flex justify-content-center align-items-center mb-4 gap-3">

            <a class="btn btn-dark rounded-circle shadow"
               asp-action="Index"
               asp-route-mes="@(Model.MesSeleccionado == 1 ? 12 : Model.MesSeleccionado - 1)"
               asp-route-anio="@(Model.MesSeleccionado == 1 ? Model.AnioSeleccionado - 1 : Model.AnioSeleccionado)">
                <i class="bi bi-chevron-left"></i>
            </a>

            <form asp-action="Index" method="get" class="d-flex gap-2 align-items-center">

                <select name="mes"
                        class="form-select shadow-sm"
                        style="width:150px;"
                        onchange="this.form.submit()">

                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.MesSeleccionado)">
                            @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
                        </option>
                    }

                </select>

                <select name="anio"
                        class="form-select shadow-sm"
                        style="width:120px;"
                        onchange="this.form.submit()">

                    @for (int a = DateTime.Today.Year - 5; a <= DateTime.Today.Year + 1; a++)
                    {
                        <option value="@a" selected="@(a == Model.AnioSeleccionado)">
                            @a
                        </option>
                    }

                </select>

            </form>

            <a class="btn btn-dark rounded-circle shadow"
               asp-action="Index"
               asp-route-mes="@(Model.MesSeleccionado == 12 ? 1 : Model.MesSeleccionado + 1)"
               asp-route-anio="@(Model.MesSeleccionado == 12 ? Model.AnioSeleccionado + 1 : Model.AnioSeleccionado)">
                <i class="bi bi-chevron-right"></i>
            </a>

        </div>

        <!-- TITULO -->

        <h3 class="dashboard-title text-center">

            📊 Información del Negocio

            <br />

            <small class="text-muted">
                @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.MesSeleccionado)
                @Model.AnioSeleccionado
            </small>

        </h3>


        <!-- KPIs -->

        <div class="row g-4">

            <!-- FILA 1 -->

            <div class="col-xl-3 col-md-4">
                <div class="kpi-card bg-soft-green">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Mes con más citas</div>
                            <div class="kpi-value text-success">
                                @Model.MesMasCitas (@Model.TotalMesMasCitas)
                            </div>
                        </div>
                        <div class="kpi-icon icon-green">
                            <i class="bi bi-graph-up"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-4">
                <div class="kpi-card bg-soft-red">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Mes con menos citas</div>
                            <div class="kpi-value text-danger">
                                @Model.MesMenosCitas (@Model.TotalMesMenosCitas)
                            </div>
                        </div>
                        <div class="kpi-icon icon-red">
                            <i class="bi bi-graph-down"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-4">
                <div class="kpi-card bg-soft-blue">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Día más ocupado</div>
                            <div class="kpi-value text-primary">
                                @Model.DiaMasOcupado (@Model.TotalDiaMasOcupado)
                            </div>
                        </div>
                        <div class="kpi-icon icon-blue">
                            <i class="bi bi-calendar-week"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-4">
                <div class="kpi-card bg-soft-secondary">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Día menos ocupado</div>
                            <div class="kpi-value text-secondary">
                                @Model.DiaMasLibre (@Model.TotalDiaMasLibre)
                            </div>
                        </div>
                        <div class="kpi-icon icon-blue">
                            <i class="bi bi-calendar-x"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-4">
                <div class="kpi-card bg-soft-yellow">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Hora más ocupada</div>
                            <div class="kpi-value text-warning">
                                @Model.HoraMasOcupada
                            </div>
                        </div>
                        <div class="kpi-icon icon-yellow">
                            <i class="bi bi-clock"></i>
                        </div>
                    </div>
                </div>
            </div>


            <!-- FILA 2 -->

            <div class="col-xl-3 col-md-4">
                <div class="kpi-card bg-soft-secondary">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Hora menos ocupada</div>
                            <div class="kpi-value text-secondary">
                                @Model.HoraMasLibre
                            </div>
                        </div>
                        <div class="kpi-icon icon-blue">
                            <i class="bi bi-clock-history"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-4">
                <div class="kpi-card bg-soft-dark">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Servicio más solicitado</div>
                            <div class="kpi-value text-dark">
                                @Model.ServicioMasSolicitado
                            </div>
                        </div>
                        <div class="kpi-icon icon-dark">
                            <i class="bi bi-scissors"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-4">
                <div class="kpi-card bg-soft-success">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Producto más vendido</div>
                            <div class="kpi-value text-success">
                                @Model.ProductoMasVendido
                            </div>
                        </div>
                        <div class="kpi-icon icon-green">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-4">
                <div class="kpi-card bg-soft-danger">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Producto menos vendido</div>
                            <div class="kpi-value text-danger">
                                @Model.ProductoMenosVendido
                            </div>
                        </div>
                        <div class="kpi-icon icon-red">
                            <i class="bi bi-box"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-4">
                <div class="kpi-card bg-soft-dark">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Funcionario con más citas</div>
                            <div class="kpi-value text-dark">
                                @Model.FuncionarioMasCitas
                            </div>
                        </div>
                        <div class="kpi-icon icon-dark">
                            <i class="bi bi-person-badge"></i>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="row mt-5">

            <!-- GRAFICO MES -->

            <div class="col-lg-6 mb-4 mt-5">
                <h5>Citas por Mes</h5>
                <canvas id="chartMes"></canvas>
            </div>

            <!-- GRAFICO SEMANA -->

            <div class="col-lg-6 mb-4">

                <div class="d-flex justify-content-center align-items-center mb-3 gap-3">

                    <button class="btn btn-dark rounded-circle shadow" onclick="cambiarSemana(-7)">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <div class="fw-bold" id="textoSemana">
                        Semana actual
                    </div>

                    <button class="btn btn-dark rounded-circle shadow" onclick="cambiarSemana(7)">
                        <i class="bi bi-chevron-right"></i>
                    </button>

                </div>

                <h5>Citas de la Semana</h5>
                <canvas id="chartSemana"></canvas>

            </div>

            <!-- GRAFICO FUNCIONARIOS -->

            <div class="col-lg-12 mb-4">
                <h5>Citas por Funcionario</h5>
                <canvas id="chartFuncionarios"></canvas>
            </div>

            <div class="col-lg-12 mb-4">
                <h5>Servicios más solicitados</h5>
                <canvas id="chartServicios"></canvas>
            </div>

        </div>


        <!-- TOP CLIENTES -->

        <div class="mt-5">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h4 class="mb-0">
                    🏆 Top Clientes
                </h4>

                <form method="get" class="d-flex align-items-center gap-2">

                    <input type="hidden" name="mes" value="@Model.MesSeleccionado" />
                    <input type="hidden" name="anio" value="@Model.AnioSeleccionado" />

                    <select name="top" class="form-select form-select-sm shadow-sm"
                            style="width:100px;" onchange="this.form.submit()">

                        <option value="5" selected="@(Model.TopCantidad == 5)">Top 5</option>
                        <option value="10" selected="@(Model.TopCantidad == 10)">Top 10</option>
                        <option value="20" selected="@(Model.TopCantidad == 20)">Top 20</option>
                        <option value="50" selected="@(Model.TopCantidad == 50)">Top 50</option>

                    </select>

                </form>

            </div>

            @{
                int pos = 1;
            }

            <div class="top-client-list">

                @foreach (var c in Model.TopClientes)
                {
                    <div class="top-client-item">

                        <div class="left">

                            <div class="rank @(pos <= 3 ? "top" : "")">
                                @pos
                            </div>

                            <div class="info">

                                <div class="name">
                                    @c.Nombre
                                </div>

                                <div class="phone">
                                    📞 @c.Telefono
                                </div>

                            </div>

                        </div>

                        <div class="right">

                            <span class="visits">
                                @c.TotalVisitas
                            </span>

                            <span class="label">
                                visitas
                            </span>

                        </div>

                    </div>

                    pos++;
                }

            </div>

        </div>

</div>

    @section Scripts {

        <script>
                window.dashboardData = {
                    citasMes: @Html.Raw(Json.Serialize(Model.CitasPorMes)),
                    semanaDias: @Html.Raw(Json.Serialize(Model.SemanaDias)),
                    semanaCitas: @Html.Raw(Json.Serialize(Model.SemanaCitas)),
                    funcionariosLabels: @Html.Raw(Json.Serialize(Model.FuncionariosNombres)),
                    funcionariosData: @Html.Raw(Json.Serialize(Model.FuncionariosCitas)),
                    serviciosLabels: @Html.Raw(Json.Serialize(Model.ServiciosNombres)),
                    serviciosData: @Html.Raw(Json.Serialize(Model.ServiciosCantidad))
                };
        </script>

        <script src="~/js/dashboard.js"></script>
    }



