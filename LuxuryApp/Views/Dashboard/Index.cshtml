@model LuxuryApp.Models.Finanzas.DashboardViewModel

@using System.Globalization

@{
    ViewData["Title"] = "Dashboard";
    var metodosPagoValores = new[] { Model.IngresosEfectivo, Model.IngresosSinpe, Model.IngresosTarjeta };
    var esCr = CultureInfo.GetCultureInfo("es-CR");
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<div class="dashboard-wrapper">

    <div class="dashboard-container">
        <div class="d-flex justify-content-center align-items-center mb-4 gap-3">

            <!-- Flecha atrás -->
            <a class="btn btn-dark rounded-circle shadow"
               asp-action="Index"
               asp-route-mes="@(Model.MesSeleccionado == 1 ? 12 : Model.MesSeleccionado - 1)"
               asp-route-anio="@(Model.MesSeleccionado == 1 ? Model.AnioSeleccionado - 1 : Model.AnioSeleccionado)">
                <i class="bi bi-chevron-left"></i>
            </a>

            <!-- Selector Mes / Año -->
            <form asp-action="Index" method="get" class="d-flex gap-2 align-items-center">

                <!-- Mes -->
                <select name="mes"
                        class="form-select shadow-sm"
                        style="width:150px;"
                        onchange="this.form.submit()">

                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.MesSeleccionado)">
                            @esCr.DateTimeFormat.GetMonthName(m)
                        </option>
                    }

                </select>

                <!-- Año -->
                <select name="anio"
                        class="form-select shadow-sm"
                        style="width:120px;"
                        onchange="this.form.submit()">

                    @for (int a = Model.AnioSeleccionado - 5; a <= Model.AnioSeleccionado + 1; a++)
                    {
                        <option value="@a" selected="@(a == Model.AnioSeleccionado)">
                            @a
                        </option>
                    }

                </select>

            </form>

            <!-- Flecha adelante -->
            <a class="btn btn-dark rounded-circle shadow"
               asp-action="Index"
               asp-route-mes="@(Model.MesSeleccionado == 12 ? 1 : Model.MesSeleccionado + 1)"
               asp-route-anio="@(Model.MesSeleccionado == 12 ? Model.AnioSeleccionado + 1 : Model.AnioSeleccionado)">
                <i class="bi bi-chevron-right"></i>
            </a>

        </div>

        <h3 class="dashboard-title text-center">

            📊 Dashboard Financiero
            <br />

            <small class="text-muted">
                @esCr.DateTimeFormat.GetMonthName(Model.MesSeleccionado)
                @Model.AnioSeleccionado
            </small>

        </h3>

        <div class="row g-4">

            <!-- SERVICIOS -->
            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-green">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Servicios Generados</div>
                            <div class="kpi-value text-success">
                                ₡ @Model.TotalServicios.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-green">
                            <i class="bi bi-scissors"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PRODUCTOS -->
            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-green">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Productos Generados</div>
                            <div class="kpi-value text-success">
                                ₡ @Model.TotalProductos.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-green">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TOTAL GENERADO -->
            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-blue">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Total Generado</div>
                            <div class="kpi-value text-primary">
                                ₡ @Model.TotalGenerado.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-blue">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SIN IMPUESTOS -->
            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-dark">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Total sin Impuestos</div>
                            <div class="kpi-value text-dark">
                                ₡ @Model.TotalSinImpuestos.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-dark">
                            <i class="bi bi-receipt"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- IMPUESTOS -->
            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-yellow">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Impuestos</div>
                            <div class="kpi-value text-warning">
                                ₡ @Model.TotalImpuestos.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-yellow">
                            <i class="bi bi-percent"></i>
                        </div>
                    </div>
                </div>
            </div>

           @*  <!-- PAGOS FUNCIONARIOS -->
            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-red">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Pago Funcionarios Caja</div>
                            <div class="kpi-value text-danger">
                                ₡ @Model.TotalPagadoFuncionarios.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-red">
                            <i class="bi bi-person-cash"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- EGRESOS -->
            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-red">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Total Egresos Caja</div>
                            <div class="kpi-value text-danger">
                                ₡ @Model.TotalEgresos.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-red">
                            <i class="bi bi-graph-down-arrow"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- GANANCIA -->
            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-blue">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Resultado Caja</div>
                            <div class="kpi-value text-primary">
                                ₡ @Model.GananciaNegocio.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-blue">
                            <i class="bi bi-bar-chart-line"></i>
                        </div>
                    </div>
                </div>
            </div> *@

            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-yellow">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Pago a Funcionarios</div>
                            <div class="kpi-value text-warning">
                                ₡ @Model.TotalPagadoFuncionariosAnalitico.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-yellow">
                            <i class="bi bi-calendar-week"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-dark">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Total Egresos </div>
                            <div class="kpi-value text-dark">
                                ₡ @Model.TotalEgresosAnaliticos.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-dark">
                            <i class="bi bi-journal-text"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-12">
                <div class="kpi-card bg-soft-green">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Gnancia del Mes</div>
                            <div class="kpi-value text-success">
                                ₡ @Model.ResultadoAnalitico.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-green">
                            <i class="bi bi-bar-chart-steps"></i>
                        </div>
                    </div>
                </div>
            </div>

        </div>


        <!-- Graficos -->

        <div class="row mt-4 g-4">

            <div class="col-lg-6">
                <div class="kpi-card private-chart-card">
                    <h6 class="mb-3">Ingresos por Método de Pago</h6>
                    <div class="private-chart-body">
                        <canvas id="metodosPagoChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="kpi-card private-chart-card">
                    <h6 class="mb-3">Resultado Caja vs Analítico por Mes</h6>
                    <div class="private-chart-body">
                        <canvas id="gananciaMesChart"></canvas>
                    </div>
                </div>
            </div>

        </div>

        


    </div>

</div>

@section Scripts {

    <script>

        const ctx = document.getElementById('metodosPagoChart');
        const chartTokens = window.luxuryGetPrivateThemeTokens
            ? window.luxuryGetPrivateThemeTokens()
            : { chartText: '#334155', chartMuted: '#64748b', chartGrid: 'rgba(148, 163, 184, 0.24)' };
        const chartPalette = chartTokens.chartPalette || ['#2563eb', '#16a34a', '#d97706', '#dc2626', '#0891b2'];

        if (window.Chart && ctx) {
        window.luxuryDestroyChartForCanvas?.(ctx);
        const metodosPagoChart = new Chart(ctx, {
        type: 'doughnut',
        data: {
        labels: ['Efectivo','SINPE','Tarjeta'],
        datasets: [{
        data: @Html.Raw(Json.Serialize(metodosPagoValores)),
        backgroundColor: chartPalette,
        borderColor: chartPalette,
        borderWidth: 1,
        luxuryUsePalette: true
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        color: chartTokens.chartText,
        plugins: {
        legend: {
        labels: {
        color: chartTokens.chartText
        }
        }
        }
        }
        });
        window.luxuryRegisterChart?.(metodosPagoChart);
        }

        const ctx2 = document.getElementById('gananciaMesChart');

        if (window.Chart && ctx2) {
        window.luxuryDestroyChartForCanvas?.(ctx2);
        const gananciaMesChart = new Chart(ctx2, {
        type: 'bar',
        data: {
        labels: [
        'Ene','Feb','Mar','Abr','May','Jun',
        'Jul','Ago','Sep','Oct','Nov','Dic'
        ],
        datasets: [{
        label: 'Ganancias',
        data: @Html.Raw(Json.Serialize(Model.ResultadoAnaliticoPorMes)),
        backgroundColor: chartPalette[0],
        borderColor: chartPalette[0],
        borderWidth: 1,
        luxuryAutoBackground: true,
        luxuryAutoBorder: true
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        color: chartTokens.chartText,
        scales: {
        x: {
        ticks: { color: chartTokens.chartMuted },
        grid: { color: chartTokens.chartGrid }
        },
        y: {
        ticks: { color: chartTokens.chartMuted },
        grid: { color: chartTokens.chartGrid }
        }
        },
        plugins: {
        legend: {
        labels: {
        color: chartTokens.chartText
        }
        }
        }
        }
        });
        window.luxuryRegisterChart?.(gananciaMesChart);
        }

    </script>

}

