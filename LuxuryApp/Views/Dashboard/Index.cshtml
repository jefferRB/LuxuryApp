@model LuxuryApp.Models.Finanzas.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>



<div class="dashboard-wrapper">

    <div class="dashboard-container">
        <div class="d-flex justify-content-center align-items-center mb-4 gap-3">

            <!-- Flecha atrás -->
            <a class="btn btn-dark rounded-circle shadow"
               asp-action="Index"
               asp-route-mes="@(Model.MesSeleccionado == 1 ? 12 : Model.MesSeleccionado - 1)"
               asp-route-anio="@(Model.MesSeleccionado == 1 ? Model.AnioSeleccionado - 1 : Model.AnioSeleccionado)">
                <i class="bi bi-chevron-left"></i>
            </a>

            <!-- Selector Mes / Año -->
            <form asp-action="Index" method="get" class="d-flex gap-2 align-items-center">

                <!-- Mes -->
                <select name="mes"
                        class="form-select shadow-sm"
                        style="width:150px;"
                        onchange="this.form.submit()">

                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.MesSeleccionado)">
                            @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
                        </option>
                    }

                </select>

                <!-- Año -->
                <select name="anio"
                        class="form-select shadow-sm"
                        style="width:120px;"
                        onchange="this.form.submit()">

                    @for (int a = DateTime.Today.Year - 5; a <= DateTime.Today.Year + 1; a++)
                    {
                        <option value="@a" selected="@(a == Model.AnioSeleccionado)">
                            @a
                        </option>
                    }

                </select>

            </form>

            <!-- Flecha adelante -->
            <a class="btn btn-dark rounded-circle shadow"
               asp-action="Index"
               asp-route-mes="@(Model.MesSeleccionado == 12 ? 1 : Model.MesSeleccionado + 1)"
               asp-route-anio="@(Model.MesSeleccionado == 12 ? Model.AnioSeleccionado + 1 : Model.AnioSeleccionado)">
                <i class="bi bi-chevron-right"></i>
            </a>

        </div>

        <h3 class="dashboard-title text-center">

            📊 Dashboard Financiero
            <br />

            <small class="text-muted">
                @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.MesSeleccionado)
                @Model.AnioSeleccionado
            </small>

        </h3>

        <div class="row g-4">

            <!-- SERVICIOS -->
            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-green">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Servicios Generados</div>
                            <div class="kpi-value text-success">
                                ₡ @Model.TotalServicios.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-green">
                            <i class="bi bi-scissors"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PRODUCTOS -->
            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-green">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Productos Generados</div>
                            <div class="kpi-value text-success">
                                ₡ @Model.TotalProductos.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-green">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TOTAL GENERADO -->
            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-blue">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Total Generado</div>
                            <div class="kpi-value text-primary">
                                ₡ @Model.TotalGenerado.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-blue">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SIN IMPUESTOS -->
            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-dark">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Total sin Impuestos</div>
                            <div class="kpi-value text-dark">
                                ₡ @Model.TotalSinImpuestos.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-dark">
                            <i class="bi bi-receipt"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- IMPUESTOS -->
            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-yellow">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Impuestos</div>
                            <div class="kpi-value text-warning">
                                ₡ @Model.TotalImpuestos.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-yellow">
                            <i class="bi bi-percent"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PAGOS FUNCIONARIOS -->
            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-red">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Pagado Funcionarios</div>
                            <div class="kpi-value text-danger">
                                ₡ @Model.TotalPagadoFuncionarios.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-red">
                            <i class="bi bi-person-cash"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- EGRESOS -->
            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-red">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Total Egresos</div>
                            <div class="kpi-value text-danger">
                                ₡ @Model.TotalEgresos.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-red">
                            <i class="bi bi-graph-down-arrow"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- GANANCIA -->
            <div class="col-xl-3 col-md-6">
                <div class="kpi-card bg-soft-blue">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-label">Ganancia del Negocio</div>
                            <div class="kpi-value text-primary">
                                ₡ @Model.GananciaNegocio.ToString("N2")
                            </div>
                        </div>
                        <div class="kpi-icon icon-blue">
                            <i class="bi bi-bar-chart-line"></i>
                        </div>
                    </div>
                </div>
            </div>

        </div>


        <!-- Graficos -->

        <div class="row mt-4 g-4">

            <div class="col-lg-6">
                <div class="kpi-card">
                    <h6 class="mb-3">Ingresos por Método de Pago</h6>
                    <canvas id="metodosPagoChart"></canvas>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="kpi-card">
                    <h6 class="mb-3">Ganancia del Negocio por Mes</h6>
                    <canvas id="gananciaMesChart"></canvas>
                </div>
            </div>

        </div>

        


    </div>

</div>

@section Scripts {

    <script>

        const ctx = document.getElementById('metodosPagoChart');

        new Chart(ctx, {
        type: 'doughnut',
        data: {
        labels: ['Efectivo','SINPE','Tarjeta'],
        datasets: [{
        data: [
        @Model.IngresosEfectivo,
        @Model.IngresosSinpe,
        @Model.IngresosTarjeta
        ],
        backgroundColor: [
        '#28a745',
        '#0d6efd',
        '#ffc107'
        ]
        }]
        }
        });

        const ctx2 = document.getElementById('gananciaMesChart');

        new Chart(ctx2, {
        type: 'bar',
        data: {
        labels: [
        'Ene','Feb','Mar','Abr','May','Jun',
        'Jul','Ago','Sep','Oct','Nov','Dic'
        ],
        datasets: [{
        label: 'Ganancia',
        data: @Html.Raw(Json.Serialize(Model.GananciaPorMes)),
        backgroundColor:'#0d6efd'
        }]
        }
        });

    </script>

}

