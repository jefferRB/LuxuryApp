@model LuxuryApp.Models.Finanzas.EgresoViewModel

<div class="card border-0 shadow-lg">
    <div class="card-header bg-dark text-white py-3">
        <h5 class="m-0">
            <i class="fas fa-file-invoice-dollar me-2"></i>Editar Egreso
        </h5>
    </div>

    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Egreso.IdEgreso" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Egreso.IdEgreso" type="hidden" />

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Egreso.FechaEgreso" class="form-label"></label>
                <input asp-for="Egreso.FechaEgreso" class="form-control" type="datetime-local" step="60" />
            </div>

            <div class="mb-3">
                <label asp-for="Egreso.CategoriaId" class="form-label"></label>
                <select asp-for="Egreso.CategoriaId" class="form-select" asp-items="Model.Categorias">
                    <option value="">Seleccione categoria</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Egreso.Detalle" class="form-label"></label>
                <input asp-for="Egreso.Detalle" class="form-control" placeholder="Descripcion del egreso" />
                <span asp-validation-for="Egreso.Detalle" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Egreso.Monto" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>
                    <input asp-for="Egreso.Monto" class="form-control money-input" type="text" autocomplete="off" />
                </div>
                <span asp-validation-for="Egreso.Monto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Egreso.MetodoPago" class="form-label"></label>
                <select asp-for="Egreso.MetodoPago" class="form-select" asp-items="Model.MetodosPago">
                    <option value="">Seleccione metodo de pago</option>
                </select>
            </div>

            <button type="submit" class="btn btn-dark">
                <i class="fas fa-save me-1"></i>Guardar Cambios
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i>Volver
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
