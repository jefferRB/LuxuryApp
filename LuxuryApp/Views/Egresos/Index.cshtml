@using LuxuryApp.Models.Finanzas
@model EgresoIndexViewModel

<div class="card border-0 shadow-lg">
    <div class="card-header bg-dark text-white py-3">
        <h5 class="m-0">
            <i class="fas fa-money-bill-wave me-2"></i>Finanzas - Egresos
        </h5>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3 mx-3 mb-3">

        <a asp-action="Create" class="btn btn-dark text-white">
            <i class="fas fa-plus me-1"></i>Nuevo Egreso
        </a>

        <div class="d-flex gap-2 align-items-center">
        <button class="btn btn-outline-primary"
                data-bs-toggle="modal"
                data-bs-target="#modalCategorias"
                onclick="cargarCategorias()">
            ⚙ Gestionar Categorías
        </button>

        <button type="submit"
                form="formFiltros"
                formaction="@Url.Action("ExportarExcel")"
                class="btn btn-success shadow-sm px-4">
            <i class="fas fa-file-excel me-1"></i> Excel
        </button>
        </div>

    </div>




    <!-- FILTROS -->
    <form method="get" id="formFiltros" class="row g-2 px-3 mb-3">

        <!-- Vista tiempo -->
        <div class="col-md-3">
            <select asp-for="Filtros.VistaTiempo" class="form-select" id="vistaTiempoSelect">
                <option value="dia">Hoy</option>
                <option value="semana">Semana</option>
                <option value="mes">Mes</option>
                <option value="anio">Año</option>
                <option value="fechas">Rango de Fechas</option>
                <option value="todo">Todo</option>
            </select>

            <div class="d-flex gap-2 mt-2 d-none" id="rangoFechasContainer">
                <input asp-for="Filtros.FechaInicio" type="date" class="form-control" />
                <input asp-for="Filtros.FechaFin" type="date" class="form-control" />
            </div>
        </div>

        <!-- Categoria -->
        <div class="col-md-3">
            <select asp-for="Filtros.CategoriaId"
                    asp-items="Model.Categorias"
                    class="form-select">
                <option value="">Todas las categorías</option>
            </select>
        </div>

        <!-- Metodo Pago -->
        <div class="col-md-3">
            <select asp-for="Filtros.MetodoPago"
                    asp-items="Model.MetodosPago"
                    class="form-select">
                <option value="">Todos métodos</option>
            </select>
        </div>

        

    
    </form>

    <!-- KPIs -->
    <div class="row mx-3 mb-3">

        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">
                        Total Egresos
                    </h6>
                    <h3 class="fw-bold text-danger">
                        ₡ @Model.TotalEgresos.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">
                        Cantidad Registros
                    </h6>
                    <h3 class="fw-bold text-primary">
                        @Model.CantidadRegistros
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- TABLA -->
    <div class="card-body p-0">
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Fecha</th>
                        <th>Categoría</th>
                        <th>Detalle</th>
                        <th>Monto</th>
                        <th>Método Pago</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Egresos.Any())
                    {
                        foreach (var egreso in Model.Egresos)
                        {
                            <tr>
                                <td class="ps-4">
                                    @egreso.FechaEgreso.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @egreso.Categoria?.Nombre
                                </td>

                                <td>
                                    @egreso.Detalle
                                </td>

                                <td>
                                    ₡ @egreso.Monto.ToString("N2")
                                </td>

                                <td>
                                    @egreso.MetodoPago
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No hay egresos registrados
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>
</div>

<!-- MODAL CATEGORIAS -->
<div class="modal fade" id="modalCategorias" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Gestión de Categorías</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="contenedorCategorias">
                Cargando categorías...
            </div>

        </div>
    </div>
</div>

@section Scripts {

    <script>

        function toggleRangoFechas() {

            const select = document.getElementById("vistaTiempoSelect");
            const container = document.getElementById("rangoFechasContainer");

            if (select.value === "fechas") {
                container.classList.remove("d-none");
            } else {
                container.classList.add("d-none");
            }
        }

        function enviarFiltros() {
            document.getElementById("formFiltros").submit();
        }

        document.addEventListener("DOMContentLoaded", function () {

            const vistaTiempo = document.getElementById("vistaTiempoSelect");
            const categoria = document.querySelector("[name='Filtros.CategoriaId']");
            const metodo = document.querySelector("[name='Filtros.MetodoPago']");
            const fechaInicio = document.querySelector("[name='Filtros.FechaInicio']");
            const fechaFin = document.querySelector("[name='Filtros.FechaFin']");

            toggleRangoFechas();

            vistaTiempo.addEventListener("change", function () {
                toggleRangoFechas();
                enviarFiltros();
            });

            categoria.addEventListener("change", enviarFiltros);
            metodo.addEventListener("change", enviarFiltros);

            fechaInicio.addEventListener("change", enviarFiltros);
            fechaFin.addEventListener("change", enviarFiltros);

        });

    </script>

}
