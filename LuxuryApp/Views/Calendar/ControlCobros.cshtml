@model LuxuryApp.Models.Calendar.ControlCitasCobrosViewModel
@{
    ViewData["Title"] = "Control de citas y cobros";
    var f = Model.Filtro;
    string Active(string r) => f.Rango == r ? "active" : "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/control-cobros.css" asp-append-version="true" />
}

<div id="cc-antiforgery" class="d-none">@Html.AntiForgeryToken()</div>

<div class="cc-shell">
    <div class="cc-hero">
        <div class="cc-hero-copy">
            <span class="cc-badge"><i class="bi bi-cash-stack"></i> Estados y cobros</span>
            <h1 class="cc-title">Control de citas y cobros</h1>
            <p class="cc-subtitle">Revisa las citas realizadas, pendientes de cobro y montos cobrados por d&iacute;a, semana o mes.</p>
        </div>
        <a class="cc-back" href="/Calendar"><i class="bi bi-arrow-left"></i> Volver al calendario</a>
    </div>

    <div class="cc-filters">
        <div class="cc-filters-row">
            <div class="cc-field">
                <span class="cc-field-label">Periodo</span>
                <div class="cc-seg" id="cc-rango" role="group" aria-label="Periodo">
                    <button type="button" class="cc-seg-btn @Active("dia")" data-rango="dia"><i class="bi bi-calendar-day"></i> D&iacute;a</button>
                    <button type="button" class="cc-seg-btn @Active("semana")" data-rango="semana"><i class="bi bi-calendar-week"></i> Semana</button>
                    <button type="button" class="cc-seg-btn @Active("mes")" data-rango="mes"><i class="bi bi-calendar3"></i> Mes</button>
                </div>
            </div>

            <div class="cc-field">
                <label class="cc-field-label" for="cc-fecha">Fecha</label>
                <input type="date" id="cc-fecha" class="cc-input" value="@f.Fecha.ToString("yyyy-MM-dd")">
            </div>

            <div class="cc-field">
                <label class="cc-field-label" for="cc-funcionario">Funcionario</label>
                <select id="cc-funcionario" class="cc-select">
                    <option value="">Todos</option>
                    @foreach (var fn in Model.Funcionarios)
                    {
                        if (f.FuncionarioId == fn.Id)
                        {
                            <option value="@fn.Id" selected>@fn.Nombre</option>
                        }
                        else
                        {
                            <option value="@fn.Id">@fn.Nombre</option>
                        }
                    }
                </select>
            </div>

            <div class="cc-field">
                <label class="cc-field-label" for="cc-estado">Estado de pago</label>
                <select id="cc-estado" class="cc-select">
                    <option value="todos" selected="@(f.EstadoPago == "todos")">Todos</option>
                    <option value="cobradas" selected="@(f.EstadoPago == "cobradas")">Cobradas</option>
                    <option value="pendientes" selected="@(f.EstadoPago == "pendientes")">Pendientes</option>
                    @if (Model.HasWhatsAppAddon)
                    {
                        <option value="canceladas" selected="@(f.EstadoPago == "canceladas")">Canceladas</option>
                    }
                </select>
            </div>

            <div class="cc-field cc-field-search">
                <label class="cc-field-label" for="cc-buscar">Buscar cliente o tel&eacute;fono</label>
                <input type="search" id="cc-buscar" class="cc-input" placeholder="Nombre o tel&eacute;fono..." value="@f.Buscar" autocomplete="off">
            </div>
        </div>
    </div>

    <div id="cc-results">
        @await Html.PartialAsync("_ControlCobrosResultados", Model)
    </div>
</div>

<div class="modal fade" id="ccCobroModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content cc-modal-content">
            <div class="cc-modal-header">
                <div class="cc-modal-icon"><i class="bi bi-cash-coin"></i></div>
                <div>
                    <h5 class="cc-modal-title">Registrar cobro</h5>
                    <p class="cc-modal-subtitle">Confirma el cobro de esta cita</p>
                </div>
                <button type="button" class="btn-close cc-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body cc-modal-body">
                <input type="hidden" id="ccCobroCitaId" />

                <div class="cc-modal-summary">
                    <div class="cc-modal-summary-main">
                        <div id="ccCobroCliente" class="cc-modal-client">Cliente</div>
                        <div id="ccCobroServicio" class="cc-modal-service">Servicio</div>
                    </div>
                    <div class="cc-modal-amount">
                        <span class="cc-modal-amount-label">Monto cita</span>
                        <span id="ccCobroEsperado" class="cc-modal-amount-value">-</span>
                    </div>
                </div>

                <label class="cc-field-label" for="ccCobroMonto">Monto cobrado</label>
                <div class="cc-money-input">
                    <span class="cc-money-prefix">CRC</span>
                    <input type="number" id="ccCobroMonto" step="0.01" min="0.01" required placeholder="0.00" class="cc-money-field" />
                </div>

                <label class="cc-field-label" for="ccCobroMetodo">M&eacute;todo de pago</label>
                <select id="ccCobroMetodo" class="cc-select cc-field-full">
                    <option value="EFECTIVO">Efectivo</option>
                    <option value="TARJETA">Tarjeta</option>
                    <option value="SINPE">SINPE</option>
                </select>

                <label class="cc-field-label" for="ccCobroObs">Observaci&oacute;n (opcional)</label>
                <input type="text" id="ccCobroObs" maxlength="500" class="cc-input cc-field-full"
                       placeholder="Ej: propina incluida, pago parcial..." />

                <div class="cc-comprobante-box">
                    <label class="cc-check-label">
                        <input type="checkbox" id="ccCobroEnviar" class="cc-check" />
                        <i class="bi bi-envelope-paper"></i> Enviar comprobante por correo
                    </label>
                    <div id="ccCobroEmailWrap" class="cc-email-wrap d-none">
                        <input type="email" id="ccCobroEmail" class="cc-input cc-field-full"
                               placeholder="correo@ejemplo.com" autocomplete="off" />
                        <label id="ccCobroGuardarWrap" class="cc-save-email-wrap d-none">
                            <input type="checkbox" id="ccCobroGuardarEmail" class="cc-check" />
                            Guardar este correo en el perfil del cliente
                        </label>
                    </div>
                </div>

                <div id="ccCobroError" class="cc-error d-none"></div>
            </div>
            <div class="cc-modal-footer">
                <button type="button" class="cc-act cc-modal-cancel" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="ccCobroSubmit" class="cc-act cc-act-cobrar cc-modal-submit">
                    <i class="bi bi-check2-circle"></i> Registrar cobro
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/control-cobros.js" asp-append-version="true"></script>
}
