@{
    ViewData["Title"] = "Agenda";
}

<div class="container-fluid mt-3">
    <div class="row">

        <!-- Calendario (75%) -->
        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="btn-group" role="group">
                    <button id="viewMonthBtn" class="btn btn-dark btn-sm active">
                        📅 Mensual
                    </button>
                    <button id="viewDayBtn" class="btn btn-outline-dark btn-sm">
                        📆 Diario
                    </button>
                </div>

                <input type="date" id="dayPicker" class="form-control form-control-sm w-auto d-none">
            </div>
            <div id="calendar" class="calendar-container">
                <!-- El calendario se renderiza con JS -->
            </div>
        </div>



        <!-- Lista de tareas (25%) -->
        <div class="col-md-3">

            

            <button class="btn btn-dark mb-3" onclick="openManualCitaModal()">
                ➕ Agregar cita manual
            </button>

            
            <div class="mb-2">
                <select id="funcionarioFiltro" class="form-select">
                    <option value="">Todos los funcionarios</option>
                </select>
            </div>
            <div class="d-flex justify-content-between text-white align-items-center mb-2">
                
                <button id="toggleTareasBtn"
                        class="btn btn-dark btn-sm "
                        onclick="toggleTareas()">
                    Ocultar
                </button>
            </div>

            

            <!-- 👇 ESTE es el que se oculta -->
            <div id="tareasContainer">
                <ul id="listaTareas" class="list-group">
                    <!-- Se llena por JS -->
                </ul>
            </div>

        <!-- Modal -->
        <!-- MODAL HORAS -->
        <div class="modal fade" id="dayModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="modalTitle"></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <div id="hoursContainer" class="list-group">
                            <!-- Horas -->
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- MODAL CREAR CITA -->
        <div class="modal fade" id="createCitaModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Nueva cita</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">

                            <div class="mb-3">
                                <label class="form-label">Fecha y hora</label>
                                <input type="datetime-local"
                                       id="appointmentDate"
                                       class="form-control">
                            </div>

                            <input type="hidden" id="duracionMinutos" value="30" />

                        <div class="mb-2">
                            <label class="form-label">Nombre del cliente</label>
                            <input id="nombreCliente" class="form-control">
                        </div>

                        <div class="mb-2">
                            <label class="form-label">Teléfono</label>
                            <input id="telefonoCliente" class="form-control">
                        </div>

                            <div class="mb-3">
                                <label class="form-label">Servicio</label>
                                <select id="servicio" class="form-select"></select>
                            </div>

                        <div class="mb-3">
                            <label class="form-label">Funcionario</label>
                            <select id="funcionarioId" class="form-select">
                                <option value="">Seleccione un funcionario</option>
                            </select>
                        </div>

                        <button class="btn btn-dark w-100" onclick="guardarCita()">
                            Guardar cita
                        </button>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>


<!-- MODAL De Editar citas-->
<div class="modal fade" id="editCitaModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">✏️ Editar cita</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="editCitaId" />

                <div class="mb-2">
                    <label>Cliente</label>
                    <input class="form-control" id="editNombreCliente">
                </div>

                <div class="mb-2">
                    <label>Teléfono</label>
                    <input class="form-control" id="editTelefonoCliente">
                </div>

                <div class="mb-2">
                    <label>Servicio</label>
                    <input class="form-control" id="editServicio">
                </div>

                <div class="mb-2">
                    <label>Fecha y hora</label>
                    <input type="datetime-local" class="form-control" id="editFechaHora">
                </div>

                <div class="mb-2">
                        <label>Funcionario</label>
                        <select id="editFuncionarioId" class="form-select"></select>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" onclick="guardarEdicion()">Guardar cambios</button>
            </div>

        </div>
    </div>
</div>


<!-- MODAL CITA MANUAL -->
<div class="modal fade" id="manualCitaModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">➕ Nueva cita manual</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div class="mb-2">
                    <label class="form-label">Fecha</label>
                    <input type="date" id="manualFecha" class="form-control">
                </div>

                <div class="mb-2">
                    <label class="form-label">Hora</label>
                    <input type="time" id="manualHora" class="form-control">
                </div>

                <div class="mb-2">
                    <label class="form-label">Nombre del cliente</label>
                    <input id="manualNombre" class="form-control">
                </div>

                <div class="mb-2">
                    <label class="form-label">Teléfono</label>
                    <input id="manualTelefono" class="form-control">
                </div>

                <div class="mb-2">
                    <label class="form-label">Servicio</label>
                    <input id="manualServicio" class="form-control">
                </div>

                <div class="mb-3">
                        <label class="form-label">Funcionario</label>
                        <select id="manualFuncionarioId" class="form-select"></select>
                </div>

                <button class="btn btn-dark w-100" onclick="guardarCitaManual()">
                    Guardar cita
                </button>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/calendar.js"></script>
}