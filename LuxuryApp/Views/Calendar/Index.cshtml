@{
    ViewData["Title"] = "Agenda";
}

<div id="calendar-antiforgery" class="d-none">
    @Html.AntiForgeryToken()
</div>

<div class="container-fluid mt-3">
    <div class="row">

        <!-- Calendario (75%) -->
        <div class="col-md-9">

            <!-- FILA 1: controles principales -->
            <div class="d-flex justify-content-between align-items-center mb-2">

                <div class="btn-group" role="group">
                    <button id="viewMonthBtn" class="btn btn-dark btn-sm active">
                        📅 Mensual
                    </button>

                    <button id="viewDayBtn" class="btn btn-outline-dark btn-sm">
                        📆 Diario
                    </button>
                </div>

                <input type="date"
                       id="dayPicker"
                       class="form-control form-control-sm w-auto d-none">

            </div>


            <!-- FILA 2: configuración horario -->
            <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">

                <label class="small mb-0">Inicio</label>
                <input type="number"
                       id="horaInicio"
                       class="form-control form-control-sm"
                       style="width:65px"
                       min="0"
                       max="23">

                <label class="small mb-0">Fin</label>
                <input type="number"
                       id="horaFin"
                       class="form-control form-control-sm"
                       style="width:65px"
                       min="0"
                       max="23">

                <label class="small mb-0">Intervalo</label>
                <select id="intervaloCitas"
                        class="form-select form-select-sm"
                        style="width:85px">

                    <option value="5">5 min</option>
                    <option value="10">10 min</option>
                    <option value="15">15 min</option>
                    <option value="30">30 min</option>

                </select>

                <button id="aplicarHorario"
                        class="btn btn-dark btn-sm">
                    Aplicar
                </button>

            </div>


            <div id="calendar" class="calendar-container">
                <!-- El calendario se renderiza con JS -->
            </div>

        </div>



        <!-- Lista de tareas (25%) -->
        <div class="col-md-3">
            <div class="mb-2">
                <select id="funcionarioFiltro" class="form-select">
                    <option value="">Todos los funcionarios</option>
                </select>
            </div>
            <div class="d-flex justify-content-between text-white align-items-center mb-2">
                
                <button id="toggleTareasBtn"
                        class="btn btn-dark btn-sm "
                        onclick="toggleTareas()">
                    Ocultar
                </button>
            </div>

            <div id="tareasContainer">
                <ul id="listaTareas" class="list-group">
                    <!-- Se llena por JS -->
                </ul>
            </div>

        <!-------------------- Modals ------------------->

        <!-- MODAL HORAS -->
        <div class="modal fade" id="dayModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="modalTitle"></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <div id="hoursContainer" class="list-group">
                            
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- MODAL CREAR CITA -->
        <div class="modal fade" id="createCitaModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Nueva cita</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="esDescanso">
                                <label class="form-check-label fw-bold">
                                    Registrar descanso
                                </label>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Fecha y hora</label>
                                <input type="datetime-local"
                                       id="appointmentDate"
                                       class="form-control">
                            </div>

                            <div id="duracionDescansoContainer" class="mb-3 d-none">
                                <label class="form-label">Duración del descanso (minutos)</label>
                                <input type="number"
                                       id="duracionDescanso"
                                       class="form-control"
                                       value="30"
                                       min="5"
                                       max="180">
                            </div>

                            <input type="hidden" id="duracionMinutos" value="30" />

                            <div id="camposCita">

                            <div class="mb-2 position-relative">
                                <label class="form-label">Nombre del cliente</label>
                                <input id="nombreCliente" class="form-control" autocomplete="off">

                                <!-- las sugerencias -->
                                <div id="sugerenciasClientes"
                                     class="list-group position-absolute w-100"
                                     style="z-index: 1055;"></div>
                            </div>

                        <div class="mb-2">
                            <label class="form-label">Teléfono</label>
                            <input id="telefonoCliente" class="form-control">
                        </div>

                            <div class="mb-3">
                                <label class="form-label">Servicio</label>
                                <select id="servicio" class="form-select"></select>
                            </div>

                        <div class="mb-3">
                            <label class="form-label">Funcionario</label>
                            <select id="funcionarioId" class="form-select">
                                <option value="">Seleccione un funcionario</option>
                            </select>
                        </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="duplicarCita">
                                <label class="form-check-label">
                                    Repetir cita en otras fechas
                                </label>
                            </div>

                            <div id="duplicarConfig" class="d-none">

                                <label class="form-label">Seleccione los días</label>

                                <input type="text"
                                       id="fechasDuplicadas"
                                       class="form-control"
                                       placeholder="Seleccione fechas">

                            </div>
                        </div>

                        <button class="btn btn-dark w-100" onclick="guardarCita()">
                            Guardar cita
                        </button>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>


    <!-- MODAL EDITAR -->
    <div class="modal fade" id="editCitaModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="editModalTitle">✏️ Editar</h5>
                    <button class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" id="editCitaId" />
                    <input type="hidden" id="editTipo" />

                    <div class="mb-3">
                        <label>Fecha y hora</label>
                        <input type="datetime-local"
                               class="form-control"
                               id="editFechaHora">
                    </div>


                    <!-- CAMPOS DE CITA -->
                    <div id="editCamposCita">

                        <div class="mb-2">
                            <label>Nombre del cliente</label>
                            <input class="form-control" id="editNombreCliente">
                        </div>

                        <div class="mb-2">
                            <label>Teléfono</label>
                            <input class="form-control" id="editTelefonoCliente">
                        </div>

                        <div class="mb-3">
                            <label>Servicio</label>
                            <select id="editServicioId" class="form-select"></select>
                        </div>

                    </div>


                    <!-- CAMPOS DE DESCANSO -->
                    <div id="editCamposDescanso" class="d-none">

                        <div class="mb-3">
                            <label>Duración del descanso (minutos)</label>
                            <input type="number"
                                   class="form-control"
                                   id="editDuracionDescanso"
                                   min="5"
                                   max="180">
                        </div>

                    </div>


                    <div class="mb-2">
                        <label>Funcionario</label>
                        <select id="editFuncionarioId" class="form-select"></select>
                    </div>

                </div>

                <div class="modal-footer justify-content-between">

                    <button class="btn btn-danger"
                            onclick="cancelarCita()">
                        Eliminar
                    </button>

                    <div>
                        <button class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Volver
                        </button>

                        <button class="btn btn-primary"
                                onclick="guardarEdicion()">
                            Guardar cambios
                        </button>
                    </div>

                </div>

            </div>
        </div>
    </div>




@section Scripts {
    <script src="~/js/calendar.js"></script>
}
