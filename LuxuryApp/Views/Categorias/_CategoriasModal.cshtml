@using LuxuryApp.Models.Finanzas
@model List<Categoria>

<div class="mb-3">

    <button class="btn btn-dark" onclick="mostrarFormularioCategoria()">
		➕ Nueva Categoria
    </button>

</div>

<div class="mt-3" id="formCategoriaContainer"></div>

<table class="table table-striped mt-4">

    <thead>
        <tr>
            <th>Nombre</th>
            <th>Detalle</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Detalle</td>

                <td>
                    @if (item.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </td>

                <td>



                    @if (item.Activo)
                    {
                        <button class="btn btn-sm btn-danger"
                                onclick="toggleCategoria(@item.Id)">
                            Desactivar
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-success"
                                onclick="toggleCategoria(@item.Id)">
                            Activar
                        </button>
                    }

                </td>
            </tr>
        }

    </tbody>

</table>


