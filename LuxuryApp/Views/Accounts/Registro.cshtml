@model LuxuryApp.Models.Identity.RegistroViewModel

@{
    ViewData["Title"] = "Registro";
    ViewData["PublicBodyClass"] = "public-auth-page";
    Layout = "_PublicLayout";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var selectedPlanName = ViewData["SelectedPlanName"] as string;
}

<section class="auth-section">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-5" data-aos="fade-right">
                <div class="auth-story-card">
                    <span class="section-kicker">Onboarding comercial</span>
                    <h1>Crea tu cuenta y deja listo el espacio de trabajo de tu negocio.</h1>
                    <p>
                        El registro sigue creando tu tenant y luego el sistema continua con el flujo actual de suscripcion
                        sin alterar la relacion entre usuario, TenantId y acceso comercial.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(selectedPlanName))
                    {
                        <div class="auth-plan-pill">
                            <i class="bi bi-stars"></i>
                            <span>Plan elegido: <strong>@selectedPlanName</strong></span>
                        </div>
                    }

                    <ul class="auth-benefit-list">
                        <li>Landing, precios y onboarding alineados con el branding del SaaS</li>
                        <li>Separacion clara entre experiencia comercial y experiencia interna</li>
                        <li>Continuidad del flujo actual de registro, tenant y suscripcion</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-7 col-xl-6" data-aos="fade-left">
                <div class="auth-form-card">
                    <span class="section-kicker">Crear cuenta</span>
                    <h2>Empieza con una base profesional desde el primer acceso.</h2>

                    <form id="registration-form" asp-controller="Accounts" asp-action="Registro" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnurl" value="@returnUrl" />
                        <input asp-for="SelectedPlanId" type="hidden" />
                        <input asp-for="CurrentContractDocumentId" type="hidden" />

                        <div class="text-danger auth-validation" asp-validation-summary="All"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control public-form-control" placeholder="Nombre completo" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control public-form-control" placeholder="correo@negocio.com" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control public-form-control" placeholder="Telefono" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" type="password" class="form-control public-form-control" placeholder="Contrasena" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control public-form-control" placeholder="Confirmar contrasena" />
                            </div>
                            <div class="col-12">
                                <label asp-for="AccessCode" class="form-label"></label>
                                <input asp-for="AccessCode" class="form-control public-form-control" placeholder="Opcional si recibiste un codigo promocional" />
                            </div>
                        </div>

                        @if (Model.HasCurrentContract)
                        {
                            <div class="contract-consent-card mt-4">
                                <div class="contract-consent-copy">
                                    <span class="section-kicker">Contrato vigente</span>
                                    <h3>@Model.CurrentContractTitle</h3>
                                    <p>
                                        Version @Model.CurrentContractVersion
                                        @if (Model.CurrentContractEffectiveFromUtc.HasValue)
                                        {
                                            <span>. Vigente desde @Model.CurrentContractEffectiveFromUtc.Value.ToString("yyyy-MM-dd") UTC.</span>
                                        }
                                    </p>
                                </div>

                                <div class="form-check contract-check">
                                    <input asp-for="AcceptCurrentContract" type="checkbox" class="form-check-input" value="true" required data-msg-required="Debes aceptar el contrato para crear tu cuenta." />
                                    <label asp-for="AcceptCurrentContract" class="form-check-label">
                                        He leido y acepto el Contrato de Uso del Servicio.
                                    </label>
                                </div>
                                <span asp-validation-for="AcceptCurrentContract" class="text-danger d-block mt-2"></span>

                                <div class="contract-consent-links">
                                    <span>Incluye terminos, privacidad, pagos y consentimiento de datos.</span>
                                    <a asp-controller="Contract" asp-action="Index" target="_blank" rel="noopener">Leer contrato completo</a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="contract-consent-card contract-consent-card-warning mt-4">
                                <div class="contract-consent-copy">
                                    <span class="section-kicker">Contrato no disponible</span>
                                    <h3>No hay una version vigente configurada.</h3>
                                    <p>No podemos completar el registro mientras no exista un contrato activo publicado en base de datos.</p>
                                </div>
                            </div>
                        }

                        <button type="submit" form="registration-form" class="btn public-btn public-btn-primary w-100 mt-4" disabled="@(!Model.HasCurrentContract ? "disabled" : null)">Crear cuenta y continuar</button>

                        <div class="auth-links-row">
                            <a asp-action="Acceso" asp-route-returnurl="@returnUrl">Ya tengo cuenta</a>
                            <a asp-action="OlvidoPassword">Olvide mi contrasena</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
