@model LuxuryApp.Models.Identity.RegistroViewModel

@{
	ViewData["Tittle"] = "Registro de usuario";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
	<div class="card-body">
		<h3 class="card-title text-center">Registro de usuario</h3>
		<form asp-controller="Accounts" asp-action="Registro" method="post">
		<div class="text-danger" asp-validation-summary="All"></div>

			<div class="row mt-4">
				<div class="col-sm-6">

					<div class="mb-3">
						<label asp-for="Name" class="col-md-2"></label>
						<input asp-for="Name" class="form-control" placeholder="Ingresa tu nombre" />
						<span asp-validation-for="Name" class="text-danger"></span>
					</div>

					<div class="mb-3">
						<label asp-for="Email" class="col-md-2"></label>
						<input asp-for="Email" class="form-control" placeholder="Ingresa tu email"  />
						<span asp-validation-for="Email" class="text-danger"></span>
					</div>

					

					<div class="mb-3">
						<label asp-for="PhoneNumber" class="col-md-2"></label>
						<input asp-for="PhoneNumber" class="form-control" placeholder="Ingresa tu telefono" />
						<span asp-validation-for="PhoneNumber" class="text-danger"></span>
					</div>

					<div class="mb-3">
						<label asp-for="Password" class="col-md-2"></label>
						<input asp-for="Password" class="form-control" placeholder="Ingresa la contraseña" />
						<span asp-validation-for="Password" class="text-danger"></span>
					</div>

					<div class="mb-3">
						<label asp-for="ConfirmPassword" class="col-md-4"></label>
						<input asp-for="ConfirmPassword" class="form-control" placeholder="Confrima la contraseña" />
						<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
					</div>

				</div>
			</div>

			<div class="row">
				<div class="col-sm-10 offset-2">
					<button type="submit" class="btn btn-success w-75 btn-lg bg-dark">Registrarse</button>
					<p><a asp-action="Acceso">Acceder con un usuario existente</a></p>
				</div>
			</div>

		</form>
	</div>
</div>

















