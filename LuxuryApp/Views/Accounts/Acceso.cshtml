@model LuxuryApp.Models.Identity.AccesoViewModel

@{
    ViewData["Title"] = "Acceso";
    ViewData["PublicBodyClass"] = "public-auth-page";
    Layout = "_PublicLayout";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<section class="auth-section">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-5" data-aos="fade-right">
                <div class="auth-story-card">
                    <span class="section-kicker">Acceso al SaaS</span>
                    <h1>Entra a tu espacio y sigue operando desde donde lo dejaste.</h1>
                    <p>
                        Si venias desde precios o una activacion pendiente, el sistema conserva tu retorno para que
                        puedas continuar con el flujo correcto despues del inicio de sesion.
                    </p>

                    <ul class="auth-benefit-list">
                        <li>Login conectado con la validacion actual de tenant y estado de cuenta</li>
                        <li>Separacion visual entre marketing publico y operacion privada</li>
                        <li>Continuidad para checkout, renovacion y acceso a modulos internos</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-7 col-xl-5" data-aos="fade-left">
                <div class="auth-form-card">
                    <span class="section-kicker">Iniciar sesion</span>
                    <h2>Accede a tu cuenta.</h2>

                    <form asp-controller="Accounts" asp-action="Acceso" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnurl" value="@returnUrl" />

                        <div class="text-danger auth-validation" asp-validation-summary="All"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control public-form-control" placeholder="correo@negocio.com" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" type="password" class="form-control public-form-control" placeholder="Contrasena" />
                        </div>

                        <div class="form-check public-check mb-4">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>

                        <button type="submit" class="btn public-btn public-btn-primary w-100">Entrar</button>

                        <div class="auth-links-row">
                            <a asp-action="Registro" asp-route-returnurl="@returnUrl">Crear cuenta</a>
                            <a asp-action="OlvidoPassword">Olvide mi contrasena</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
