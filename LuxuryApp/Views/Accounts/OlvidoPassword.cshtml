@model LuxuryApp.Models.Identity.OlvidoPasswordViewModel

@{
    ViewData["Title"] = "Recuperar contraseña";
    ViewData["PublicBodyClass"] = "public-auth-page";
    Layout = "_PublicLayout";
}

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 col-xl-5" data-aos="fade-up">
                <div class="auth-form-card">
                    <span class="section-kicker">Recuperar acceso</span>
                    <h2>Recuperar contraseña</h2>
                    <p class="text-muted mb-4">
                        Ingresa el correo asociado a tu cuenta y te enviaremos un enlace seguro para crear una nueva contraseña.
                    </p>

                    <form asp-controller="Accounts" asp-action="OlvidoPassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="text-danger auth-validation mb-3" asp-validation-summary="All"></div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label">Correo electrónico</label>
                            <input asp-for="Email" class="form-control public-form-control" placeholder="correo@negocio.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn public-btn public-btn-primary w-100">
                            Enviar enlace de recuperación
                        </button>

                        <div class="auth-links-row">
                            <a asp-action="Acceso">Volver a iniciar sesión</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
