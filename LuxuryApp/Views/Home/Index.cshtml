@model LuxuryApp.Models.Marketing.PublicHomeViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "LuxuryCloud | Software para barberías, salones y negocios de servicios en Costa Rica";
    ViewData["MetaDescription"] = "Programa para barberías, salones y negocios de servicios en Costa Rica: agenda, recordatorios por WhatsApp, reservas en línea, clientes, equipo, ingresos, egresos y estadísticas en una sola plataforma.";
    ViewData["CanonicalUrl"] = "https://luxurycloud.app/";
    ViewData["PublicBodyClass"] = "public-home-page";

    // Precio de entrada tomado del plan público válido más económico. Nunca se hardcodea:
    // si no hay planes disponibles, la sección de precios muestra un mensaje neutro.
    var startingPlan = Model.Plans.Count > 0
        ? Model.Plans.OrderBy(plan => plan.MonthlyPrice).First()
        : null;

    // Formato con separador de miles "." independiente de la cultura del hilo (es-CR).
    var crFormat = new System.Globalization.NumberFormatInfo
    {
        NumberGroupSeparator = ".",
        NumberDecimalDigits = 0
    };
    string FormatColones(decimal amount) => amount.ToString("N0", crFormat);
    var startingPriceDisplay = startingPlan is not null ? FormatColones(startingPlan.MonthlyPrice) : null;

    // Video del fundador: opcional y configurable. Si no hay URL, se muestra el panel del
    // producto (representación fiel), nunca un reproductor vacío.
    var founderVideoUrl = Configuration["PublicSite:FounderVideoUrl"];
    var founderVideoPoster = Configuration["PublicSite:FounderVideoPosterUrl"];
    var hasFounderVideo = !string.IsNullOrWhiteSpace(founderVideoUrl);
}

@section Styles {
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LuxuryCloud" />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:title" content="LuxuryCloud | Software para barberías, salones y negocios de servicios" />
    <meta property="og:description" content="Agenda, recordatorios por WhatsApp, reservas en línea, clientes, equipo e indicadores del negocio en una sola plataforma creada en Costa Rica." />
    <meta property="og:url" content="https://luxurycloud.app/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="LuxuryCloud | Software para barberías, salones y negocios de servicios" />
    <meta name="twitter:description" content="Ordene su agenda, sus clientes y su dinero en una sola plataforma creada en Costa Rica." />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Organization",
      "name": "LuxuryCloud",
      "url": "https://luxurycloud.app/",
      "areaServed": "CR",
      "description": "Plataforma de gestión para barberías, salones y negocios de servicios en Costa Rica."
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "SoftwareApplication",
      "name": "LuxuryCloud",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "url": "https://luxurycloud.app/",
      "description": "Software para barberías, salones y negocios de servicios: agenda, recordatorios por WhatsApp, reservas en línea, clientes, equipo, ingresos, egresos y estadísticas."
    }
    </script>
}

<!-- ═══════════════════════════ 1 · HERO ═══════════════════════════════ -->
<section class="hero-section">
    <div class="container">
        <div class="hero-layout">

            <div class="hero-text-col" data-aos="fade-right">
                <span class="hero-kicker">Creado en Costa Rica para barberías, salones y negocios de servicios</span>
                <h1 class="hero-title">Tenga su agenda, sus clientes y su dinero bajo control.</h1>
                <p class="hero-copy">
                    LuxuryCloud reúne citas, recordatorios por WhatsApp, reservas en línea, equipo,
                    ingresos, egresos y estadísticas en un solo lugar, para que usted deje de adivinar
                    y empiece a dirigir su negocio con claridad.
                </p>
                <div class="hero-actions">
                    <a class="btn public-btn public-btn-primary" href="#como-funciona" data-analytics-event="hero_ver_como_funciona">
                        Ver cómo funciona
                    </a>
                    <a class="btn public-btn public-btn-secondary" asp-controller="Accounts" asp-action="Registro" data-analytics-event="hero_crear_cuenta">
                        Crear cuenta
                    </a>
                    <a class="btn public-btn public-btn-ghost" asp-controller="Accounts" asp-action="Acceso" data-analytics-event="hero_iniciar_sesion">
                        Iniciar sesión
                    </a>
                </div>
                <ul class="hero-trust hero-trust-list">
                    <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Cree su cuenta sin tarjeta</li>
                    <li><i class="bi bi-hand-thumbs-up-fill" aria-hidden="true"></i> Acompañamiento inicial</li>
                    <li><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Cancele la renovación cuando quiera</li>
                </ul>
            </div>

            <div class="hero-exec-col" data-aos="fade-left">
                @if (hasFounderVideo)
                {
                    <div class="hero-video-card">
                        @if (string.IsNullOrWhiteSpace(founderVideoPoster))
                        {
                            <video class="hero-video" controls preload="none">
                                <source src="@founderVideoUrl" />
                                Su navegador no puede reproducir este video. Puede
                                <a asp-controller="Accounts" asp-action="Registro">crear su cuenta</a> para ver la plataforma.
                            </video>
                        }
                        else
                        {
                            <video class="hero-video" controls preload="none" poster="@founderVideoPoster">
                                <source src="@founderVideoUrl" />
                                Su navegador no puede reproducir este video. Puede
                                <a asp-controller="Accounts" asp-action="Registro">crear su cuenta</a> para ver la plataforma.
                            </video>
                        }
                        <p class="hero-video-caption">Conozca la plataforma en un recorrido corto.</p>
                    </div>
                }
                else
                {
                    <div class="hero-exec-card" role="img" aria-label="Resumen ejecutivo del negocio: 34 citas programadas hoy, ₡486 mil de ingresos del día, 146 clientes frecuentes y 9 integrantes del equipo activos.">
                        <div class="hero-exec-header">
                            <div class="hero-exec-icon" aria-hidden="true"><i class="bi bi-graph-up-arrow"></i></div>
                            <span class="hero-exec-label">Resumen ejecutivo</span>
                            <div class="hero-exec-today">Hoy <i class="bi bi-chevron-down" aria-hidden="true"></i></div>
                        </div>
                        <div class="hero-exec-grid">

                            <div class="hero-exec-stat">
                                <div class="hero-exec-stat-header">
                                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                                    <span>Agenda del día</span>
                                </div>
                                <strong class="hero-exec-stat-value">34</strong>
                                <span class="hero-exec-stat-sub">citas programadas</span>
                                <div class="hero-exec-progress" role="presentation">
                                    <div class="hero-exec-progress-bar" style="width:78%"></div>
                                </div>
                                <span class="hero-exec-stat-note">4 espacios libres</span>
                            </div>

                            <div class="hero-exec-stat">
                                <div class="hero-exec-stat-header">
                                    <i class="bi bi-currency-dollar" aria-hidden="true"></i>
                                    <span>Ingresos del día</span>
                                </div>
                                <strong class="hero-exec-stat-value hero-exec-stat-value-accent">₡486k</strong>
                                <span class="hero-exec-stat-badge-pos">+18% vs. promedio semanal</span>
                                <svg class="hero-exec-sparkline" viewBox="0 0 80 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <polyline points="0,25 15,20 30,22 45,12 60,15 75,5 80,8" stroke="#8be9ff" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </div>

                            <div class="hero-exec-stat">
                                <div class="hero-exec-stat-header">
                                    <i class="bi bi-people" aria-hidden="true"></i>
                                    <span>Clientes frecuentes</span>
                                </div>
                                <strong class="hero-exec-stat-value">146</strong>
                                <span class="hero-exec-stat-sub">perfiles activos</span>
                                <div class="hero-exec-avatars" aria-hidden="true">
                                    <span class="hero-exec-avatar">MJ</span>
                                    <span class="hero-exec-avatar">CA</span>
                                    <span class="hero-exec-avatar">LR</span>
                                    <span class="hero-exec-avatar hero-exec-avatar-more">+43</span>
                                </div>
                            </div>

                            <div class="hero-exec-stat">
                                <div class="hero-exec-stat-header">
                                    <i class="bi bi-person-badge" aria-hidden="true"></i>
                                    <span>Equipo activo</span>
                                </div>
                                <strong class="hero-exec-stat-value hero-exec-stat-value-green">9</strong>
                                <span class="hero-exec-stat-sub">integrantes activos</span>
                                <div class="hero-exec-progress" role="presentation">
                                    <div class="hero-exec-progress-bar hero-exec-progress-bar-green" style="width:87%"></div>
                                </div>
                                <span class="hero-exec-stat-note">87% de ocupación promedio</span>
                            </div>

                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</section>

<!-- ═══════════════════════════ 2 · PROBLEMA ═══════════════════════════ -->
<section class="lp-problem-section">
    <div class="container">
        <div class="lp-problem-layout">
            <div class="lp-problem-intro" data-aos="fade-up">
                <span class="section-kicker">El día a día del dueño</span>
                <h2>¿Su negocio está creciendo, pero cada vez cuesta más controlarlo?</h2>
                <p>
                    Cuando las citas, los clientes, los cobros y el equipo se administran por separado,
                    el dueño termina resolviendo problemas todo el día sin tener una visión completa del negocio.
                </p>
            </div>
            <ul class="lp-problem-list" data-aos="fade-up" data-aos-delay="80">
                <li>
                    <i class="bi bi-chat-left-dots" aria-hidden="true"></i>
                    <span>Citas repartidas entre mensajes, llamadas y memoria.</span>
                </li>
                <li>
                    <i class="bi bi-person-dash" aria-hidden="true"></i>
                    <span>Clientes que dejan de volver sin recibir seguimiento.</span>
                </li>
                <li>
                    <i class="bi bi-cash-stack" aria-hidden="true"></i>
                    <span>Ingresos, gastos y pagos del equipo difíciles de cuadrar.</span>
                </li>
                <li>
                    <i class="bi bi-question-circle" aria-hidden="true"></i>
                    <span>Decisiones importantes tomadas sin números claros.</span>
                </li>
            </ul>
        </div>
        <p class="lp-problem-close" data-aos="fade-up">
            LuxuryCloud convierte ese desorden en una operación clara, conectada y medible.
        </p>
    </div>
</section>

<!-- ═══════════════════ 3 · RESULTADOS Y FUNCIONES ═════════════════════ -->
<section class="lp-results-section" id="funciones">
    <div class="container">
        <div class="section-heading text-center" data-aos="fade-up">
            <span class="section-kicker">Resultados para su negocio</span>
            <h2>Todo lo importante de su negocio, conectado.</h2>
            <p>Cada capacidad de LuxuryCloud está pensada para darle un resultado concreto, no solo más pantallas.</p>
        </div>

        <div class="lp-results-grid">
            <article class="lp-result-card" data-aos="fade-up">
                <div class="lp-result-icon" aria-hidden="true"><i class="bi bi-calendar2-check"></i></div>
                <h3>Organice el día</h3>
                <p>Vea sus citas, sus espacios libres y lo que viene, sin depender de mensajes sueltos ni de la memoria.</p>
                <span class="lp-result-modules">Agenda · Reservas en línea · Recordatorios</span>
            </article>
            <article class="lp-result-card" data-aos="fade-up" data-aos-delay="70">
                <div class="lp-result-icon" aria-hidden="true"><i class="bi bi-person-hearts"></i></div>
                <h3>Conozca y recupere clientes</h3>
                <p>Guarde el historial de cada persona y déle seguimiento para que vuelva más seguido.</p>
                <span class="lp-result-modules">Clientes · Historial · Recordatorios por WhatsApp</span>
            </article>
            <article class="lp-result-card" data-aos="fade-up" data-aos-delay="140">
                <div class="lp-result-icon" aria-hidden="true"><i class="bi bi-cash-coin"></i></div>
                <h3>Entienda su dinero</h3>
                <p>Sepa cuánto entra, cuánto sale y cuánto le queda, con ingresos, egresos y liquidaciones al día.</p>
                <span class="lp-result-modules">Ingresos · Egresos · Liquidaciones · Estadísticas</span>
            </article>
            <article class="lp-result-card" data-aos="fade-up" data-aos-delay="210">
                <div class="lp-result-icon" aria-hidden="true"><i class="bi bi-stars"></i></div>
                <h3>Proyecte una imagen profesional</h3>
                <p>Ofrezca reservas en línea y una página pública propia para que su negocio se vea a la altura de su trabajo.</p>
                <span class="lp-result-modules">Reservas · Página pública · Productos</span>
            </article>
        </div>
    </div>
</section>

<!-- ═══════════════════ 4 · ASÍ SE VE UN DÍA ═══════════════════════════ -->
<section class="lp-day-section" id="como-funciona">
    <div class="container">
        <div class="section-heading text-center" data-aos="fade-up">
            <span class="section-kicker">Cómo funciona</span>
            <h2>Así se ve un día con LuxuryCloud</h2>
            <p>Una operación ordenada, de la mañana al cierre, sin duplicar información.</p>
        </div>

        <ol class="lp-day-timeline">
            <li class="lp-day-step" data-aos="fade-up">
                <span class="lp-day-time"><i class="bi bi-sunrise" aria-hidden="true"></i> Al comenzar</span>
                <p>Revise las citas del día, los espacios disponibles y la actividad que espera.</p>
            </li>
            <li class="lp-day-step" data-aos="fade-up" data-aos-delay="70">
                <span class="lp-day-time"><i class="bi bi-lightning-charge" aria-hidden="true"></i> Mientras trabaja</span>
                <p>Registre servicios, cobros, productos y movimientos sin volver a escribir la misma información.</p>
            </li>
            <li class="lp-day-step" data-aos="fade-up" data-aos-delay="140">
                <span class="lp-day-time"><i class="bi bi-phone" aria-hidden="true"></i> Para el cliente</span>
                <p>El cliente recibe recordatorios, consulta sus servicios y reserva desde el teléfono.</p>
            </li>
            <li class="lp-day-step" data-aos="fade-up" data-aos-delay="210">
                <span class="lp-day-time"><i class="bi bi-moon-stars" aria-hidden="true"></i> Al cerrar</span>
                <p>Sepa cuánto ingresó, cuánto gastó y cómo trabajó cada integrante del equipo.</p>
            </li>
        </ol>
    </div>
</section>

<!-- ═══════════════════ 5 · HISTORIA DEL FUNDADOR ══════════════════════ -->
<section class="lp-founder-section">
    <div class="container">
        <div class="lp-founder-card" data-aos="fade-up">
            <div class="lp-founder-mark" aria-hidden="true">JR</div>
            <div class="lp-founder-body">
                <span class="section-kicker">Nuestra historia</span>
                <h2>Creado a partir de problemas reales de negocios de servicios</h2>
                <p>
                    Soy Jefferson Rojas, fundador de LuxuryCloud. La idea nació conversando con dueños de
                    barberías que tenían talento, clientes y mucho movimiento, pero no una forma sencilla
                    de controlar todo lo que ocurría en el negocio.
                </p>
                <p>
                    Por eso construimos una plataforma especializada, fácil de usar y acompañada localmente.
                </p>
                <p class="lp-founder-highlight">
                    No se trata de agregar otra aplicación. Se trata de recuperar el control del negocio.
                </p>
                <span class="lp-founder-sign">Jefferson Rojas · Fundador de LuxuryCloud</span>
            </div>
        </div>
    </div>
</section>

