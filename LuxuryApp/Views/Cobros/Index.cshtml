@using LuxuryApp.Models.Finanzas
@model CobroIndexViewModel

<div class="card border-0 shadow-lg">
    <div class="card-header bg-dark text-white py-3">
        <h5 class="m-0">
            <i class="fas fa-coins me-2"></i>Finanzas - Cobros
        </h5>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3 mx-3 mb-3">

        <a asp-action="Create" class="btn btn-dark text-white">
            <i class="fas fa-plus me-1"></i>Nuevo Cobro
        </a>

        <div class="d-flex gap-2 align-items-center">
            <button class="btn btn-outline-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#modalServicios"
                    onclick="cargarServicios()">
                ⚙ Gestionar Servicios
            </button>

            <button type="submit"
                    form="formFiltros"
                    formaction="@Url.Action("ExportarExcel")"
                    class="btn btn-success shadow-sm px-4">
                <i class="fas fa-file-excel me-1"></i> Excel
            </button>
        </div>

    </div>

    <form method="get" id="formFiltros" class="row g-2 px-3 mb-3">

        <div class="col-md-3">
            <select asp-for="Filtros.VistaTiempo" class="form-select" id="vistaTiempoSelect">

                <option value="dia">Hoy</option>
                <option value="semana">Semana</option>
                <option value="mes">Mes</option>
                <option value="anio">Año</option>
                <option value="fechas">Rango de Fechas</option>
                <option value="todo">Todo</option>

            </select>

            <div class="d-flex gap-2 mt-2" id="rangoFechasContainer" style="display:none;">

                <input asp-for="Filtros.FechaInicio"
                       type="date"
                       class="form-control" />

                <input asp-for="Filtros.FechaFin"
                       type="date"
                       class="form-control" />

            </div>
        </div>

        <div class="col-md-3">
            <select asp-for="Filtros.FuncionarioId"
                    asp-items="Model.Funcionarios"
                    class="form-select">
                <option value="">Todos los Funcionarios</option>
            </select>
        </div>

        <div class="col-md-3 ">
            <select asp-for="Filtros.MetodoPago"
                    asp-items="Model.MetodosPago"
                    class="form-select">
                <option value="">Todos métodos</option>
            </select>
        </div>

        <div class="col-md-3 d-flex align-items-center justify-content-center gap-3">


            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       asp-for="Filtros.MostrarServicios"
                       id="chkServicios" />

                <label class="form-check-label" for="chkServicios">
                    ✂ Servicios
                </label>
            </div>

            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       asp-for="Filtros.MostrarProductos"
                       id="chkProductos" />

                <label class="form-check-label" for="chkProductos">
                    🧴 Productos
                </label>
            </div>

        </div>

    </form>

    

    <div class="row mx-3 mb-3 g-3">

        <!-- TOTAL SERVICIOS -->
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total en servicios</h6>
                    <h3 class="fw-bold text-primary">
                        ₡ @Model.TotalServicios.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

        <!-- TOTAL PRODUCTOS -->
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total en productos</h6>
                    <h3 class="fw-bold text-info">
                        ₡ @Model.TotalProductos.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

        <!-- TOTAL GENERADO -->
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total generado</h6>
                    <h3 class="fw-bold text-success">
                        ₡ @Model.TotalGenerado.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

        <!-- SIN IMPUESTOS -->
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total sin impuestos</h6>
                    <h3 class="fw-bold text-dark">
                        ₡ @Model.TotalSinImpuestos.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

        <!-- IMPUESTOS -->
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total de impuestos</h6>
                    <h3 class="fw-bold text-danger">
                        ₡ @Model.TotalImpuestos.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

    </div>


    <div class="row mx-3 mb-3 g-3">

        <!-- PAGADO FUNCIONARIOS -->
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total de funcionarios</h6>
                    <h3 class="fw-bold text-primary">
                        ₡ @Model.PagoColaboradores.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

        <!-- GANANCIA NEGOCIO -->
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Ganancia del negocio</h6>
                    <h3 class="fw-bold text-info">
                        ₡ @Model.GananciaNegocio.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

        <!-- EFECTIVO -->
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Monto en efectivo</h6>
                    <h3 class="fw-bold text-success">
                        ₡ @Model.GananciaEfectivo.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

        <!-- TARJETA -->
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">monto en tarjeta</h6>
                    <h3 class="fw-bold text-dark">
                        ₡ @Model.GananciaTarjeta.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

        <!-- SINPE -->
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Monto en sinpe</h6>
                    <h3 class="fw-bold text-danger">
                        ₡ @Model.GananciaSinpe.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

    </div>


    <div class="card-body p-0">
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Fecha</th>
                        <th>Cliente</th>
                        <th>Funcionario</th>
                        <th>Servicio / Producto</th>
                        <th>Monto</th>
                        <th>Método Pago</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Cobros.Any())
                    {
                        foreach (var cobro in Model.Cobros)
                        {
                            <tr>
                                <td class="ps-4">
                                    @cobro.FechaCobro.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td class="fw-semibold">
                                    @cobro.NombreCliente
                                </td>

                                <td>
                                    @cobro.FuncionarioNombre
                                </td>

                                <td>

                                    @if (cobro.EsServicio)
                                    {
                                        <span class="badge bg-primary me-2">Servicio</span>
                                        <span>@cobro.Detalle</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark me-2">Producto</span>
                                        <span>@cobro.Detalle</span>
                                    }

                                </td>

                                <td>
                                    ₡ @cobro.Monto.ToString("N2")
                                </td>

                                <td>
                                    @cobro.MetodoPago
                                </td>

                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Edit"
                                           asp-route-id="@cobro.IdCobro"
                                           class="btn btn-sm btn-outline-dark">
                                            <i class="fas fa-edit me-1"></i>Editar
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@cobro.IdCobro"
                                              method="post"
                                              onsubmit="return confirm('¿Eliminar este cobro? Esta accion actualizara los KPIs y dashboards.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash me-1"></i>Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No hay cobros registrados
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>
</div>

<div class="modal fade" id="modalServicios" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Gestión de Servicios</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="contenedorServicios">
                Cargando servicios...
            </div>

        </div>
    </div>
</div>

@section Scripts {

    <script>

        function toggleRangoFechas() {

            const select = document.getElementById("vistaTiempoSelect");
            const container = document.getElementById("rangoFechasContainer");

            if (select.value === "fechas") {
                container.classList.remove("d-none");
            }
            else {
                container.classList.add("d-none");
            }
        }

        // Ejecutar cuando carga la página
        document.addEventListener("DOMContentLoaded", function () {

            const select = document.getElementById("vistaTiempoSelect");

            toggleRangoFechas();

            select.addEventListener("change", toggleRangoFechas);

        });
                document.addEventListener("DOMContentLoaded", function () {

            const form = document.getElementById("formFiltros");

            const filtros = form.querySelectorAll("select, input");

            filtros.forEach(filtro => {

                filtro.addEventListener("change", function () {

                    // Si selecciona rango de fechas no enviar todavía
                    if (this.id === "vistaTiempoSelect") {

                        toggleRangoFechas();

                        if (this.value !== "fechas") {
                            form.submit();
                        }

                        return;
                    }

                    form.submit();

                });

            });

        });
                document.querySelectorAll("#rangoFechasContainer input").forEach(input => {

            input.addEventListener("change", function () {

                const inicio = document.querySelector("[name='Filtros.FechaInicio']").value;
                const fin = document.querySelector("[name='Filtros.FechaFin']").value;

                if (inicio && fin) {
                    document.getElementById("formFiltros").submit();
                }

            });

        });

    </script>

}

