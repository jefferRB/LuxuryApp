@using LuxuryApp.Models.Finanzas
@model CobroIndexViewModel

<div class="card border-0 shadow-lg">
    <div class="card-header bg-dark text-white py-3">
        <h5 class="m-0">
            <i class="fas fa-coins me-2"></i>Finanzas - Cobros
        </h5>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3 mx-3 mb-3">

        <a asp-action="Create" class="btn btn-dark text-white">
            <i class="fas fa-plus me-1"></i>Nuevo Cobro
        </a>

        <div class="d-flex gap-2 align-items-center">
            <button class="btn btn-outline-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#modalServicios"
                    onclick="cargarServicios()">
                ⚙ Gestionar Servicios
            </button>
        </div>

    </div>

    <form method="get" class="row g-2 px-3 mb-3">

        <div class="col-md-3">
            <select asp-for="Filtros.VistaTiempo" class="form-select" id="vistaTiempoSelect">

                <option value="dia">Hoy</option>
                <option value="semana">Semana</option>
                <option value="mes">Mes</option>
                <option value="anio">Año</option>
                <option value="fechas">Rango de Fechas</option>
                <option value="todo">Todo</option>

            </select>

            <div class="d-flex gap-2 mt-2" id="rangoFechasContainer" style="display:none;">

                <input asp-for="Filtros.FechaInicio"
                       type="date"
                       class="form-control" />

                <input asp-for="Filtros.FechaFin"
                       type="date"
                       class="form-control" />

            </div>
        </div>

        <div class="col-md-3">
            <select asp-for="Filtros.BarberoId"
                    asp-items="Model.Barberos"
                    class="form-select">
                <option value="">Todos los barberos</option>
            </select>
        </div>

        <div class="col-md-3 ">
            <select asp-for="Filtros.MetodoPago"
                    asp-items="Model.MetodosPago"
                    class="form-select">
                <option value="">Todos métodos</option>
            </select>
        </div>

        <div class="col-md-3 d-flex align-items-center justify-content-center gap-3">


            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       asp-for="Filtros.MostrarServicios"
                       id="chkServicios" />

                <label class="form-check-label" for="chkServicios">
                    ✂ Servicios
                </label>
            </div>

            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       asp-for="Filtros.MostrarProductos"
                       id="chkProductos" />

                <label class="form-check-label" for="chkProductos">
                    🧴 Productos
                </label>
            </div>

        </div>

        <div class="col-12">
            <div class="d-flex justify-content-center gap-3 mt-2">

                <button type="submit"
                        formaction="@Url.Action("Index")"
                        class="btn btn-dark shadow-sm px-4">
                    <i class="fas fa-filter me-1"></i> Filtrar
                </button>

                <button type="submit"
                        formaction="@Url.Action("ExportarExcel")"
                        class="btn btn-success shadow-sm px-4">
                    <i class="fas fa-file-excel me-1"></i> Excel
                </button>

            </div>
        </div>

    </form>

    

    <div class="row mx-3 mb-3 g-3">

        <!-- TOTAL COBRADO -->
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">
                        <i class="fas fa-coins me-1"></i>Total Cobrado
                    </h6>
                    <h3 class="fw-bold text-success">
                        ₡ @Model.TotalCobrado.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

        <!-- IMPUESTOS -->
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">
                        <i class="fas fa-file-invoice-dollar me-1"></i>Impuestos (13%)
                    </h6>
                    <h3 class="fw-bold text-danger">
                        ₡ @Model.TotalImpuestos.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

        <!-- TOTAL NETO -->
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">
                        <i class="fas fa-chart-line me-1"></i>Total Neto
                    </h6>
                    <h3 class="fw-bold text-dark">
                        ₡ @Model.TotalNeto.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

        <!-- PAGO COLABORADORES -->
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">
                        <i class="fas fa-user-tie me-1"></i>Pago Colaboradores
                    </h6>
                    <h3 class="fw-bold text-primary">
                        ₡ @Model.PagoColaboradores.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>

       


    </div>



    <div class="card-body p-0">
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Fecha</th>
                        <th>Cliente</th>
                        <th>Barbero</th>
                        <th>Servicio / Producto</th>
                        <th>Monto</th>
                        <th>Método Pago</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Cobros.Any())
                    {
                        foreach (var cobro in Model.Cobros)
                        {
                            <tr>
                                <td class="ps-4">
                                    @cobro.FechaCobro.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td class="fw-semibold">
                                    @cobro.NombreCliente
                                </td>

                                <td>
                                    @cobro.Barbero?.Nombre
                                </td>

                                <td>

                                    @if (cobro.ServicioId != null)
                                    {
                                        <span class="badge bg-primary me-2">Servicio</span>
                                        <span>@cobro.Servicio?.Nombre</span>
                                    }
                                    else if (cobro.ProductoId != null)
                                    {
                                        <span class="badge bg-warning text-dark me-2">Producto</span>
                                        <span>@cobro.Producto?.NombreProducto</span>
                                    }

                                </td>

                                <td>
                                    ₡ @cobro.Monto.ToString("N2")
                                </td>

                                <td>
                                    @cobro.MetodoPago
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No hay cobros registrados
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>
</div>

<div class="modal fade" id="modalServicios" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Gestión de Servicios</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="contenedorServicios">
                Cargando servicios...
            </div>

        </div>
    </div>
</div>

@section Scripts {

    <script>

        function toggleRangoFechas() {

            const select = document.getElementById("vistaTiempoSelect");
            const container = document.getElementById("rangoFechasContainer");

            if (select.value === "fechas") {
                container.classList.remove("d-none");
            }
            else {
                container.classList.add("d-none");
            }
        }

        // Ejecutar cuando carga la página
        document.addEventListener("DOMContentLoaded", function () {

            const select = document.getElementById("vistaTiempoSelect");

            toggleRangoFechas();

            select.addEventListener("change", toggleRangoFechas);

        });

    </script>

}

