@model LuxuryApp.Models.Finanzas.CobroViewModel

@{
    var esProducto = Model.Cobro.ProductoId.HasValue && !Model.Cobro.ServicioId.HasValue;
}

<div class="card border-0 shadow-lg">
    <div class="card-header bg-dark text-white py-3">
        <h5 class="m-0">
            <i class="fas fa-cash-register me-2"></i>Registrar Cobro
        </h5>
    </div>

    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Cobro.FechaCobro" class="form-label"></label>
                <input asp-for="Cobro.FechaCobro" class="form-control" type="datetime-local" step="60" />
            </div>

            <div class="mb-3">
                <label asp-for="Cobro.NombreCliente" class="form-label"></label>
                <input asp-for="Cobro.NombreCliente" class="form-control" placeholder="Nombre del cliente" />
                <span asp-validation-for="Cobro.NombreCliente" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cobro.FuncionarioId" class="form-label"></label>
                <select asp-for="Cobro.FuncionarioId" class="form-select" asp-items="Model.Funcionarios">
                    <option value="">Seleccione Funcionario</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Tipo</label>
                <select id="TipoItem" name="TipoItem" class="form-select">
                    <option value="servicio" selected="@(esProducto ? null : "selected")">Servicio</option>
                    <option value="producto" selected="@(esProducto ? "selected" : null)">Producto</option>
                </select>
            </div>

            <div class="mb-3 @(esProducto ? "d-none" : string.Empty)" id="ServicioContainer">
                <label asp-for="Cobro.ServicioId" class="form-label"></label>
                <select asp-for="Cobro.ServicioId"
                        class="form-select"
                        asp-items="Model.Servicios"
                        id="ServicioId"
                        disabled="@(esProducto ? "disabled" : null)">
                    <option value="">Seleccione servicio</option>
                </select>
            </div>

            <div class="mb-3 @(esProducto ? string.Empty : "d-none")" id="ProductoContainer">
                <label class="form-label">Producto</label>
                <select asp-for="Cobro.ProductoId"
                        class="form-select"
                        asp-items="Model.Productos"
                        id="ProductoId"
                        disabled="@(esProducto ? null : "disabled")">
                    <option value="">Seleccione producto</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Cobro.Monto" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>

                    <input asp-for="Cobro.Monto"
                           class="form-control money-input"
                           id="Monto"
                           type="number"
                           step="0.01"
                           autocomplete="off" />
                </div>
                <span asp-validation-for="Cobro.Monto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cobro.MetodoPago" class="form-label"></label>
                <select asp-for="Cobro.MetodoPago" class="form-select" asp-items="Model.MetodosPago">
                    <option value="">Seleccione método de pago</option>
                </select>
            </div>

            <button type="submit" class="btn btn-dark">
                <i class="fas fa-save me-1"></i>Guardar Cobro
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i>Volver
            </a>
        </form>
    </div>
</div>
