@model LuxuryApp.Models.Funcionarios.MisPagosViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Mis Pagos";
    ViewData["PortalActive"] = "pagos";
    var cr = new CultureInfo("es-CR");
    string Money(decimal v) => "₡" + v.ToString("#,##0.00", cr);
}

<div class="lp-card" style="margin-bottom:1rem;">
    <h1 style="font-size:1.3rem;font-weight:800;margin:0;">Mis pagos recibidos</h1>
    <p class="lp-muted" style="margin:.25rem 0 0;">Historial de pagos registrados por tu negocio.</p>
</div>

<div class="lp-kpis" style="margin-bottom:1.2rem;">
    <div class="lp-kpi">
        <div class="lp-kpi-label"><i class="bi bi-wallet2"></i> Total recibido histórico</div>
        <div class="lp-kpi-value lp-kpi-value--green">@Money(Model.TotalPagadoHistorico)</div>
    </div>
    <div class="lp-kpi">
        <div class="lp-kpi-label"><i class="bi bi-calendar-month"></i> Recibido este mes</div>
        <div class="lp-kpi-value lp-kpi-value--green">@Money(Model.RecibidoMes)</div>
    </div>
    <div class="lp-kpi">
        <div class="lp-kpi-label"><i class="bi bi-clock-history"></i> Último pago</div>
        <div class="lp-kpi-value" style="font-size:1.05rem;">@(Model.UltimoPago?.ToString("dd/MM/yyyy", cr) ?? "—")</div>
    </div>
    <div class="lp-kpi">
        <div class="lp-kpi-label"><i class="bi bi-receipt"></i> Pagos registrados</div>
        <div class="lp-kpi-value">@Model.PagosRegistrados</div>
    </div>
</div>

<div class="lp-card">
    <h2 class="lp-section-title"><i class="bi bi-cash-stack"></i> Historial</h2>
    @if (Model.Pagos.Count == 0)
    {
        <p class="lp-muted" style="margin:0;">Aún no tienes pagos registrados.</p>
    }
    else
    {
        <div style="display:flex;flex-direction:column;gap:.55rem;">
            @foreach (var pago in Model.Pagos)
            {
                <div style="display:flex;align-items:center;gap:.75rem;padding:.7rem;border:1px solid var(--lp-border);border-radius:.7rem;">
                    <div style="width:2.4rem;height:2.4rem;border-radius:.6rem;background:var(--lp-green-bg);color:var(--lp-green);display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;">
                        <i class="bi bi-check2"></i>
                    </div>
                    <div style="flex:1;min-width:0;">
                        <div style="font-weight:800;font-size:1rem;color:var(--lp-green);">@Money(pago.Monto)</div>
                        <div class="lp-muted" style="font-size:.78rem;">
                            Pagado el @pago.FechaPago.ToString("dd/MM/yyyy", cr)
                            @if (!string.IsNullOrWhiteSpace(pago.MetodoPago))
                            {
                                <span> · @pago.MetodoPago</span>
                            }
                        </div>
                        <div class="lp-muted" style="font-size:.74rem;">
                            Semana @pago.InicioSemana.ToString("dd/MM", cr) - @pago.FinSemana.ToString("dd/MM", cr)
                        </div>
                        @if (!string.IsNullOrWhiteSpace(pago.Observacion))
                        {
                            <div class="lp-muted" style="font-size:.74rem;font-style:italic;">@pago.Observacion</div>
                        }
                    </div>
                </div>
            }
        </div>

        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1rem;gap:.5rem;flex-wrap:wrap;">
            <span class="lp-muted" style="font-size:.8rem;">
                Mostrando @Model.DesdeRegistro a @Model.HastaRegistro de @Model.TotalRegistros pagos
            </span>
            @if (Model.TotalPaginas > 1)
            {
                <div style="display:flex;gap:.5rem;align-items:center;">
                    @if (Model.Pagina > 1)
                    {
                        <a href="/MiPortal/Pagos?pagina=@(Model.Pagina - 1)" class="lp-btn lp-btn--ghost"><i class="bi bi-chevron-left"></i></a>
                    }
                    <span class="lp-muted" style="font-size:.8rem;">@Model.Pagina / @Model.TotalPaginas</span>
                    @if (Model.HayMas)
                    {
                        <a href="/MiPortal/Pagos?pagina=@(Model.Pagina + 1)" class="lp-btn lp-btn--ghost"><i class="bi bi-chevron-right"></i></a>
                    }
                </div>
            }
        </div>
    }
</div>
