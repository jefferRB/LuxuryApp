@model LuxuryApp.Models.Funcionarios.MiPanelViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Mi Portal";
    ViewData["PortalActive"] = "panel";
    var cr = new CultureInfo("es-CR");
    string Money(decimal v) => "₡" + v.ToString("#,##0.00", cr);
    ViewData["CobroRetorno"] = "panel";
}

<div class="lp-card" style="margin-bottom:1rem;">
    <h1 style="font-size:1.35rem;font-weight:800;margin:0;">Hola, @Model.Nombre 👋</h1>
    <p class="lp-muted" style="margin:.25rem 0 .15rem;font-size:.9rem;text-transform:none;">
        Este es tu portal de trabajo: citas, cobros, ganancias y pagos en un solo lugar.
    </p>
    <p class="lp-muted" style="margin:0;text-transform:capitalize;font-size:.82rem;">
        @Model.Hoy.ToString("dddd, dd 'de' MMMM 'de' yyyy", cr)
    </p>
    <p class="lp-muted" style="margin:.35rem 0 0;font-size:.85rem;text-transform:none;">
        <i class="bi bi-info-circle"></i>
        Tienes @Model.KpisHoy.CitasHoy cita@(Model.KpisHoy.CitasHoy == 1 ? "" : "s") hoy y @Model.KpisHoy.PendientesHoy pendiente@(Model.KpisHoy.PendientesHoy == 1 ? "" : "s") de cobro.
    </p>
</div>

<!-- RESUMEN DE HOY -->
<h2 class="lp-section-title"><i class="bi bi-sun"></i> Resumen de hoy</h2>
<div class="lp-kpis" style="margin-bottom:1.2rem;">
    <div class="lp-kpi">
        <div class="lp-kpi-label"><i class="bi bi-calendar-check"></i> Citas de hoy</div>
        <div class="lp-kpi-value">@Model.KpisHoy.CitasHoy</div>
        <div class="lp-muted" style="font-size:.72rem;">@Model.KpisHoy.PendientesHoy pendiente@(Model.KpisHoy.PendientesHoy == 1 ? "" : "s")</div>
    </div>
    <div class="lp-kpi">
        <div class="lp-kpi-label"><i class="bi bi-scissors"></i> Producción de hoy</div>
        <div class="lp-kpi-value lp-kpi-value--green">@Money(Model.ResumenHoy.ProduccionTotal)</div>
    </div>
    <div class="lp-kpi">
        <div class="lp-kpi-label"><i class="bi bi-graph-up-arrow"></i> Comisión estimada hoy</div>
        <div class="lp-kpi-value lp-kpi-value--green">@Money(Model.ResumenHoy.TotalEstimado)</div>
    </div>
    <div class="lp-kpi">
        <div class="lp-kpi-label"><i class="bi bi-hourglass-split"></i> Pendiente de cobrar</div>
        <div class="lp-kpi-value lp-kpi-value--amber">@Money(Model.KpisHoy.PendienteCobrarHoy)</div>
    </div>
</div>

<!-- CITAS DE HOY -->
<div class="lp-card" style="margin-bottom:1rem;">
    <h2 class="lp-section-title"><i class="bi bi-calendar-check"></i> Citas de hoy</h2>
    @if (Model.CitasHoy.Count == 0)
    {
        <p class="lp-muted" style="margin:0;">No tienes citas para hoy.</p>
    }
    else
    {
        ViewData["PuedeRegistrarCobros"] = Model.PuedeRegistrarCobros;
        <div style="display:flex;flex-direction:column;gap:.55rem;">
            @foreach (var cita in Model.CitasHoy)
            {
                <partial name="_PortalCitaRow" model="cita" />
            }
        </div>
    }
</div>

@{ ViewData["PuedeRegistrarCobros"] = false; }

<!-- PRÓXIMAS CITAS -->
<div class="lp-card" style="margin-bottom:1rem;">
    <h2 class="lp-section-title"><i class="bi bi-calendar3"></i> Próximas citas</h2>
    @if (Model.ProximasCitas.Count == 0)
    {
        <p class="lp-muted" style="margin:0;">No tienes próximas citas registradas.</p>
    }
    else
    {
        <div style="display:flex;flex-direction:column;gap:.55rem;">
            @foreach (var cita in Model.ProximasCitas)
            {
                <partial name="_PortalCitaRow" model="cita" />
            }
        </div>
    }
</div>

<!-- RESUMEN DE LA SEMANA -->
<h2 class="lp-section-title"><i class="bi bi-calendar-week"></i> Esta semana</h2>
<p class="lp-muted" style="margin-top:-.4rem;">
    @Model.InicioSemana.ToString("dd/MM", cr) al @Model.FinSemana.ToString("dd/MM", cr)
</p>
<div class="lp-kpis">
    <div class="lp-kpi">
        <div class="lp-kpi-label">Producción</div>
        <div class="lp-kpi-value lp-kpi-value--green">@Money(Model.ProduccionSemana)</div>
    </div>
    <div class="lp-kpi">
        <div class="lp-kpi-label">Comisión estimada</div>
        <div class="lp-kpi-value lp-kpi-value--green">@Money(Model.ComisionSemana)</div>
    </div>
    <div class="lp-kpi">
        <div class="lp-kpi-label">Pagado</div>
        <div class="lp-kpi-value lp-kpi-value--green">@Money(Model.PagadoSemana)</div>
    </div>
    <div class="lp-kpi">
        <div class="lp-kpi-label">Pendiente</div>
        <div class="lp-kpi-value lp-kpi-value--amber">@Money(Model.PendienteSemana)</div>
    </div>
</div>

@if (Model.PuedeRegistrarCobros)
{
    <partial name="_PortalCobroModal" />
}
