@{
    var retorno = ViewData["CobroRetorno"] as string ?? "panel";
}
<!-- Modal: Registrar cobro de una cita propia -->
<div class="modal fade" id="cobroModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:1rem;border:none;">
            <form method="post" action="/MiPortal/Cobros/Registrar">
                @Html.AntiForgeryToken()
                <input type="hidden" name="citaId" id="cobroCitaId" />
                <input type="hidden" name="retorno" value="@retorno" />

                <div class="modal-header" style="background:#111;color:#fff;border-radius:1rem 1rem 0 0;">
                    <h5 class="modal-title" style="font-size:1rem;font-weight:800;">
                        <i class="bi bi-cash-coin"></i> Registrar cobro
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <div class="lp-muted" style="font-size:.85rem;margin-bottom:.75rem;">
                        <div><strong id="cobroCliente" style="color:var(--lp-text);"></strong></div>
                        <div id="cobroServicio"></div>
                    </div>

                    <label class="lp-kpi-label" style="display:block;margin-bottom:.25rem;">Monto cobrado</label>
                    <div style="display:flex;align-items:center;gap:.4rem;margin-bottom:.9rem;">
                        <span style="font-weight:800;">₡</span>
                        <input type="number" name="monto" id="cobroMonto" step="0.01" min="0.01" required
                               class="form-control" style="border-radius:.6rem;" />
                    </div>

                    <label class="lp-kpi-label" style="display:block;margin-bottom:.25rem;">Método de pago</label>
                    <select name="metodoPago" class="form-select" style="border-radius:.6rem;margin-bottom:.9rem;">
                        <option value="EFECTIVO">Efectivo</option>
                        <option value="TARJETA">Tarjeta</option>
                        <option value="SINPE">SINPE</option>
                    </select>

                    <label class="lp-kpi-label" style="display:block;margin-bottom:.25rem;">Observación (opcional)</label>
                    <input type="text" name="observacion" maxlength="500" class="form-control" style="border-radius:.6rem;" />
                </div>

                <div class="modal-footer" style="border:none;">
                    <button type="button" class="lp-btn lp-btn--ghost" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="lp-btn lp-btn--gold"><i class="bi bi-check2"></i> Registrar cobro</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        var modalEl = document.getElementById("cobroModal");
        if (!modalEl) return;
        var modal = null;
        document.querySelectorAll(".js-cobrar-btn").forEach(function (btn) {
            btn.addEventListener("click", function () {
                document.getElementById("cobroCitaId").value = btn.dataset.citaId || "";
                document.getElementById("cobroCliente").textContent = btn.dataset.cliente || "Cliente";
                document.getElementById("cobroServicio").textContent = btn.dataset.servicio || "";
                document.getElementById("cobroMonto").value = btn.dataset.precio || "";
                modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            });
        });
    })();
</script>
