@model LuxuryApp.Models.Funcionarios.PortalCitaItem
@using System.Globalization
@{
    var cr = new CultureInfo("es-CR");
    var esBloqueo = !string.Equals(Model.Tipo, "CITA", System.StringComparison.OrdinalIgnoreCase);
    var puedeCobrar = (ViewData["PuedeRegistrarCobros"] as bool?) ?? false;
    var puedeEditar = (ViewData["PuedeEditarCitas"] as bool?) ?? false;
    var puedeCancelar = (ViewData["PuedeCancelarCitas"] as bool?) ?? false;
    var calFecha = ViewData["CalFecha"] as string ?? "";
    var tieneAcciones = !esBloqueo && (puedeEditar || puedeCancelar || (puedeCobrar && Model.EsCobrable) || Model.YaCobrada);
}
<div class="side-cita-card">
    <strong>@(esBloqueo ? Model.Servicio : Model.Cliente)</strong>
    <small>
        <span><i class="bi bi-clock"></i> @Model.FechaHora.ToString("hh:mm tt", cr)</span>
        @if (esBloqueo)
        {
            <span class="d-block"><i class="bi bi-pause-circle"></i> Bloqueo de agenda</span>
        }
        else
        {
            <span class="d-block"><i class="bi bi-scissors"></i> @Model.Servicio · @Model.DuracionEfectiva min</span>
            @if (!string.IsNullOrWhiteSpace(Model.Telefono))
            {
                <span class="d-block"><i class="bi bi-telephone"></i> <a href="tel:@Model.Telefono">@Model.Telefono</a></span>
            }
        }
    </small>

    @if (tieneAcciones)
    {
        <div class="mt-2 d-flex gap-2 flex-wrap align-items-center">
            @if (Model.YaCobrada)
            {
                <span class="cita-badge-cobrada"><i class="bi bi-check2-circle"></i> Cobrada</span>
            }
            else if (puedeCobrar && Model.EsCobrable)
            {
                <button type="button" class="btn btn-sm btn-success js-cobrar-btn"
                        data-cita-id="@Model.Id"
                        data-cliente="@Model.Cliente"
                        data-servicio="@Model.Servicio"
                        data-email="@Model.CorreoCliente"
                        data-precio="@(Model.PrecioServicio?.ToString("0.##", CultureInfo.InvariantCulture) ?? "")">
                    <i class="bi bi-cash-coin"></i> Cobrar
                </button>
            }
            @if (puedeEditar)
            {
                <button type="button" class="btn btn-sm btn-outline-primary js-editar-cita"
                        data-cita-id="@Model.Id"
                        data-fecha="@Model.FechaHoraInput"
                        data-nombre="@(Model.NombreClienteRaw ?? Model.Cliente)"
                        data-telefono="@(Model.Telefono ?? "")"
                        data-cliente-id="@(Model.ClienteId?.ToString() ?? "")"
                        data-servicio-id="@(Model.ServicioId?.ToString() ?? "")"
                        data-servicio-personalizado="@(Model.ServicioPersonalizado ?? "")"
                        data-duracion="@(Model.DuracionMinutos?.ToString() ?? "")">
                    <i class="bi bi-pencil"></i> Editar
                </button>
            }
            @if (puedeCancelar)
            {
                <form method="post" action="/MiPortal/Calendario/CancelarCita" class="m-0"
                      onsubmit="return confirm('¿Cancelar esta cita? Esta acción no se puede deshacer.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="citaId" value="@Model.Id" />
                    <input type="hidden" name="fecha" value="@calFecha" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-x-lg"></i> Cancelar
                    </button>
                </form>
            }
        </div>
    }
</div>
