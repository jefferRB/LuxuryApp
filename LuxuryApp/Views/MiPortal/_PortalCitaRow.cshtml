@model LuxuryApp.Models.Funcionarios.PortalCitaItem
@using System.Globalization
@{
    var cr = new CultureInfo("es-CR");
    var esBloqueo = !string.Equals(Model.Tipo, "CITA", System.StringComparison.OrdinalIgnoreCase);
    var puedeCobrar = (ViewData["PuedeRegistrarCobros"] as bool?) ?? false;
}
<div style="display:flex;align-items:center;gap:.75rem;padding:.6rem .7rem;border:1px solid var(--lp-border);border-radius:.7rem;background:var(--lp-surface);">
    <div style="text-align:center;min-width:62px;">
        <div style="font-weight:800;font-size:.95rem;">@Model.FechaHora.ToString("hh:mm", cr)</div>
        <div class="lp-muted" style="font-size:.66rem;text-transform:uppercase;">@Model.FechaHora.ToString("tt", cr)</div>
    </div>
    <div style="width:1px;align-self:stretch;background:var(--lp-border);"></div>
    <div style="flex:1;min-width:0;">
        <div style="font-weight:700;font-size:.92rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
            @(esBloqueo ? Model.Servicio : Model.Cliente)
        </div>
        <div class="lp-muted" style="font-size:.8rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
            @if (esBloqueo)
            {
                <span><i class="bi bi-pause-circle"></i> Bloqueo de agenda</span>
            }
            else
            {
                <span><i class="bi bi-scissors"></i> @Model.Servicio</span>
                @if (Model.DuracionMinutos.HasValue)
                {
                    <span> · @Model.DuracionMinutos min</span>
                }
            }
        </div>
    </div>
    @if (!esBloqueo && Model.YaCobrada)
    {
        <span class="lp-muted" title="Cita cobrada" style="font-size:.72rem;font-weight:700;color:var(--lp-green);white-space:nowrap;">
            <i class="bi bi-check2-circle"></i> Cobrada
        </span>
    }
    else if (puedeCobrar && Model.EsCobrable)
    {
        <button type="button" class="lp-btn lp-btn--gold js-cobrar-btn"
                style="padding:.4rem .7rem;font-size:.78rem;white-space:nowrap;"
                data-cita-id="@Model.Id"
                data-cliente="@Model.Cliente"
                data-servicio="@Model.Servicio"
                data-precio="@(Model.PrecioServicio?.ToString("0.##", CultureInfo.InvariantCulture) ?? "")">
            <i class="bi bi-cash-coin"></i> Cobrar
        </button>
    }
    @if (!esBloqueo && !string.IsNullOrWhiteSpace(Model.Telefono))
    {
        <a href="tel:@Model.Telefono" class="lp-muted" title="Llamar" style="font-size:1.1rem;text-decoration:none;">
            <i class="bi bi-telephone"></i>
        </a>
    }
</div>
