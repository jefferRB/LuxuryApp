@using LuxuryApp.Models.Funcionarios
@model List<Puesto>

<div class="mb-3">
    <div id="puestosTokenContainer" class="d-none">
        @Html.AntiForgeryToken()
    </div>

    <div id="puestosMessageContainer"></div>

    <button class="btn btn-dark" onclick="mostrarFormularioPuesto()">
        ➕ Nuevo Puesto
    </button>

</div>

<div class="mt-3" id="formPuestoContainer"></div>

<table class="table table-striped mt-4">

    <thead>
        <tr>
            <th>Puesto</th>
            <th>Detalle</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombrePuesto</td>
                <td>@item.Detalle</td>

                <td>
                    @if (item.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </td>

                <td>
                    <button class="btn btn-sm btn-outline-dark"
                            onclick="mostrarFormularioPuesto(@item.IdPuesto)">
                        Editar
                    </button>

                    @if (item.Activo)
                    {
                        <button class="btn btn-sm btn-danger"
                                onclick="togglePuesto(@item.IdPuesto)">
                            Desactivar
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-success"
                                onclick="togglePuesto(@item.IdPuesto)">
                            Activar
                        </button>
                    }

                    <button class="btn btn-sm btn-outline-danger"
                            onclick="eliminarPuesto(@item.IdPuesto)">
                        Eliminar
                    </button>

                </td>
            </tr>
        }

    </tbody>

</table>
