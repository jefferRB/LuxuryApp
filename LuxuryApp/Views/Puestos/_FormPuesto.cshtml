@model LuxuryApp.Models.Funcionarios.Puesto

<form id="formPuesto">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdPuesto" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-2">
        <label class="form-label">Nombre del puesto</label>
        <input asp-for="NombrePuesto" class="form-control" />
        <span asp-validation-for="NombrePuesto" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label class="form-label">Detalle</label>
        <textarea asp-for="Detalle"
                  class="form-control"
                  rows="2"></textarea>
        <span asp-validation-for="Detalle" class="text-danger"></span>
    </div>

    <button type="button"
            class="btn btn-success"
            onclick="guardarPuesto()">
        @(Model.IdPuesto > 0 ? "Guardar Cambios" : "Guardar")
    </button>

</form>
