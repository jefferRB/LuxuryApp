@model LuxuryApp.Models.DataBase.ServicioRealizadoViewModel

@{
    ViewData["Title"] = "Registro de Servicios Realizados";
}

<div class="card border-0 shadow-lg">
    <div class="card-header bg-dark text-white py-3">
        <h5 class="m-0">
            <i class="fas fa-users me-2"></i>Registro de Servicios Realizados
        </h5>
    </div>

    <div class="card-body">
        <form asp-action="RegistrarServicios" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ClienteId" />
            <input type="hidden" asp-for="NumeroTelefono" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label class="form-label fw-bold">Cliente</label>
                <p class="form-control-plaintext mb-0">@Model.NombreCliente</p>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Telefono</label>
                <p class="form-control-plaintext mb-0">@Model.NumeroTelefono</p>
            </div>

            <div class="mt-4">
                <label asp-for="DescripcionServicios" class="form-label fw-bold">Descripcion del servicio realizado</label>
                <textarea asp-for="DescripcionServicios"
                          class="form-control"
                          rows="4"
                          placeholder="Ejemplo: Corte + Barba, hidratacion, limpieza..."></textarea>
                <span asp-validation-for="DescripcionServicios" class="text-danger"></span>
            </div>

            <div class="mt-4 d-flex gap-3">
                <button type="submit" class="btn btn-dark text-white">
                    <i class="fas fa-save me-1"></i>Guardar Registro
                </button>

                <a asp-action="Buscar" asp-route-criterio="@Model.NumeroTelefono" class="btn btn-secondary">
                    Volver
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
