@model LuxuryApp.Models.DataBase.BuscarClienteViewModel

<div class="card border-0 shadow-lg">
    <div class="card-header bg-dark text-white py-3">
        <h5 class="m-0">
            <i class="fas fa-search me-2"></i>Buscar Cliente por Numero de Telefono
        </h5>
    </div>

    <div class="card-body">
        <form asp-action="Buscar" method="post">
            <div class="mb-3">
                <label asp-for="Criterio" class="form-label">Telefono o Nombre</label>
                <input asp-for="Criterio"
                       class="form-control"
                       placeholder="Ejemplo: 88889999 o Juan Perez" />
            </div>

            <button type="submit" class="btn btn-dark text-white">
                <i class="fas fa-search me-1"></i>Buscar
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i>Volver al Listado
            </a>
        </form>

        <hr />

        @if (Model.ClientesEncontrados.Count > 1)
        {
            <div class="row mt-4">
                @foreach (var cliente in Model.ClientesEncontrados)
                {
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <i class="fas fa-user me-2"></i>@cliente.Nombre
                                </h5>

                                <p class="mb-1"><strong>Telefono:</strong> @cliente.NumeroTelefono</p>
                                <p class="mb-1"><strong>Correo:</strong> @(string.IsNullOrWhiteSpace(cliente.CorreoElectronico) ? "No registrado" : cliente.CorreoElectronico)</p>
                                <p class="mb-1">
                                    <strong>Ultima visita:</strong>
                                    @cliente.FechaUltimaVisita.ToShortDateString()
                                </p>

                                <form asp-action="Buscar" method="post" class="mt-3">
                                    <input type="hidden" name="criterio" value="@cliente.NumeroTelefono" />
                                    <button class="btn btn-dark btn-sm w-100">
                                        <i class="fas fa-eye me-1"></i>Ver detalle
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
        {
            <div class="alert @(Model.ResultadosLimitados ? "alert-info" : "alert-warning") mt-3">@Model.Mensaje</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["Mensaje"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model.ClienteSeleccionado != null)
        {
            <div class="card mt-4 border-5 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas fa-user me-2"></i>@Model.ClienteSeleccionado.Nombre
                    </h5>

                    <p class="mb-1"><strong>Telefono:</strong> @Model.ClienteSeleccionado.NumeroTelefono</p>
                    <p class="mb-1"><strong>Correo Electronico:</strong> @(string.IsNullOrWhiteSpace(Model.ClienteSeleccionado.CorreoElectronico) ? "No registrado" : Model.ClienteSeleccionado.CorreoElectronico)</p>
                    <p class="mb-1"><strong>Frecuencia de Visita:</strong> @Model.ClienteSeleccionado.FrecuenciaVisita dias</p>
                    <p class="mb-1"><strong>Fecha Ultima Visita:</strong> @Model.ClienteSeleccionado.FechaUltimaVisita.ToShortDateString()</p>

                    <p class="mb-1">
                        <strong>Fecha De Cumpleanos:</strong>
                        @(Model.ClienteSeleccionado.FechaCumpleanos.HasValue
                            ? Model.ClienteSeleccionado.FechaCumpleanos.Value.ToString("dd/MM/yyyy")
                            : "No registrado")
                    </p>

                    <p class="mb-1">
                        <strong>Proxima Cita:</strong>
                        @Model.ClienteSeleccionado.ProximaVisita.ToShortDateString()
                    </p>

                    <p><strong>Visitas Totales:</strong> @Model.TotalVisitas</p>

                    <div class="mt-3 d-flex flex-wrap gap-2 justify-content-between align-items-center">
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="Editar"
                               asp-route-id="@Model.ClienteSeleccionado.Id"
                               class="btn btn-dark text-white">
                                <i class="fas fa-edit me-1"></i>Editar Cliente
                            </a>

                            <button class="btn btn-outline-dark"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#listaVisitas">
                                <i class="fas fa-calendar-check me-1"></i>Citas (@Model.TotalVisitas)
                            </button>

                            @if (Model.HistorialPagos.Any())
                            {
                                <button class="btn btn-outline-dark"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#listaPagos">
                                    <i class="fas fa-receipt me-1"></i>Pagos (@Model.HistorialPagos.Count)
                                </button>
                            }

                            <button class="btn btn-outline-light"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#listaNotas">
                                <i class="fas fa-clipboard-list me-1 "></i>Notas de Servicios
                            </button>
                        </div>

                        <form asp-action="AgregarVisitaRapida" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.ClienteSeleccionado.Id" />
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-calendar-plus me-1"></i>Agregar visita
                            </button>
                        </form>
                    </div>

                                        <div class="collapse mt-4" id="listaVisitas">
                        <h6 class="fw-bold mb-2"><i class="fas fa-calendar-check me-1"></i>Historial de citas</h6>

                        @if (Model.HistorialVisitas.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Fecha</th>
                                            <th>Hora</th>
                                            <th>Servicio</th>
                                            <th>Funcionario</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cita in Model.HistorialVisitas)
                                        {
                                            <tr>
                                                <td>@cita.FechaHoraCita.ToString("dd/MM/yyyy")</td>
                                                <td>@cita.FechaHoraCita.ToString("HH:mm")</td>
                                                <td>@(cita.NombreServicio ?? "—")</td>
                                                <td>@(cita.NombreFuncionario ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">No hay citas registradas para este cliente.</div>
                        }
                    </div>

                                        @if (Model.HistorialPagos.Any())
                    {
                        <div class="collapse mt-4" id="listaPagos">
                            <h6 class="fw-bold mb-2"><i class="fas fa-receipt me-1"></i>Historial de pagos</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Fecha</th>
                                            <th>Tipo</th>
                                            <th>Detalle</th>
                                            <th>Funcionario</th>
                                            <th>Método</th>
                                            <th class="text-end">Monto</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var pago in Model.HistorialPagos)
                                        {
                                            <tr>
                                                <td>@pago.FechaCobro.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>
                                                    <span class="badge @(pago.EsServicio ? "bg-dark" : "bg-secondary")">
                                                        @(pago.EsServicio ? "Servicio" : "Producto")
                                                    </span>
                                                </td>
                                                <td>@(pago.Detalle ?? "—")</td>
                                                <td>@(pago.NombreFuncionario ?? "—")</td>
                                                <td>@pago.MetodoPago</td>
                                                <td class="text-end fw-semibold">₡ @pago.Monto.ToString("N0")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-dark">
                                        <tr>
                                            <td colspan="5" class="text-end fw-bold">Total</td>
                                            <td class="text-end fw-bold">₡ @Model.HistorialPagos.Sum(p => p.Monto).ToString("N0")</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    }

                    <div class="collapse mt-4" id="listaNotas">
                        <h6 class="fw-bold mb-2"><i class="fas fa-clipboard-list me-1"></i>Notas de Servicios</h6>

                        @if (!string.IsNullOrWhiteSpace(Model.NotasServicio))
                        {
                            <div class="border rounded p-3 bg-transparent text-white text-pre-wrap luxury-notes-display">
                                @Model.NotasServicio
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">No hay notas de servicios registradas.</div>
                        }

                        <div class="mt-2">
                            <a asp-action="RegistrarServicios"
                               asp-route-id="@Model.ClienteSeleccionado!.Id"
                               class="btn btn-sm btn-secondary">
                                <i class="fas fa-edit me-1"></i>Editar notas
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
