@model IEnumerable<LuxuryApp.Models.DataBase.ClientesModel>


<!-- Tarjeta de Clientes -->
<div class="card border-0 shadow-lg  ">
    <div class="card-header bg-dark text-white py-3">
        <h5 class="m-0">
            <i class="fas fa-users me-2 "></i>Clientes
        </h5>
    </div>


    <div class="d-flex justify-content-between mt-3 mx-3 mb-3">
 
        <a asp-action="Create" class="btn btn-dark text-white">
            <i class="fas fa-user-plus me-1"></i>Nuevo Cliente
        </a >
        <a asp-action="Buscar" class="btn btn-dark text-white">
            <i class="fas fa-search me-1"></i>Buscar Cliente
        </a>
        <button id="btnEnviar" class="btn btn-dark text-white">
            <i class="fas fa-search me-1"></i>Enviar mensajes
        </button>
    </div>
    <div class="mt-3 ms-3">
        <span style="font-size: 1.1rem; color: #212529;">
            <strong>Clientes registrados:</strong> @Model.Count()
        </span>
    </div>
    <p> </p>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr >
                        <th class="ps-4"><i class="fas fa-user me-1"></i> Nombre</th>
                        <th><i class="fas fa-envelope me-1"></i> Correo Electrónico</th>
                        <th><i class="fas fa-phone me-1"></i> Número Teléfono</th>
                        <th><i class="fas fa-chart-line me-1"></i> Frecuencia de Visita</th>
                        <th><i class="fas fa-calendar-day me-1"></i> Última Visita</th>
                        <th><i class="fas fa-calendar-check me-1"></i> Próxima Visita</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var cliente in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@cliente.Nombre</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(cliente.CorreoElectronico))
                                    {
                                        <a href="mailto:@cliente.CorreoElectronico" class="text-decoration-none">
                                            @cliente.CorreoElectronico
                                        </a>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(cliente.NumeroTelefono))
                                    {
                                        <form asp-action="Buscar" method="post" style="display:inline;">
                                            <input type="hidden" name="criterio" value="@cliente.NumeroTelefono" />
                                            <button type="submit" class="btn btn-link p-0 text-decoration-none">
                                                @cliente.NumeroTelefono
                                            </button>
                                        </form>
                                    }
                                </td>
                                <td>@cliente.FrecuenciaVisita</td>
                                <td>@cliente.FechaUltimaVisita.ToString("dd/MM/yyyy")</td>
                                <td>@cliente.ProximaVisita.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="fas fa-info-circle me-2"></i>No hay clientes registrados
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<script>
    document.getElementById("btnEnviar").addEventListener("click", async () => {

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        try {
            const response = await fetch('/Clientes/EnviarMensaje', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }
            });

            const data = await response.json();

            if (data.success) {
                alert(data.message);
            } else {
                alert("Ocurrió un error al enviar los mensajes.");
            }
        } catch (error) {
            console.error(error);
            alert("Error en la solicitud.");
        }
    });
</script>