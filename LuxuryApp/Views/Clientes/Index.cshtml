@model LuxuryApp.Models.DataBase.ClientesIndexViewModel

<div class="card border-0 shadow-lg">
    <div class="card-header bg-dark text-white py-3">
        <h5 class="m-0">
            <i class="fas fa-users me-2"></i>Clientes
        </h5>
    </div>

    <div class="d-flex justify-content-between mt-3 mx-3 mb-3">
        <a asp-action="Create" class="btn btn-dark text-white">
            <i class="fas fa-user-plus me-1"></i>Nuevo Cliente
        </a>
        <a asp-action="Buscar" class="btn btn-dark text-white">
            <i class="fas fa-search me-1"></i>Buscar Cliente
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success mx-3 mb-0">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mx-3 mb-0">
            @TempData["Error"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-3 mx-3">
        <span class="private-module-count">
            <strong>Clientes registrados:</strong> @Model.TotalCount
        </span>

        <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
            <input type="hidden" name="pageNumber" value="1" />
            <label for="pageSize" class="form-label mb-0 text-muted">Mostrar</label>
            <select id="pageSize" name="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                @foreach (var size in Model.PageSizeOptions)
                {
                    <option value="@size" selected="@(size == Model.PageSize ? "selected" : null)">@size</option>
                }
            </select>
        </form>
    </div>

    <p></p>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4"><i class="fas fa-user me-1"></i> Nombre</th>
                        <th><i class="fas fa-envelope me-1"></i> Correo Electronico</th>
                        <th><i class="fas fa-phone me-1"></i> Numero Telefono</th>
                        <th><i class="fas fa-chart-line me-1"></i> Frecuencia de Visita</th>
                        <th><i class="fas fa-calendar-day me-1"></i> Ultima Visita</th>
                        <th><i class="fas fa-calendar-check me-1"></i> Proxima Visita</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Clientes.Any())
                    {
                        foreach (var cliente in Model.Clientes)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@cliente.Nombre</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(cliente.CorreoElectronico))
                                    {
                                        <a href="mailto:@cliente.CorreoElectronico" class="text-decoration-none">
                                            @cliente.CorreoElectronico
                                        </a>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(cliente.NumeroTelefono))
                                    {
                                        <form asp-action="Buscar" method="post" style="display:inline;">
                                            <input type="hidden" name="criterio" value="@cliente.NumeroTelefono" />
                                            <button type="submit" class="btn btn-link p-0 text-decoration-none">
                                                @cliente.NumeroTelefono
                                            </button>
                                        </form>
                                    }
                                </td>
                                <td>@cliente.FrecuenciaVisita</td>
                                <td>@cliente.FechaUltimaVisita.ToString("dd/MM/yyyy")</td>
                                <td>@cliente.ProximaVisita.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="fas fa-info-circle me-2"></i>No hay clientes registrados
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center px-3 py-3 border-top">
        <span class="text-muted small">
            Mostrando @Model.StartItem-@Model.EndItem de @Model.TotalCount
        </span>

        <div class="btn-group btn-group-sm" role="group" aria-label="Paginacion de clientes">
            @if (Model.HasPreviousPage)
            {
                <a asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   class="btn btn-outline-dark">
                    Anterior
                </a>
            }
            else
            {
                <span class="btn btn-outline-secondary disabled">Anterior</span>
            }

            <span class="btn btn-outline-secondary disabled">
                Pagina @Model.PageNumber de @Model.TotalPages
            </span>
            </span>

            @if (Model.HasNextPage)
            {
                <a asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   class="btn btn-outline-dark">
                    Siguiente
                </a>
            }
            else
            {
                <span class="btn btn-outline-secondary disabled">Siguiente</span>
            }
        </div>
    </div>
</div>
