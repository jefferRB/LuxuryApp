@model LuxuryApp.Models.SaaS.BillingPlanesViewModel

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Precios";
    ViewData["PublicBodyClass"] = "public-pricing-page";

    var hasBaseAccess = Model.CurrentSubscription?.CanAccessApp == true || Model.CurrentAccess?.CanAccessApp == true;
}

<section class="pricing-hero-section">
    <div class="container">
        <div class="pricing-hero-card" data-aos="fade-up">
            <span class="section-kicker">Precios LuxuryCloud</span>
            <h1>Planes mensuales claros para operar con control y sin acceso permanente por un solo pago.</h1>
            <p>
                LuxuryCloud mantiene el tenant y la cuenta existente. El acceso comercial depende
                de una suscripcion mensual vigente y su periodo activo.
            </p>
        </div>
    </div>
</section>

@if (TempData["BillingError"] is string billingError)
{
    <div class="container">
        <div class="alert alert-danger billing-alert" role="alert">
            @billingError
        </div>
    </div>
}

@if (TempData["BillingSuccess"] is string billingSuccess)
{
    <div class="container">
        <div class="alert alert-success billing-alert" role="alert">
            @billingSuccess
        </div>
    </div>
}

<section class="pricing-grid-section">
    <div class="container">
        @if (Model.IsAuthenticated)
        {
            <div class="billing-state-banner" data-aos="fade-up">
                <div>
                    <span class="billing-state-kicker">Mi suscripcion</span>
                    @if (Model.CurrentSubscription is not null)
                    {
                        <h2>@(Model.CurrentSubscription.PlanName ?? "Suscripcion activa")</h2>
                        <p>
                            Estado actual: <strong>@Model.CurrentSubscription.StatusLabel</strong>.
                            @if (Model.CurrentSubscription.CurrentPeriodEndUtc.HasValue)
                            {
                                <span> Vigencia hasta <strong>@Model.CurrentSubscription.CurrentPeriodEndUtc.Value.ToString("dd/MM/yyyy")</strong>.</span>
                            }
                            @if (Model.CurrentSubscription.IsInGracePeriod && Model.CurrentSubscription.GracePeriodEndsUtc.HasValue)
                            {
                                <span> Periodo de gracia hasta <strong>@Model.CurrentSubscription.GracePeriodEndsUtc.Value.ToString("dd/MM/yyyy")</strong>.</span>
                            }
                        </p>
                    }
                    else if (Model.CurrentAccess?.CanAccessApp == true)
                    {
                        <h2>Tu cuenta tiene acceso comercial habilitado.</h2>
                        <p>
                            Fuente de acceso: <strong>@Model.CurrentAccess.AccessSource</strong>
                            @if (!string.IsNullOrWhiteSpace(Model.CurrentAccess.EffectivePlanName))
                            {
                                <span>. Plan efectivo: <strong>@Model.CurrentAccess.EffectivePlanName</strong>.</span>
                            }
                        </p>
                    }
                    else
                    {
                        <h2>Tu tenant ya existe. Solo falta activar o regularizar la suscripcion.</h2>
                        <p>La cuenta no pierde sus datos si un cobro falla; solo cambia su estado comercial y el acceso operativo.</p>
                    }
                </div>
            </div>

            @if (Model.CurrentSubscription is not null)
            {
                <div class="billing-code-card" data-aos="fade-up">
                    <div>
                        <span class="section-kicker">Resumen actual</span>
                        <h3>Informacion clave de tu suscripcion mensual.</h3>
                    </div>

                    <div class="row g-3">
                        <div class="col-lg-4">
                            <div class="trust-card h-100">
                                <i class="bi bi-credit-card-2-front"></i>
                                <h3>Plan y estado</h3>
                                <p>
                                    <strong>@(Model.CurrentSubscription.PlanName ?? "Sin plan base")</strong><br />
                                    Estado: @Model.CurrentSubscription.StatusLabel
                                </p>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="trust-card h-100">
                                <i class="bi bi-people"></i>
                                <h3>Funcionarios</h3>
                                <p>
                                    Usados: <strong>@Model.CurrentSubscription.ActiveFuncionarios</strong><br />
                                    Limite del plan: <strong>@(Model.CurrentSubscription.MaxFuncionarios?.ToString() ?? "Ilimitado")</strong>
                                </p>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="trust-card h-100">
                                <i class="bi bi-whatsapp"></i>
                                <h3>WhatsApp</h3>
                                @if (Model.CurrentSubscription.HasWhatsAppAddon)
                                {
                                    <p>
                                        <strong>@Model.CurrentSubscription.WhatsAppAddonName</strong><br />
                                        Estado: @Model.CurrentSubscription.WhatsAppAddonStatusLabel<br />
                                        Confirmaciones: <strong>@(Model.CurrentSubscription.SendAppointmentConfirmations ? "Activas" : "Inactivas")</strong><br />
                                        Recordatorios: <strong>@(Model.CurrentSubscription.SendAppointmentReminders ? "Activos" : "Inactivos")</strong>
                                    </p>
                                    <ul class="billing-metric-list">
                                        <li>Usados del mes: <strong>@Model.CurrentSubscription.WhatsAppMessagesUsed</strong> de <strong>@(Model.CurrentSubscription.WhatsAppMonthlyLimit ?? 0)</strong></li>
                                        <li>Restantes del mes: <strong>@(Model.CurrentSubscription.WhatsAppMessagesRemaining ?? 0)</strong></li>
                                        <li>Usados hoy: <strong>@Model.CurrentSubscription.WhatsAppTodayUsage</strong> de <strong>@(Model.CurrentSubscription.WhatsAppDailyLimit ?? 0)</strong></li>
                                    </ul>
                                    @if (Model.CurrentSubscription.WhatsAppNextBillingDateUtc.HasValue)
                                    {
                                        <p class="mb-0">Proxima renovacion: <strong>@Model.CurrentSubscription.WhatsAppNextBillingDateUtc.Value.ToString("dd/MM/yyyy")</strong></p>
                                    }
                                }
                                else
                                {
                                    <p>No tienes un add-on activo. Los recordatorios automaticos por WhatsApp requieren activar un paquete.</p>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <p class="mb-1">
                            Para cambiar tu plan, contacta a soporte.
                        </p>
                        @if (Model.CurrentSubscription.NextBillingDateUtc.HasValue)
                        {
                            <p class="mb-0">
                                Proxima fecha de cobro estimada: <strong>@Model.CurrentSubscription.NextBillingDateUtc.Value.ToString("dd/MM/yyyy")</strong>
                            </p>
                        }
                    </div>

                    @if (Model.CurrentSubscription.HasWhatsAppAddon)
                    {
                        var confHours = Model.CurrentSubscription.ConfirmationHoursBefore;
                        var remHours = Model.CurrentSubscription.ReminderHoursBefore;
                        var confHourOptions = new[] { 1, 2, 3, 6, 12, 24, 48 };
                        var remHourOptions = new[] { 1, 2, 3, 6, 12, 24 };
                        var confIsBatch = Model.CurrentSubscription.ConfirmationIsBatch;
                        var remIsBatch = Model.CurrentSubscription.ReminderIsBatch;
                        var confBatchTime = (Model.CurrentSubscription.ConfirmationBatchTime ?? new TimeOnly(19, 0)).ToString("HH:mm");
                        var remBatchTime = (Model.CurrentSubscription.ReminderBatchTime ?? new TimeOnly(7, 0)).ToString("HH:mm");
                        var confTarget = Model.CurrentSubscription.ConfirmationBatchTarget;
                        var remTarget = Model.CurrentSubscription.ReminderBatchTarget;
                        var morningStart = (Model.CurrentSubscription.ConfirmationMorningStart ?? new TimeOnly(4, 0)).ToString("HH:mm");
                        var morningEnd = (Model.CurrentSubscription.ConfirmationMorningEnd ?? new TimeOnly(12, 0)).ToString("HH:mm");
                        var quietEnabled = Model.CurrentSubscription.QuietHoursEnabled;
                        var quietStart = (Model.CurrentSubscription.QuietHoursStart ?? new TimeOnly(21, 0)).ToString("HH:mm");
                        var quietEnd = (Model.CurrentSubscription.QuietHoursEnd ?? new TimeOnly(7, 0)).ToString("HH:mm");
                        <form id="waAutomationForm" asp-action="UpdateWhatsAppAutomation" method="post" class="billing-whatsapp-settings">
                            @Html.AntiForgeryToken()
                            <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-3">
                                <div>
                                    <span class="section-kicker">Automatizaciones WhatsApp</span>
                                    <h3>Controla cuándo se envían confirmaciones y recordatorios.</h3>
                                    <p class="mb-0">
                                        Paquete activo: <strong>@Model.CurrentSubscription.WhatsAppAddonName</strong>.
                                        Automatizacion general: <strong>@(Model.CurrentSubscription.WhatsAppAutomationEnabled ? "Activa" : "Inactiva")</strong>.
                                    </p>
                                </div>
                                <div class="billing-inline-note">
                                    <strong>Saldo actual</strong><br />
                                    Mes: @(Model.CurrentSubscription.WhatsAppMessagesRemaining ?? 0) restante(s)<br />
                                    Hoy: @(Math.Max((Model.CurrentSubscription.WhatsAppDailyLimit ?? 0) - Model.CurrentSubscription.WhatsAppTodayUsage, 0)) disponible(s)
                                </div>
                            </div>

                            <div class="row g-3">
                                @* ── Confirmaciones ── *@
                                <div class="col-lg-6">
                                    <div class="billing-toggle-panel billing-toggle-panel--stacked">
                                        <div class="billing-toggle-head">
                                            <div>
                                                <h4>Confirmaciones automaticas</h4>
                                                <p>Pide al cliente confirmar su cita con anticipación.</p>
                                            </div>
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input wa-master-toggle" type="checkbox"
                                                       id="confirmationsEnabled" name="ConfirmationsEnabled" value="true"
                                                       data-target="confirmationAdvanced"
                                                       @(Model.CurrentSubscription.SendAppointmentConfirmations ? "checked" : null) />
                                                <input type="hidden" name="ConfirmationsEnabled" value="false" />
                                            </div>
                                        </div>

                                        <div class="wa-advanced @(Model.CurrentSubscription.SendAppointmentConfirmations ? "" : "wa-advanced--disabled")" id="confirmationAdvanced">
                                            <label class="wa-field-label" for="ConfirmationMode">¿Cuándo enviar confirmaciones?</label>
                                            <select class="form-select wa-field wa-mode-select" id="ConfirmationMode" name="ConfirmationMode" data-prefix="conf">
                                                <option value="relative" selected="@(!confIsBatch)">Antes de la cita (horas configurables)</option>
                                                <option value="batch" selected="@confIsBatch">Todos los días a una hora fija</option>
                                            </select>

                                            <div class="wa-mode-panel mt-2 @(confIsBatch ? "d-none" : "")" data-mode="conf-relative">
                                                <label class="wa-field-label" for="ConfirmationHoursBefore">Anticipación</label>
                                                <select class="form-select wa-field" id="ConfirmationHoursBefore" name="ConfirmationHoursBefore">
                                                    @foreach (var h in confHourOptions)
                                                    {
                                                        <option value="@h" selected="@(h == confHours)">@h horas antes de la cita@(h == 24 ? " (recomendado)" : "")</option>
                                                    }
                                                </select>
                                                <div class="form-check mt-2">
                                                    <input class="form-check-input" type="checkbox"
                                                           id="SendConfirmationImmediatelyIfInsideWindow" name="SendConfirmationImmediatelyIfInsideWindow" value="true"
                                                           @(Model.CurrentSubscription.SendConfirmationImmediatelyIfInsideWindow ? "checked" : null) />
                                                    <input type="hidden" name="SendConfirmationImmediatelyIfInsideWindow" value="false" />
                                                    <label class="form-check-label" for="SendConfirmationImmediatelyIfInsideWindow">
                                                        Enviar inmediatamente si la cita ya está dentro del rango
                                                    </label>
                                                </div>
                                            </div>

                                            <div class="wa-mode-panel mt-2 @(confIsBatch ? "" : "d-none")" data-mode="conf-batch">
                                                <label class="wa-field-label" for="ConfirmationBatchTime">Hora de envío</label>
                                                <input type="time" class="form-control wa-field" id="ConfirmationBatchTime" name="ConfirmationBatchTime" value="@confBatchTime" />
                                                <label class="wa-field-label mt-2" for="ConfirmationBatchTarget">¿Para cuáles citas?</label>
                                                <select class="form-select wa-field wa-target-select" id="ConfirmationBatchTarget" name="ConfirmationBatchTarget" data-prefix="conf">
                                                    <option value="TomorrowAllDay" selected="@(confTarget == "TomorrowAllDay")">Citas de mañana</option>
                                                    <option value="TomorrowMorning" selected="@(confTarget == "TomorrowMorning")">Solo citas de la mañana siguiente</option>
                                                    <option value="SameDayRemaining" selected="@(confTarget == "SameDayRemaining")">Citas restantes de hoy</option>
                                                    <option value="Next24Hours" selected="@(confTarget == "Next24Hours")">Próximas 24 horas</option>
                                                </select>
                                                <div class="wa-morning-window mt-2 @(confTarget == "TomorrowMorning" ? "" : "d-none")" data-prefix="conf">
                                                    <div class="row g-2">
                                                        <div class="col-6">
                                                            <label class="wa-field-label" for="ConfirmationMorningStart">Desde</label>
                                                            <input type="time" class="form-control wa-field" id="ConfirmationMorningStart" name="ConfirmationMorningStart" value="@morningStart" />
                                                        </div>
                                                        <div class="col-6">
                                                            <label class="wa-field-label" for="ConfirmationMorningEnd">Hasta</label>
                                                            <input type="time" class="form-control wa-field" id="ConfirmationMorningEnd" name="ConfirmationMorningEnd" value="@morningEnd" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <p class="wa-help-text mt-2">Útil si quieres confirmar por la noche las citas del día siguiente.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @* ── Recordatorios ── *@
                                <div class="col-lg-6">
                                    <div class="billing-toggle-panel billing-toggle-panel--stacked">
                                        <div class="billing-toggle-head">
                                            <div>
                                                <h4>Recordatorios automaticos</h4>
                                                <p>Avisa al cliente cerca de su cita.</p>
                                            </div>
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input wa-master-toggle" type="checkbox"
                                                       id="remindersEnabled" name="RemindersEnabled" value="true"
                                                       data-target="reminderAdvanced"
                                                       @(Model.CurrentSubscription.SendAppointmentReminders ? "checked" : null) />
                                                <input type="hidden" name="RemindersEnabled" value="false" />
                                            </div>
                                        </div>

                                        <div class="wa-advanced @(Model.CurrentSubscription.SendAppointmentReminders ? "" : "wa-advanced--disabled")" id="reminderAdvanced">
                                            <label class="wa-field-label" for="ReminderMode">¿Cuándo enviar recordatorios?</label>
                                            <select class="form-select wa-field wa-mode-select" id="ReminderMode" name="ReminderMode" data-prefix="rem">
                                                <option value="relative" selected="@(!remIsBatch)">Antes de la cita (horas configurables)</option>
                                                <option value="batch" selected="@remIsBatch">A una hora fija el mismo día</option>
                                            </select>

                                            <div class="wa-mode-panel mt-2 @(remIsBatch ? "d-none" : "")" data-mode="rem-relative">
                                                <label class="wa-field-label" for="ReminderHoursBefore">Anticipación</label>
                                                <select class="form-select wa-field" id="ReminderHoursBefore" name="ReminderHoursBefore">
                                                    @foreach (var h in remHourOptions)
                                                    {
                                                        <option value="@h" selected="@(h == remHours)">@h horas antes de la cita@(h == 3 ? " (recomendado)" : "")</option>
                                                    }
                                                </select>
                                                <div class="form-check mt-2">
                                                    <input class="form-check-input" type="checkbox"
                                                           id="SendReminderImmediatelyIfInsideWindow" name="SendReminderImmediatelyIfInsideWindow" value="true"
                                                           @(Model.CurrentSubscription.SendReminderImmediatelyIfInsideWindow ? "checked" : null) />
                                                    <input type="hidden" name="SendReminderImmediatelyIfInsideWindow" value="false" />
                                                    <label class="form-check-label" for="SendReminderImmediatelyIfInsideWindow">
                                                        Enviar inmediatamente si la cita ya está dentro del rango
                                                    </label>
                                                </div>
                                            </div>

                                            <div class="wa-mode-panel mt-2 @(remIsBatch ? "" : "d-none")" data-mode="rem-batch">
                                                <label class="wa-field-label" for="ReminderBatchTime">Hora de envío</label>
                                                <input type="time" class="form-control wa-field" id="ReminderBatchTime" name="ReminderBatchTime" value="@remBatchTime" />
                                                <label class="wa-field-label mt-2" for="ReminderBatchTarget">¿Para cuáles citas?</label>
                                                <select class="form-select wa-field" id="ReminderBatchTarget" name="ReminderBatchTarget">
                                                    <option value="SameDayRemaining" selected="@(remTarget == "SameDayRemaining")">Citas restantes de hoy</option>
                                                    <option value="NextAppointmentsToday" selected="@(remTarget == "NextAppointmentsToday")">Próximas citas de hoy</option>
                                                    <option value="NextXHours" selected="@(remTarget == "NextXHours")">Próximas horas</option>
                                                </select>
                                                <p class="wa-help-text mt-2">Los recordatorios se usan para avisar al cliente cerca de su cita.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @* ── Horas de silencio ── *@
                                <div class="col-12">
                                    <div class="billing-toggle-panel billing-toggle-panel--stacked">
                                        <div class="billing-toggle-head">
                                            <div>
                                                <h4>Horas de silencio</h4>
                                                <p>No se enviarán mensajes en este rango; quedan en espera y salen al terminar.</p>
                                            </div>
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input wa-master-toggle" type="checkbox"
                                                       id="quietHoursEnabled" name="QuietHoursEnabled" value="true"
                                                       data-target="quietAdvanced"
                                                       @(quietEnabled ? "checked" : null) />
                                                <input type="hidden" name="QuietHoursEnabled" value="false" />
                                            </div>
                                        </div>

                                        <div class="wa-advanced @(quietEnabled ? "" : "wa-advanced--disabled")" id="quietAdvanced">
                                            <div class="row g-2">
                                                <div class="col-6 col-sm-4 col-lg-3">
                                                    <label class="wa-field-label" for="QuietHoursStart">Desde</label>
                                                    <input type="time" class="form-control wa-field" id="QuietHoursStart" name="QuietHoursStart" value="@quietStart" />
                                                </div>
                                                <div class="col-6 col-sm-4 col-lg-3">
                                                    <label class="wa-field-label" for="QuietHoursEnd">Hasta</label>
                                                    <input type="time" class="form-control wa-field" id="QuietHoursEnd" name="QuietHoursEnd" value="@quietEnd" />
                                                </div>
                                            </div>
                                            <p class="wa-help-text mt-2">Ejemplo: de 9:00 p. m. a 7:00 a. m. para no escribir de noche.</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 d-flex flex-column flex-sm-row justify-content-end align-items-stretch align-items-sm-center gap-2">
                                    <span class="wa-automation-status" id="waAutomationStatus" role="status" aria-live="polite"></span>
                                    <button type="submit" class="btn public-btn public-btn-secondary" id="waAutomationSave">Guardar automatizaciones</button>
                                </div>
                            </div>
                        </form>
                    }
                </div>
            }

            <div class="billing-code-card" data-aos="fade-up">
                <div>
                    <span class="section-kicker">Codigo promocional</span>
                    <h3>Activa acceso temporal sin tarjeta si recibiste un codigo oficial.</h3>
                </div>

                <form asp-action="AplicarCodigoPromocional" method="post" class="row g-3 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-lg-8">
                        <label for="accessCode" class="form-label">Codigo de acceso</label>
                        <input id="accessCode" name="accessCode" class="form-control public-form-control" maxlength="100" />
                    </div>
                    <div class="col-lg-4">
                        <button type="submit" class="btn public-btn public-btn-secondary w-100">Aplicar codigo</button>
                    </div>
                </form>
            </div>
        }
        else
        {
            <div class="billing-state-banner" data-aos="fade-up">
                <div>
                    <span class="billing-state-kicker">Sin registro obligatorio</span>
                    <h2>Explora los planes primero. El registro y el tenant actual se conservan como flujo separado.</h2>
                    <p>
                        Despues del registro continuas con la activacion comercial y el acceso queda atado a la vigencia mensual,
                        no a un pago unico permanente.
                    </p>
                </div>
            </div>
        }

        @if (!Model.BasePlanCards.Any())
        {
            <div class="status-card" data-aos="fade-up">
                <span class="status-kicker">Planes no disponibles</span>
                <h2>No hay planes base activos configurados en este entorno.</h2>
                <p>Cuando exista al menos un plan comercial activo, esta vista lo mostrara automaticamente.</p>
            </div>
        }
        else
        {
            <div class="section-heading text-center" data-aos="fade-up">
                <span class="section-kicker">Planes base</span>
                <h2>Básico, Pro y Business con cobro mensual.</h2>
                <p>Para más de 7 funcionarios, contáctanos para un plan personalizado.</p>
            </div>

            <div class="row g-4 justify-content-center">
                @foreach (var plan in Model.BasePlanCards)
                {
                    var isCurrentPlan = Model.CurrentAccess?.EffectivePlanId == plan.Id;
                    var isSelected = Model.SelectedPlanId == plan.Id;
                    var planReturnUrl = Url.Action("Planes", "Billing", new { selectedPlanId = plan.Id }) ?? "/Billing/Planes";

                    <div class="col-xl-4 col-md-6" data-aos="fade-up">
                        <article class="pricing-card @(plan.IsFeatured ? "pricing-card-featured" : string.Empty) @(isCurrentPlan ? "pricing-card-current" : string.Empty) @(isSelected ? "pricing-card-selected" : string.Empty)" data-selected-plan="@(isSelected ? "true" : "false")">
                            <div class="pricing-card-top">
                                @if (!string.IsNullOrWhiteSpace(plan.BadgeText))
                                {
                                    <span class="pricing-badge">@plan.BadgeText</span>
                                }
                                else if (isCurrentPlan)
                                {
                                    <span class="pricing-badge pricing-badge-muted">Plan actual</span>
                                }

                                <h3>@plan.Name</h3>
                                <p>@plan.Summary</p>
                            </div>

                            <div class="pricing-amount">
                                <strong>@plan.CurrencyCode @plan.MonthlyPrice.ToString("N0")</strong>
                                <span>@plan.BillingLabel</span>
                            </div>

                            <div class="pricing-meta">
                                <span>@plan.StaffLabel</span>
                            </div>

                            <ul class="pricing-highlight-list">
                                @foreach (var highlight in plan.Highlights)
                                {
                                    <li>@highlight</li>
                                }
                            </ul>

                            @if (!plan.CanStartCheckout && !string.IsNullOrWhiteSpace(plan.CheckoutAvailabilityMessage))
                            {
                                <p class="pricing-login-link text-danger mb-3">@plan.CheckoutAvailabilityMessage</p>
                            }

                            @if (Model.IsAuthenticated)
                            {
                                if (isCurrentPlan)
                                {
                                    <button type="button" class="btn public-btn public-btn-secondary w-100" disabled>Plan actual</button>
                                }
                                else if (!plan.CanStartCheckout)
                                {
                                    <button type="button" class="btn public-btn public-btn-secondary w-100" disabled>Configuracion pendiente</button>
                                }
                                else
                                {
                                    <form asp-action="Checkout" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="planId" value="@plan.Id" />
                                        <button class="btn public-btn @(plan.IsFeatured ? "public-btn-primary" : "public-btn-secondary") w-100">
                                            @(hasBaseAccess ? "Cambiar a este plan" : "Activar este plan")
                                        </button>
                                    </form>
                                }
                            }
                            else
                            {
                                if (plan.CanStartCheckout)
                                {
                                    <a class="btn public-btn @(plan.IsFeatured ? "public-btn-primary" : "public-btn-secondary") w-100" asp-controller="Accounts" asp-action="Registro" asp-route-selectedPlanId="@plan.Id" asp-route-returnurl="@planReturnUrl">
                                        Crear cuenta y continuar
                                    </a>
                                    <a class="pricing-login-link" asp-controller="Accounts" asp-action="Acceso" asp-route-returnurl="@planReturnUrl">
                                        Ya tengo cuenta
                                    </a>
                                }
                                else
                                {
                                    <button type="button" class="btn public-btn @(plan.IsFeatured ? "public-btn-primary" : "public-btn-secondary") w-100" disabled>Configuracion pendiente</button>
                                }
                            }
                        </article>
                    </div>
                }
            </div>
        }

        @if (Model.WhatsAppAddonCards.Any())
        {
            <div class="section-heading text-center mt-5" data-aos="fade-up">
                <span class="section-kicker">WhatsApp add-on</span>
                <h2>Agrega recordatorios y confirmaciones automáticas por WhatsApp desde ₡6.000 al mes.</h2>
                <p>Los paquetes de WhatsApp se contratan por separado del plan base y se consumen por periodo mensual.</p>
            </div>

            <div class="row g-4 justify-content-center">
                @foreach (var plan in Model.WhatsAppAddonCards)
                {
                    var isCurrentAddon = string.Equals(
                        Model.CurrentSubscription?.WhatsAppAddonCode,
                        plan.Code,
                        StringComparison.OrdinalIgnoreCase);
                    var isSelected = Model.SelectedPlanId == plan.Id;
                    var planReturnUrl = Url.Action("Planes", "Billing", new { selectedPlanId = plan.Id }) ?? "/Billing/Planes";

                    <div class="col-xl-4 col-md-6" data-aos="fade-up">
                        <article class="pricing-card @(isCurrentAddon ? "pricing-card-current" : string.Empty) @(isSelected ? "pricing-card-selected" : string.Empty)" data-selected-plan="@(isSelected ? "true" : "false")">
                            <div class="pricing-card-top">
                                <span class="pricing-badge">@(!string.IsNullOrWhiteSpace(plan.BadgeText) ? plan.BadgeText : "Add-on")</span>
                                <h3>@plan.Name</h3>
                                <p>@plan.Summary</p>
                            </div>

                            <div class="pricing-amount">
                                <strong>@plan.CurrencyCode @plan.MonthlyPrice.ToString("N0")</strong>
                                <span>@plan.BillingLabel</span>
                            </div>

                            <div class="pricing-meta">
                                <span>@plan.StaffLabel</span>
                            </div>

                            <ul class="pricing-highlight-list">
                                @foreach (var highlight in plan.Highlights)
                                {
                                    <li>@highlight</li>
                                }
                            </ul>

                            @if (!plan.CanStartCheckout && !string.IsNullOrWhiteSpace(plan.CheckoutAvailabilityMessage))
                            {
                                <p class="pricing-login-link text-danger mb-3">@plan.CheckoutAvailabilityMessage</p>
                            }

                            @if (Model.IsAuthenticated)
                            {
                                if (isCurrentAddon)
                                {
                                    <button type="button" class="btn public-btn public-btn-secondary w-100" disabled>Paquete actual</button>
                                }
                                else if (!hasBaseAccess)
                                {
                                    <button type="button" class="btn public-btn public-btn-secondary w-100" disabled>Activa un plan base primero</button>
                                }
                                else if (!plan.CanStartCheckout)
                                {
                                    <button type="button" class="btn public-btn public-btn-secondary w-100" disabled>Configuracion pendiente</button>
                                }
                                else
                                {
                                    <a class="btn public-btn public-btn-secondary w-100"
                                       asp-action="ContinuarCheckout"
                                       asp-route-planId="@plan.Id">
                                        @(Model.CurrentSubscription?.HasWhatsAppAddon == true ? "Cambiar add-on" : "Activar add-on")
                                    </a>
                                }
                            }
                            else
                            {
                                if (plan.CanStartCheckout)
                                {
                                    <a class="btn public-btn public-btn-secondary w-100" asp-controller="Accounts" asp-action="Registro" asp-route-returnurl="@planReturnUrl">
                                        Crear cuenta para activarlo
                                    </a>
                                }
                                else
                                {
                                    <button type="button" class="btn public-btn public-btn-secondary w-100" disabled>Configuracion pendiente</button>
                                }
                            }
                        </article>
                    </div>
                }
            </div>
        }

        @if (Model.InternalPlanCards.Any())
        {
            <div class="section-heading text-center mt-5" data-aos="fade-up">
                <span class="section-kicker">Validacion interna</span>
                <h2>Plan TEST recurrente para validar el webhook y la activacion mensual.</h2>
                <p>Este bloque no debe exponerse publicamente. Utilizalo solo para pruebas internas controladas.</p>
            </div>

            <div class="row g-4 justify-content-center">
                @foreach (var plan in Model.InternalPlanCards)
                {
                    var isSelected = Model.SelectedPlanId == plan.Id;

                    <div class="col-xl-4 col-md-6" data-aos="fade-up">
                        <article class="pricing-card pricing-card-selected @(isSelected ? "pricing-card-current" : string.Empty)">
                            <div class="pricing-card-top">
                                <span class="pricing-badge">@plan.BadgeText</span>
                                <h3>@plan.Name</h3>
                                <p>@plan.Summary</p>
                            </div>

                            <div class="pricing-amount">
                                <strong>@plan.CurrencyCode @plan.MonthlyPrice.ToString("N0")</strong>
                                <span>@plan.BillingLabel</span>
                            </div>

                            <ul class="pricing-highlight-list">
                                @foreach (var highlight in plan.Highlights)
                                {
                                    <li>@highlight</li>
                                }
                            </ul>

                            @if (!plan.CanStartCheckout && !string.IsNullOrWhiteSpace(plan.CheckoutAvailabilityMessage))
                            {
                                <p class="pricing-login-link text-danger mb-3">@plan.CheckoutAvailabilityMessage</p>
                            }

                            @if (Model.IsAuthenticated)
                            {
                                if (plan.CanStartCheckout)
                                {
                                    <form asp-action="Checkout" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="planId" value="@plan.Id" />
                                        <button class="btn public-btn public-btn-secondary w-100">Probar plan TEST</button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn public-btn public-btn-secondary w-100" disabled>Configuracion pendiente</button>
                                }
                            }
                            else
                            {
                                var internalPlanReturnUrl = Url.Action("Planes", "Billing", new { selectedPlanId = plan.Id }) ?? "/Billing/Planes";
                                if (plan.CanStartCheckout)
                                {
                                    <a class="btn public-btn public-btn-secondary w-100" asp-controller="Accounts" asp-action="Registro" asp-route-selectedPlanId="@plan.Id" asp-route-returnurl="@internalPlanReturnUrl">
                                        Crear cuenta y continuar
                                    </a>
                                }
                                else
                                {
                                    <button type="button" class="btn public-btn public-btn-secondary w-100" disabled>Configuracion pendiente</button>
                                }
                            }
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>

<section class="pricing-trust-section">
    <div class="container">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-4" data-aos="fade-up">
                <div class="trust-card">
