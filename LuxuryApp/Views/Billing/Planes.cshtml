@model LuxuryApp.Models.SaaS.BillingPlanesViewModel

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Precios";
    ViewData["PublicBodyClass"] = "public-pricing-page";
}

<section class="pricing-hero-section">
    <div class="container">
        <div class="pricing-hero-card" data-aos="fade-up">
            <span class="section-kicker">Precios LuxuryCloud</span>
            <h1>Planes claros para activar la operacion de tu negocio sin friccion.</h1>
            <p>
                Revisa precios antes de registrarte. Si aun no tienes cuenta, te llevamos al registro y luego continuas
                con el flujo actual de tenant y suscripcion que ya existe en la plataforma.
            </p>
        </div>
    </div>
</section>

@if (TempData["BillingError"] is string billingError)
{
    <div class="container">
        <div class="alert alert-danger billing-alert" role="alert">
            @billingError
        </div>
    </div>
}

@if (TempData["BillingSuccess"] is string billingSuccess)
{
    <div class="container">
        <div class="alert alert-success billing-alert" role="alert">
            @billingSuccess
        </div>
    </div>
}

<section class="pricing-grid-section">
    <div class="container">
        @if (Model.IsAuthenticated)
        {
            <div class="billing-state-banner" data-aos="fade-up">
                @if (Model.CurrentAccess?.CanAccessApp == true)
                {
                    <div>
                        <span class="billing-state-kicker">Acceso activo</span>
                        <h2>Tu cuenta ya tiene acceso comercial habilitado.</h2>
                        <p>
                            Fuente de acceso: <strong>@Model.CurrentAccess.AccessSource</strong>
                            @if (!string.IsNullOrWhiteSpace(Model.CurrentAccess.EffectivePlanName))
                            {
                                <span>. Plan efectivo: <strong>@Model.CurrentAccess.EffectivePlanName</strong>.</span>
                            }
                        </p>
                    </div>
                }
                else
                {
                    <div>
                        <span class="billing-state-kicker">Activacion pendiente</span>
                        <h2>Tu tenant ya existe. Solo falta elegir y activar el plan.</h2>
                        <p>Una vez confirmado el checkout, el acceso a los modulos privados vuelve a quedar habilitado segun la misma logica actual.</p>
                    </div>
                }
            </div>

            <div class="billing-code-card" data-aos="fade-up">
                <div>
                    <span class="section-kicker">Codigo promocional</span>
                    <h3>Activa acceso temporal sin tarjeta si recibiste un codigo oficial.</h3>
                </div>

                <form asp-action="AplicarCodigoPromocional" method="post" class="row g-3 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-lg-8">
                        <label for="accessCode" class="form-label">Codigo de acceso</label>
                        <input id="accessCode" name="accessCode" class="form-control public-form-control" maxlength="100" />
                    </div>
                    <div class="col-lg-4">
                        <button type="submit" class="btn public-btn public-btn-secondary w-100">Aplicar codigo</button>
                    </div>
                </form>
            </div>
        }
        else
        {
            <div class="billing-state-banner" data-aos="fade-up">
                <div>
                    <span class="billing-state-kicker">Sin registro obligatorio</span>
                    <h2>Explora los planes primero. Te llevamos al registro solo cuando decidas continuar.</h2>
                    <p>
                        Esa etapa previa es publica. Despues del registro el sistema conserva tu flujo actual:
                        tenant creado, TenantId listo y suscripcion amarrada al proceso existente.
                    </p>
                </div>
            </div>
        }

        @if (!Model.PlanCards.Any())
        {
            <div class="status-card" data-aos="fade-up">
                <span class="status-kicker">Planes no disponibles</span>
                <h2>No hay planes activos configurados en este entorno.</h2>
                <p>Cuando exista al menos un plan comercial activo, esta vista lo mostrara automaticamente.</p>
            </div>
        }
        else
        {
            <div class="row g-4 justify-content-center">
                @foreach (var plan in Model.PlanCards)
                {
                    var isCurrentPlan = Model.CurrentAccess?.CanAccessApp == true && Model.CurrentAccess.EffectivePlanId == plan.Id;
                    var isSelected = Model.SelectedPlanId == plan.Id;
                    var planReturnUrl = Url.Action("Planes", "Billing", new { selectedPlanId = plan.Id }) ?? "/Billing/Planes";

                    <div class="col-xl-4 col-md-6" data-aos="fade-up">
                        <article class="pricing-card @(plan.IsFeatured ? "pricing-card-featured" : string.Empty) @(isCurrentPlan ? "pricing-card-current" : string.Empty) @(isSelected ? "pricing-card-selected" : string.Empty)" data-selected-plan="@(isSelected ? "true" : "false")">
                            <div class="pricing-card-top">
                                @if (!string.IsNullOrWhiteSpace(plan.BadgeText))
                                {
                                    <span class="pricing-badge">@plan.BadgeText</span>
                                }
                                else if (isCurrentPlan)
                                {
                                    <span class="pricing-badge pricing-badge-muted">Plan actual</span>
                                }
                                else if (isSelected)
                                {
                                    <span class="pricing-badge pricing-badge-muted">Seleccionado</span>
                                }

                                <h3>@plan.Name</h3>
                                <p>@plan.Summary</p>
                            </div>

                            <div class="pricing-amount">
                                <strong>@plan.CurrencyCode @plan.MonthlyPrice.ToString("N0")</strong>
                                <span>@plan.BillingLabel</span>
                            </div>

                            <div class="pricing-meta">
                                <span>@plan.StaffLabel</span>
                                @if (plan.IsValidationPlan)
                                {
                                    <span>Checkout controlado para validacion</span>
                                }
                            </div>

                            <ul class="pricing-highlight-list">
                                @foreach (var highlight in plan.Highlights)
                                {
                                    <li>@highlight</li>
                                }
                            </ul>

                            @if (Model.IsAuthenticated)
                            {
                                if (isCurrentPlan)
                                {
                                    <button type="button" class="btn public-btn public-btn-secondary w-100" disabled>Plan actual</button>
                                }
                                else
                                {
                                    <form asp-action="Checkout" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="planId" value="@plan.Id" />
                                        <button class="btn public-btn @(plan.IsFeatured ? "public-btn-primary" : "public-btn-secondary") w-100">
                                            @(Model.CurrentAccess?.CanAccessApp == true ? "Cambiar a este plan" : "Activar este plan")
                                        </button>
                                    </form>
                                }
                            }
                            else
                            {
                                <a class="btn public-btn @(plan.IsFeatured ? "public-btn-primary" : "public-btn-secondary") w-100" asp-controller="Accounts" asp-action="Registro" asp-route-selectedPlanId="@plan.Id" asp-route-returnurl="@planReturnUrl">
                                    Crear cuenta y continuar
                                </a>
                                <a class="pricing-login-link" asp-controller="Accounts" asp-action="Acceso" asp-route-returnurl="@planReturnUrl">
                                    Ya tengo cuenta
                                </a>
                            }
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>

<section class="pricing-trust-section">
    <div class="container">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-4" data-aos="fade-up">
                <div class="trust-card">
                    <i class="bi bi-shield-lock"></i>
                    <h3>Flujo seguro</h3>
                    <p>El registro crea el tenant y el proceso de suscripcion sigue usando la misma logica ya integrada en la aplicacion.</p>
                </div>
            </div>
            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="80">
                <div class="trust-card">
                    <i class="bi bi-window-stack"></i>
                    <h3>Experiencia comercial separada</h3>
                    <p>La web publica y el SaaS interno quedan desacoplados visualmente para no mezclar onboarding con operacion.</p>
                </div>
            </div>
            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="160">
                <div class="trust-card">
                    <i class="bi bi-lightning-charge"></i>
                    <h3>Activacion clara</h3>
                    <p>El usuario entiende que puede ver precios antes del registro y luego continuar al checkout sin perder contexto.</p>
                </div>
            </div>
        </div>
    </div>
</section>
