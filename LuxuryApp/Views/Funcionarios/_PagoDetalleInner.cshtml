@model LuxuryApp.Models.Funcionarios.PagoFuncionarioVM

@*
    Contenido interno del detalle de un funcionario (producción por día,
    productos vendidos, historial de pagos). Se reutiliza tanto en la fila
    colapsable de la tabla desktop como en la card colapsable de mobile,
    para no duplicar markup ni lógica. El wrapper .collapse y su id los
    define cada contexto (tabla / card).
*@

<div class="func-pagos-detail-inner">

    <!-- Producción por día -->
    @if (Model.DetalleDias.Any())
    {
        <div class="func-pagos-detail-title">
            <i class="bi bi-calendar-week"></i>
            Producción por día
        </div>
        <div class="func-day-cards">
            @foreach (var d in Model.DetalleDias)
            {
                <div class="func-day-card">
                    <span class="func-day-name">@d.Dia</span>
                    <span class="func-day-count">@d.CantidadServicios</span>
                    <span class="func-day-amount">₡ @d.Monto.ToString("N0")</span>
                </div>
            }
        </div>
    }

    <!-- Productos vendidos -->
    @if (Model.ProductosVendidos.Any())
    {
        <div class="func-pagos-detail-title" style="margin-top:0.25rem;">
            <i class="bi bi-box-seam"></i>
            Productos vendidos
        </div>
        <div class="func-pagos-subtable-wrap">
            <table class="func-pagos-subtable">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Producto</th>
                        <th>Precio</th>
                        <th>Ganancia funcionario</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.ProductosVendidos)
                    {
                        <tr>
                            <td class="func-date">@p.Fecha.ToString("dd MMM yyyy")</td>
                            <td>@p.NombreProducto</td>
                            <td style="font-weight:600;">₡ @p.Precio.ToString("N0")</td>
                            <td class="func-amount--green">₡ @p.GananciaFuncionario.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Historial de pagos -->
    <div class="func-pagos-detail-title" style="margin-top:@(Model.ProductosVendidos.Any() ? "1.25rem" : "0.25rem");">
        <i class="bi bi-receipt"></i>
        Historial de pagos esta semana
    </div>
    @if (Model.HistorialPagos.Any())
    {
        <div class="func-pagos-subtable-wrap">
            <table class="func-pagos-subtable">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Monto</th>
                        <th>Observación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.HistorialPagos)
                    {
                        <tr>
                            <td class="func-date">@p.FechaPago.ToString("dd MMM yyyy HH:mm")</td>
                            <td class="func-amount--green">₡ @p.MontoPagado.ToString("N0")</td>
                            <td style="color:var(--private-muted-text,#64748b);">
                                @(string.IsNullOrEmpty(p.Observacion) ? "—" : p.Observacion)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p style="font-size:0.82rem;color:var(--private-muted-text,#64748b);margin:0;">
            No hay pagos registrados esta semana para este funcionario.
        </p>
    }

</div>
