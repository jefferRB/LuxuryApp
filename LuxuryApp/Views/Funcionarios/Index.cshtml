@model LuxuryApp.Models.Funcionarios.FuncionariosIndexViewModel

<div class="card border-0 shadow-lg">
    <div class="card-header bg-dark text-white py-3">
        <h5 class="m-0">
            <i class="fas fa-user-tie me-2"></i>Funcionarios
        </h5>
    </div>

    <div class="d-flex justify-content-between mt-3 mx-3 mb-3">
        <a asp-action="Create" class="btn btn-dark text-white">
            <i class="fas fa-user-plus me-1"></i>Nuevo Funcionario
        </a>

        <a asp-action="PagosSemana" class="btn btn-success">
            💰 Ver Pagos de la Semana
        </a>

        <button class="btn btn-outline-dark"
                data-bs-toggle="modal"
                data-bs-target="#modalPuestos"
                onclick="cargarPuestos()">
            🏷 Gestionar Puestos
        </button>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success mx-3 mb-0">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mx-3 mb-0">
            @TempData["Error"]
        </div>
    }

    <div class="mt-3 ms-3">
        <span style="font-size: 1.1rem;">
            <strong>Funcionarios registrados:</strong> @Model.TotalFuncionarios
        </span>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nombre</th>
                        <th>Telefono</th>
                        <th>Puesto</th>
                        <th>% Ganancia</th>
                        <th>% Producto</th>
                        <th>Color</th>
                        <th>Fecha Ingreso</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Funcionarios.Any())
                    {
                        foreach (var f in Model.Funcionarios)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@f.Nombre</td>
                                <td>@f.Telefono</td>
                                <td>@f.NombrePuesto</td>
                                <td>@f.PorcentajeGanancia %</td>
                                <td>@f.PorcentajeProducto %</td>
                                <td>
                                    <span class="badge" style="background-color:@f.ColorCalendario;">
                                        @f.ColorCalendario
                                    </span>
                                </td>
                                <td>@f.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (f.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit"
                                       asp-route-id="@f.IdFuncionario"
                                       class="btn btn-sm btn-dark">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                No hay funcionarios registrados
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalPuestos" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Gestionar Puestos</h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div id="contenedorPuestos"></div>
            </div>
        </div>
    </div>
</div>
