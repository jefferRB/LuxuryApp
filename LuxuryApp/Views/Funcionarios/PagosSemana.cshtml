@model LuxuryApp.Models.Funcionarios.PagosSemanaPageViewModel

@{
    var inicio          = Model.InicioSemana;
    var fin             = Model.FinSemana;
    var ahora           = Model.FechaPagoSugerida;
    var metodosPago     = Model.MetodosPago;
    var semanaAnterior  = inicio.AddDays(-7);
    var semanaSiguiente = inicio.AddDays(7);
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/funcionarios.css" asp-append-version="true">

<div class="kpi-card func-main-card">

    <!-- ── CABECERA ── -->
    <div class="func-header">
        <div class="func-header-left">
            <span class="func-eyebrow">
                <i class="bi bi-cash-coin"></i>
                Nómina semanal
            </span>
            <div class="func-brand-row">
                <div class="func-brand-icon">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <h2 class="func-title">Pago Semanal</h2>
                    <p class="func-subtitle">Revisa y registra los pagos del equipo para la semana seleccionada.</p>
                </div>
            </div>
        </div>

        <div class="func-header-stats">
            <div class="func-stat-chip">
                <span class="func-stat-top-label">Funcionarios</span>
                <i class="bi bi-people func-stat-icon"></i>
                <span class="func-stat-num">@Model.Funcionarios.Count()</span>
                <span class="func-stat-sub">en nómina</span>
            </div>
        </div>
    </div>

    <!-- ── ALERTAS ── -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="func-alert-wrap">
            <div class="func-alert func-alert--success">
                <i class="bi bi-check-circle-fill"></i>
                @TempData["Mensaje"]
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="func-alert-wrap">
            <div class="func-alert func-alert--danger">
                <i class="bi bi-exclamation-triangle-fill"></i>
                @TempData["Error"]
            </div>
        </div>
    }

    <!-- ── NAVEGACIÓN DE SEMANA ── -->
    <div class="func-week-nav">
        <a asp-action="PagosSemana"
           asp-route-fecha="@semanaAnterior.ToString("yyyy-MM-dd")"
           class="func-btn func-btn--ghost">
            <i class="bi bi-chevron-left"></i>
            Semana anterior
        </a>

        <div class="func-week-center">
            <span class="func-week-label">Semana activa</span>
            <span class="func-week-range">
                @inicio.ToString("dd MMM") — @fin.ToString("dd MMM yyyy")
            </span>
        </div>

        <a asp-action="PagosSemana"
           asp-route-fecha="@semanaSiguiente.ToString("yyyy-MM-dd")"
           class="func-btn func-btn--ghost">
            Semana siguiente
            <i class="bi bi-chevron-right"></i>
        </a>
    </div>

    <!-- ── CONTROLES: Selector de fecha + Pagar semana + Exportar ── -->
    <div class="func-pagos-controls">

        <!-- Seleccionar semana por fecha -->
        <form method="get" asp-action="PagosSemana" style="display:contents;">
            <div class="func-pagos-control-group">
                <span class="func-pagos-control-label">Ir a semana</span>
                <input type="date"
                       name="fecha"
                       class="func-input func-input--no-icon"
                       style="width:auto;padding-left:0.875rem;"
                       value="@inicio.ToString("yyyy-MM-dd")"
                       onchange="this.form.submit()" />
            </div>
        </form>

        <div class="func-pagos-sep"></div>

        <!-- Pagar toda la semana -->
        <form method="post" asp-action="PagarTodaLaSemana" style="display:contents;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="inicioSemana" value="@inicio.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="finSemana" value="@fin.ToString("yyyy-MM-dd")" />

            <div class="func-pagos-control-group">
                <span class="func-pagos-control-label">Método de pago</span>
                <select name="metodoPago" class="func-input func-select func-modal-select"
                        style="width:auto;padding-left:0.875rem;">
                    @foreach (var metodo in metodosPago)
                    {
                        <option value="@metodo">@metodo</option>
                    }
                </select>
            </div>

            <div class="func-pagos-control-group">
                <span class="func-pagos-control-label">Fecha de pago</span>
                <input type="datetime-local"
                       name="fechaPago"
                       class="func-input"
                       style="padding-left:0.875rem;"
                       value="@ahora.ToString("yyyy-MM-ddTHH:mm")" />
            </div>

            <div class="func-pagos-control-group">
                <span class="func-pagos-control-label">Observación (opcional)</span>
                <input type="text"
                       name="observacion"
                       class="func-input"
                       style="padding-left:0.875rem;"
                       placeholder="Ej: Liquidación semana completa" />
            </div>

            <div class="func-pagos-control-group" style="justify-content:flex-end;">
                <button type="submit" class="func-btn func-btn--primary">
                    <i class="bi bi-coin"></i>
                    Pagar toda la semana
                </button>
            </div>
        </form>

        <div class="func-pagos-sep"></div>

        <!-- Exportar Excel -->
        <form method="get" asp-action="ExportarPagosExcel" style="display:contents;">
            <input type="hidden" name="inicioSemana" value="@inicio.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="finSemana" value="@fin.ToString("yyyy-MM-dd")" />
            <div class="func-pagos-control-group" style="justify-content:flex-end;">
                <button type="submit" class="func-btn func-btn--ghost">
                    <i class="bi bi-file-earmark-excel"></i>
                    Exportar Excel
                </button>
            </div>
        </form>

    </div>

    <!-- ── KPI GRID ── -->
    <div class="func-pagos-kpi-grid">

        <div class="func-pagos-kpi func-pagos-kpi--blue">
            <span class="func-pagos-kpi-label">
                <i class="bi bi-scissors"></i> Total Servicios
            </span>
            <span class="func-pagos-kpi-value">₡ @Model.TotalGeneradoServicios.ToString("N0")</span>
        </div>

        <div class="func-pagos-kpi func-pagos-kpi--teal">
            <span class="func-pagos-kpi-label">
                <i class="bi bi-box-seam"></i> Total Productos
            </span>
            <span class="func-pagos-kpi-value">₡ @Model.TotalGeneradoProductos.ToString("N0")</span>
        </div>

        <div class="func-pagos-kpi func-pagos-kpi--green">
            <span class="func-pagos-kpi-label">
                <i class="bi bi-graph-up-arrow"></i> Total Generado
            </span>
            <span class="func-pagos-kpi-value">₡ @Model.TotalGeneradoGeneral.ToString("N0")</span>
        </div>

        <div class="func-pagos-kpi">
            <span class="func-pagos-kpi-label">
                <i class="bi bi-calculator"></i> Sin Impuestos
            </span>
            <span class="func-pagos-kpi-value">₡ @Model.TotalSinImpuestosGeneral.ToString("N0")</span>
        </div>

        <div class="func-pagos-kpi func-pagos-kpi--red">
            <span class="func-pagos-kpi-label">
                <i class="bi bi-percent"></i> Impuestos (13%)
            </span>
            <span class="func-pagos-kpi-value">₡ @Model.TotalImpuestosGeneral.ToString("N0")</span>
        </div>

        <div class="func-pagos-kpi func-pagos-kpi--green">
            <span class="func-pagos-kpi-label">
                <i class="bi bi-check-circle"></i> Total Pagado
            </span>
            <span class="func-pagos-kpi-value">₡ @Model.TotalPagadoGeneral.ToString("N0")</span>
        </div>

        <div class="func-pagos-kpi func-pagos-kpi--amber">
            <span class="func-pagos-kpi-label">
                <i class="bi bi-clock"></i> Pendiente
            </span>
            <span class="func-pagos-kpi-value">₡ @Model.TotalPendienteGeneral.ToString("N0")</span>
        </div>

        <div class="func-pagos-kpi func-pagos-kpi--purple">
            <span class="func-pagos-kpi-label">
                <i class="bi bi-building"></i> Ganancia Negocio
            </span>
            <span class="func-pagos-kpi-value">₡ @Model.GananciaNegocio.ToString("N0")</span>
        </div>

    </div>

    <!-- ── TABLA DE EMPLEADOS ── -->
    <div class="func-table-wrap">
        <table class="func-table" style="min-width:900px;">

            <thead>
                <tr>
                    <th style="padding-left:2rem;">Funcionario</th>
                    <th>Total Generado</th>
                    <th>Impuestos</th>
                    <th>Total Neto</th>
                    <th>% Servicio</th>
                    <th>% Producto</th>
                    <th>A Pagar</th>
                    <th>Pagado</th>
                    <th>Pendiente</th>
                    <th class="text-center" style="padding-right:2rem;"></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var f in Model.Funcionarios)
                {
                    <tr>

                        <!-- Nombre + expand -->
                        <td style="padding-left:2rem;">
                            <div class="func-pagos-employee-name">
                                <button class="func-pagos-expand-btn"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#detalle_@f.FuncionarioId"
                                        aria-expanded="false">
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                                <span class="func-name">@f.Nombre</span>
                            </div>
                        </td>

                        <td class="func-amount--muted">₡ @f.TotalGenerado.ToString("N0")</td>

                        <td class="func-amount--red">₡ @f.Impuestos.ToString("N0")</td>

                        <td style="font-weight:700;color:var(--private-surface-text,#111827);">
                            ₡ @f.TotalNeto.ToString("N0")
                        </td>

                        <td>
                            <span class="func-status func-status--inactive" style="font-size:0.78rem;">
                                @f.Porcentaje %
                            </span>
                        </td>

                        <td>
                            <span class="func-status func-status--inactive" style="font-size:0.78rem;">
                                @f.PorcentajeProducto %
                            </span>
                        </td>

                        <td class="func-amount--blue">₡ @f.PagoFinal.ToString("N0")</td>

                        <td class="func-amount--green">₡ @f.MontoPagado.ToString("N0")</td>

                        <td class="@(f.MontoPendiente > 0 ? "func-amount--red" : "func-amount--green")">
                            ₡ @f.MontoPendiente.ToString("N0")
                        </td>

                        <!-- Acción: Pagar -->
                        <td class="text-center" style="padding-right:2rem;">
                            @if (f.MontoPendiente > 0)
                            {
                                <button type="button"
                                        class="func-pagos-pay-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalPago"
                                        data-fid="@f.FuncionarioId"
                                        data-nombre="@f.Nombre"
                                        data-monto="@f.MontoPendiente"
                                        data-pagofinal="@f.PagoFinal"
                                        data-pagado="@f.MontoPagado"
                                        onclick="setPagoFromBtn(this)">
                                    <i class="bi bi-coin"></i>
                                    Pagar
                                </button>
                            }
                            else
                            {
                                <span style="font-size:0.75rem;color:var(--private-chart-success,#16a34a);font-weight:600;">
                                    <i class="bi bi-check-circle-fill"></i> Al día
                                </span>
                            }
                        </td>

                    </tr>

                    <!-- ── FILA DETALLE (collapsible) ── -->
                    <tr class="collapse func-pagos-detail" id="detalle_@f.FuncionarioId">
                        <td colspan="10">
                            <div class="func-pagos-detail-inner">

                                <!-- Producción por día -->
                                @if (f.DetalleDias.Any())
                                {
                                    <div class="func-pagos-detail-title">
                                        <i class="bi bi-calendar-week"></i>
                                        Producción por día
                                    </div>
                                    <div class="func-day-cards">
                                        @foreach (var d in f.DetalleDias)
                                        {
                                            <div class="func-day-card">
                                                <span class="func-day-name">@d.Dia</span>
                                                <span class="func-day-count">@d.CantidadServicios</span>
                                                <span class="func-day-amount">₡ @d.Monto.ToString("N0")</span>
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- Productos vendidos -->
                                @if (f.ProductosVendidos.Any())
                                {
                                    <div class="func-pagos-detail-title" style="margin-top:0.25rem;">
                                        <i class="bi bi-box-seam"></i>
                                        Productos vendidos
                                    </div>
                                    <div style="overflow-x:auto;">
                                        <table class="func-pagos-subtable">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Producto</th>
                                                    <th>Precio</th>
                                                    <th>Ganancia funcionario</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var p in f.ProductosVendidos)
                                                {
                                                    <tr>
                                                        <td class="func-date">@p.Fecha.ToString("dd MMM yyyy")</td>
                                                        <td>@p.NombreProducto</td>
                                                        <td style="font-weight:600;">₡ @p.Precio.ToString("N0")</td>
                                                        <td class="func-amount--green">₡ @p.GananciaFuncionario.ToString("N0")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                <!-- Historial de pagos -->
                                <div class="func-pagos-detail-title" style="margin-top:@(f.ProductosVendidos.Any() ? "1.25rem" : "0.25rem");">
                                    <i class="bi bi-receipt"></i>
                                    Historial de pagos esta semana
                                </div>
                                @if (f.HistorialPagos.Any())
                                {
                                    <div style="overflow-x:auto;">
                                        <table class="func-pagos-subtable">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Monto</th>
                                                    <th>Observación</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var p in f.HistorialPagos)
                                                {
                                                    <tr>
                                                        <td class="func-date">@p.FechaPago.ToString("dd MMM yyyy HH:mm")</td>
                                                        <td class="func-amount--green">₡ @p.MontoPagado.ToString("N0")</td>
                                                        <td style="color:var(--private-muted-text,#64748b);">
                                                            @(string.IsNullOrEmpty(p.Observacion) ? "—" : p.Observacion)
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <p style="font-size:0.82rem;color:var(--private-muted-text,#64748b);margin:0;">
                                        No hay pagos registrados esta semana para este funcionario.
                                    </p>
                                }

                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

    @if (!Model.Funcionarios.Any())
    {
        <div class="func-empty">
            <i class="bi bi-people func-empty-icon"></i>
            <span class="func-empty-text">No hay funcionarios activos en esta semana</span>
        </div>
    }

</div>

<!-- ── MODAL: REGISTRAR PAGO INDIVIDUAL ── -->
<div class="modal fade func-modal" id="modalPago" tabindex="-1" aria-labelledby="lblModalPago">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="RegistrarPago" id="formRegistrarPago">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <div style="display:flex;align-items:center;gap:0.65rem;">
                        <div class="func-brand-icon" style="width:2.2rem;height:2.2rem;font-size:1rem;flex-shrink:0;background:linear-gradient(135deg,rgba(22,163,74,0.18),rgba(5,150,105,0.18));">
                            <i class="bi bi-coin" style="color:#16a34a;"></i>
                        </div>
                        <div>
                            <h5 class="func-modal-title func-modal-title--green" id="lblModalPago" style="margin:0;">
                                Registrar pago
                            </h5>
                            <p style="font-size:0.73rem;color:var(--private-muted-text,#64748b);margin:0;line-height:1.3;">
                                Pago completo o parcial al funcionario
                            </p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="funcionarioId" id="funcionarioId" />
                    <input type="hidden" name="inicioSemana" value="@inicio.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="finSemana" value="@fin.ToString("yyyy-MM-dd")" />

                    <!-- Resumen del funcionario -->
                    <div class="func-pago-summary">
                        <div class="func-pago-summary-avatar" id="pagoSummaryAvatar">?</div>
                        <div class="func-pago-summary-info">
                            <span class="func-pago-summary-name" id="pagoSummaryNombre"></span>
                            <div class="func-pago-summary-grid">
                                <div class="func-pago-summary-item">
                                    <span class="func-pago-summary-label">A pagar</span>
                                    <span class="func-pago-summary-val func-pago-summary-val--green" id="pagoSummaryTotal">—</span>
                                </div>
                                <div class="func-pago-summary-item">
                                    <span class="func-pago-summary-label">Pagado</span>
                                    <span class="func-pago-summary-val func-pago-summary-val--green" id="pagoSummaryPagado">—</span>
                                </div>
                                <div class="func-pago-summary-item">
                                    <span class="func-pago-summary-label">Pendiente</span>
                                    <span class="func-pago-summary-val func-pago-summary-val--amber" id="pagoSummaryPendiente">—</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Monto a pagar (campo principal) -->
                    <div class="func-modal-field">
                        <label class="func-modal-label">
                            Monto a pagar <span class="func-required">*</span>
                        </label>
                        <div class="func-modal-input-wrap">
                            <span class="func-modal-input-icon"><i class="bi bi-currency-dollar"></i></span>
                            <input type="number"
                                   name="monto"
                                   id="montoPago"
                                   class="func-modal-input func-modal-input--with-icon func-modal-input--prominent func-modal-input--with-max"
                                   min="0.01"
                                   step="0.01"
                                   required
                                   placeholder="0" />
                            <button type="button"
                                    id="btnMaxPago"
                                    class="func-modal-max-btn"
                                    onclick="setMaxPago()"
                                    title="Llenar con el monto pendiente máximo"
                                    disabled>
                                MAX
                            </button>
                        </div>
                        <span class="func-modal-hint">Puedes registrar pagos completos o parciales.</span>
                    </div>

                    <!-- Método de pago -->
                    <div class="func-modal-field">
                        <label class="func-modal-label">
                            Método de pago <span class="func-required">*</span>
                        </label>
                        <div class="func-modal-input-wrap">
                            <span class="func-modal-input-icon"><i class="bi bi-credit-card"></i></span>
                            <select name="metodoPago"
                                    class="func-modal-input func-modal-input--with-icon func-modal-select"
                                    required>
                                @foreach (var metodo in metodosPago)
                                {
                                    <option value="@metodo">@metodo</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Fecha real del pago -->
                    <div class="func-modal-field">
                        <label class="func-modal-label">Fecha real del pago</label>
                        <div class="func-modal-input-wrap">
                            <span class="func-modal-input-icon"><i class="bi bi-calendar3"></i></span>
                            <input type="datetime-local"
                                   name="fechaPago"
                                   class="func-modal-input func-modal-input--with-icon"
                                   value="@ahora.ToString("yyyy-MM-ddTHH:mm")"
                                   style="color-scheme:dark;" />
                        </div>
                    </div>

                    <!-- Observaciones -->
                    <div class="func-modal-field">
                        <label class="func-modal-label">Observaciones (opcional)</label>
                        <div class="func-modal-input-wrap">
                            <span class="func-modal-input-icon func-modal-input-icon--top"><i class="bi bi-chat-left-text"></i></span>
                            <textarea name="observacion"
                                      class="func-modal-input func-modal-input--with-icon"
                                      style="resize:vertical;min-height:4rem;"
                                      placeholder="Ej: Pago completo, adelanto, etc."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="func-btn func-btn--ghost" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" id="btnRegistrarPago" class="func-btn func-btn--primary">
                        <i class="bi bi-check-lg"></i>
                        Registrar pago
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<script>
    function formatCRC(value) {
        return "₡ " + parseFloat(value || 0).toLocaleString("es-CR", { minimumFractionDigits: 0, maximumFractionDigits: 0 });
    }

    function setPagoFromBtn(btn) {
        var nombre    = btn.dataset.nombre || "";
        var inicial   = nombre.length > 0 ? nombre[0].toUpperCase() : "?";
        var pendiente = parseFloat(btn.dataset.monto || 0);

        document.getElementById("funcionarioId").value = btn.dataset.fid;
        document.getElementById("montoPago").value     = pendiente > 0 ? pendiente : "";

        document.getElementById("pagoSummaryAvatar").textContent    = inicial;
        document.getElementById("pagoSummaryNombre").textContent    = nombre;
        document.getElementById("pagoSummaryTotal").textContent     = formatCRC(btn.dataset.pagofinal);
        document.getElementById("pagoSummaryPagado").textContent    = formatCRC(btn.dataset.pagado);
        document.getElementById("pagoSummaryPendiente").textContent = formatCRC(btn.dataset.monto);

        // Botón MAX: guardar el pendiente y habilitar/deshabilitar
        var maxBtn = document.getElementById("btnMaxPago");
        if (maxBtn) {
            maxBtn.dataset.max  = pendiente;
            maxBtn.disabled     = pendiente <= 0;
        }

        // Restaurar botón submit en caso de haber quedado deshabilitado
        var btnSubmit = document.getElementById("btnRegistrarPago");
        if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.innerHTML = '<i class="bi bi-check-lg"></i> Registrar pago';
        }
    }

    function setMaxPago() {
        var maxBtn = document.getElementById("btnMaxPago");
        if (!maxBtn || maxBtn.disabled) return;
        var max = parseFloat(maxBtn.dataset.max || 0);
        if (max > 0) {
            document.getElementById("montoPago").value = max;
            document.getElementById("montoPago").focus();
        }
    }

    // Anti-doble-envío
    document.getElementById("formRegistrarPago").addEventListener("submit", function () {
        var btn = document.getElementById("btnRegistrarPago");
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Registrando...';
        }
    });
</script>
