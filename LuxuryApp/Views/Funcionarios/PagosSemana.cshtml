@model LuxuryApp.Models.Funcionarios.PagosSemanaPageViewModel

@{
    var inicio = Model.InicioSemana;
    var fin = Model.FinSemana;
    var ahora = Model.FechaPagoSugerida;
    var metodosPago = Model.MetodosPago;
    var semanaAnterior = inicio.AddDays(-7);
    var semanaSiguiente = inicio.AddDays(7);
}

<div class="card border-0 shadow-lg">
    <div class="card-header bg-dark text-white py-3">
        <h5 class="m-0">
            <i class="fas fa-user-tie me-2"></i>
            Pago semanal de los funcionarios
        </h5>
    </div>

    <div class="card-body">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success mb-3">
                @TempData["Mensaje"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-3">
                @TempData["Error"]
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-3">
            <a asp-action="PagosSemana"
               asp-route-fecha="@semanaAnterior.ToString("yyyy-MM-dd")"
               class="btn btn-dark">
                ⬅ Semana anterior
            </a>

            <h5 class="m-0 text-center">
                Semana
                <strong>
                    @inicio.ToString("dd MMM")
                    -
                    @fin.ToString("dd MMM yyyy")
                </strong>
            </h5>

            <a asp-action="PagosSemana"
               asp-route-fecha="@semanaSiguiente.ToString("yyyy-MM-dd")"
               class="btn btn-dark">
                Semana siguiente ➡
            </a>
        </div>

        <div class="d-flex justify-content-between align-items-start mb-4">
            <form method="get" asp-action="PagosSemana">
                <div class="row">
                    <div class="col-md-12">
                        <label class="form-label">Seleccionar semana</label>
                        <input type="date"
                               name="fecha"
                               class="form-control"
                               value="@inicio.ToString("yyyy-MM-dd")"
                               onchange="this.form.submit()" />
                    </div>
                </div>
            </form>

            <form method="post" asp-action="PagarTodaLaSemana" class="d-flex align-items-end gap-2 flex-wrap">
                @Html.AntiForgeryToken()
                <input type="hidden" name="inicioSemana" value="@inicio.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="finSemana" value="@fin.ToString("yyyy-MM-dd")" />

                <div>
                    <label class="form-label mb-1">Metodo</label>
                    <select name="metodoPago" class="form-select">
                        @foreach (var metodo in metodosPago)
                        {
                            <option value="@metodo">@metodo</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label mb-1">Fecha pago</label>
                    <input type="datetime-local"
                           name="fechaPago"
                           class="form-control"
                           value="@ahora.ToString("yyyy-MM-ddTHH:mm")" />
                </div>

                <div>
                    <label class="form-label mb-1">Observacion</label>
                    <input type="text"
                           name="observacion"
                           class="form-control"
                           placeholder="Opcional" />
                </div>

                <button class="btn btn-success mt-4">
                    <i class="fas fa-coins me-2"></i>
                    Pagar toda la semana
                </button>
            </form>

            <form method="get" asp-action="ExportarPagosExcel">
                <input type="hidden" name="inicioSemana" value="@inicio.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="finSemana" value="@fin.ToString("yyyy-MM-dd")" />

                <button class="btn btn-dark mt-4 ms-2">
                    <i class="fas fa-file-excel me-2"></i>
                    Exportar Excel
                </button>
            </form>
        </div>

        <div class="container-fluid px-3">
            <div class="row g-3 mb-3">
                <div class="col-lg-3 col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <h6 class="text-muted">
                                <i class="fas fa-cut me-1"></i>Total en Servicios
                            </h6>
                            <h3 class="fw-bold text-primary">
                                ₡ @Model.TotalGeneradoServicios.ToString("N2")
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <h6 class="text-muted">
                                <i class="fas fa-box me-1"></i>Total en Productos
                            </h6>
                            <h3 class="fw-bold text-info">
                                ₡ @Model.TotalGeneradoProductos.ToString("N2")
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <h6 class="text-muted">
                                <i class="fas fa-money-bill-wave me-1"></i>Total generado
                            </h6>
                            <h3 class="fw-bold text-success">
                                ₡ @Model.TotalGeneradoGeneral.ToString("N2")
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <h6 class="text-muted">
                                <i class="fas fa-calculator me-1"></i>Total sin impuestos
                            </h6>
                            <h3 class="fw-bold text-dark">
                                ₡ @Model.TotalSinImpuestosGeneral.ToString("N2")
                            </h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-lg-3 col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <h6 class="text-muted">
                                <i class="fas fa-percentage me-1"></i>Total de Impuestos
                            </h6>
                            <h3 class="fw-bold text-primary">
                                ₡ @Model.TotalImpuestosGeneral.ToString("N2")
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <h6 class="text-muted">
                                <i class="fas fa-hand-holding-usd me-1"></i>Total pagado
                            </h6>
                            <h3 class="fw-bold text-info">
                                ₡ @Model.TotalPagadoGeneral.ToString("N2")
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <h6 class="text-muted">
                                <i class="fas fa-clock me-1"></i>Monto Pendiente
                            </h6>
                            <h3 class="fw-bold text-success">
                                ₡ @Model.TotalPendienteGeneral.ToString("N2")
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="card border-0 shadow-sm h-100 border-success">
                        <div class="card-body text-center">
                            <h6 class="text-muted">
                                <i class="fas fa-chart-line me-1"></i>Ganancia negocio
                            </h6>
                            <h3 class="fw-bold text-dark">
                                ₡ @Model.GananciaNegocio.ToString("N2")
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive mt-4">
            <table class="table table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Funcionario</th>
                        <th>Total Generado</th>
                        <th>Impuestos</th>
                        <th>Total Neto</th>
                        <th>% Servicio</th>
                        <th>% Producto</th>
                        <th>Monto Generado</th>
                        <th>Monto Pagado</th>
                        <th>Pendiente</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var f in Model.Funcionarios)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <button class="btn btn-sm btn-light border me-2"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#detalle_@f.FuncionarioId">
                                    <i class="fas fa-chevron-down"></i>
                                </button>

                                <span class="fw-bold">@f.Nombre</span>
                            </td>

                            <td>
                                <span class="text-muted">₡</span>
                                @f.TotalGenerado.ToString("N0")
                            </td>

                            <td class="text-danger">
                                ₡ @f.Impuestos.ToString("N0")
                            </td>

                            <td class="fw-bold">
                                ₡ @f.TotalNeto.ToString("N0")
                            </td>

                            <td>
                                <span class="badge bg-dark">
                                    @f.Porcentaje %
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-dark">
                                    @f.PorcentajeProducto %
                                </span>
                            </td>

                            <td class="fw-bold text-primary fs-6">
                                ₡ @f.PagoFinal.ToString("N0")
                            </td>

                            <td class="text-success fw-bold">
                                ₡ @f.MontoPagado.ToString("N0")
                            </td>

                            <td class="fw-bold text-danger">
                                ₡ @f.MontoPendiente.ToString("N0")
                            </td>

                            <td>
                                @if (f.MontoPendiente > 0)
                                {
                                    <button class="btn btn-success btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalPago"
                                            onclick="setPago(@f.FuncionarioId, '@f.Nombre', @f.MontoPendiente)">
                                        <i class="fas fa-coins me-1"></i>
                                        Pagar
                                    </button>
                                }
                            </td>
                        </tr>

                        <tr class="collapse table-light" id="detalle_@f.FuncionarioId">
                            <td colspan="10">
                                <div class="row g-3 mb-4">
                                    <h6 class="fw-bold mb-3">
                                        <i class="fas fa-calendar-week me-2"></i>
                                        Produccion por dia
                                    </h6>

                                    <div class="row row-cols-7 g-2">
                                        @foreach (var d in f.DetalleDias)
                                        {
                                            <div class="col">
                                                <div class="card border-0 shadow-sm h-100">
                                                    <div class="card-body text-center p-2">
                                                        <div class="fw-bold text-dark small">
                                                            @d.Dia
                                                        </div>

                                                        <span class="badge bg-secondary mb-1">
                                                            @d.CantidadServicios
                                                        </span>

                                                        <div class="fw-bold text-success small">
                                                            ₡ @d.Monto.ToString("N0")
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (f.ProductosVendidos.Any())
                                {
                                    <h6 class="fw-bold mt-4 mb-3">
                                        <i class="fas fa-box me-2"></i>
                                        Productos vendidos
                                    </h6>

                                    <table class="table table-sm table-bordered">
                                        <thead class="table-secondary">
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Producto</th>
                                                <th>Precio</th>
                                                <th>Ganancia funcionario</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (var p in f.ProductosVendidos)
                                            {
                                                <tr>
                                                    <td>@p.Fecha.ToString("dd MMM yyyy")</td>
                                                    <td>@p.NombreProducto</td>
                                                    <td class="fw-bold">₡ @p.Precio.ToString("N0")</td>
                                                    <td class="text-success fw-bold">₡ @p.GananciaFuncionario.ToString("N0")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }

                                @if (f.HistorialPagos.Any())
                                {
                                    <h6 class="fw-bold mt-4 mb-3">
                                        <i class="fas fa-box me-2"></i>
                                        Historial de pagos
                                    </h6>

                                    <table class="table table-sm table-bordered">
                                        <thead class="table-secondary">
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Monto</th>
                                                <th>Observacion</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (var p in f.HistorialPagos)
                                            {
                                                <tr>
                                                    <td>@p.FechaPago.ToString("dd MMM yyyy HH:mm")</td>
                                                    <td class="text-success fw-bold fs-6">
                                                        ₡ @p.MontoPagado.ToString("N0")
                                                    </td>
                                                    <td>@(string.IsNullOrEmpty(p.Observacion) ? "-" : p.Observacion)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="text-muted">
                                        No hay pagos registrados esta semana.
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalPago" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="RegistrarPago">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-money-bill-wave me-2"></i>
                        Registrar pago
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="funcionarioId" id="funcionarioId" />
                    <input type="hidden" name="inicioSemana" value="@inicio.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="finSemana" value="@fin.ToString("yyyy-MM-dd")" />

                    <div class="mb-3">
                        <label class="form-label">Funcionario</label>
                        <input type="text"
                               id="nombreFuncionario"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Monto a pagar</label>
                        <input type="number"
                               name="monto"
                               id="montoPago"
                               class="form-control"
                               required />

                        <div class="form-text">
                            Puedes registrar pagos completos o parciales.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Metodo de pago</label>
                        <select name="metodoPago" class="form-select" required>
                            @foreach (var metodo in metodosPago)
                            {
                                <option value="@metodo">@metodo</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Fecha real del pago</label>
                        <input type="datetime-local"
                               name="fechaPago"
                               class="form-control"
                               value="@ahora.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Observaciones (opcional)</label>
                        <textarea name="observacion"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Ej: Pago completo, adelanto, compra de bebidas, herramientas, etc."></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-success">
                        <i class="fas fa-check me-1"></i>
                        Registrar pago
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function setPago(id, nombre, pendiente) {
        document.getElementById("funcionarioId").value = id;
        document.getElementById("nombreFuncionario").value = nombre;
        document.getElementById("montoPago").value = pendiente;
    }
</script>
