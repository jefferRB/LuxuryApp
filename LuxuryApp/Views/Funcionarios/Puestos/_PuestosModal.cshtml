@model List<LuxuryApp.Models.Funcionarios.Puesto>

<div class="mb-3">

    <button class="btn btn-dark"
            onclick="mostrarFormularioPuesto()">
        ➕ Nuevo Puesto
    </button>

</div>

<div id="formPuestoContainer"></div>

<table class="table table-striped mt-4">

    <thead>
        <tr>
            <th>Puesto</th>
            <th>Detalle</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombrePuesto</td>
                <td>@item.Detalle</td>

                <td>
                    @if (item.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </td>

                <td>

                    <form asp-action="Edit"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()
                        <input type="hidden"
                               name="IdPuesto"
                               value="@item.IdPuesto" />

                        <input type="hidden"
                               name="NombrePuesto"
                               value="@item.NombrePuesto" />

                        <input type="hidden"
                               name="Detalle"
                               value="@item.Detalle" />

                        <input type="hidden"
                               name="Activo"
                               value="@(item.Activo ? "false" : "true")" />

                        <button class="btn btn-sm @(item.Activo ? "btn-danger" : "btn-success")">
                            @(item.Activo ? "Desactivar" : "Activar")
                        </button>

                    </form>

                </td>
            </tr>
        }

    </tbody>

</table>
