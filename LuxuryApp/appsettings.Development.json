{
    "Payments": {
        "ProveedorPredeterminado": "Tilopay",
        "PublicBaseUrl": "https://sake-bunt-drove.ngrok-free.dev",
        "EnableValidationPlans": true,
        "ValidatePublicCallbackReachability": true
    },
    "TenantOnboarding": {
        "RegistrationRole": "Administrador",
        "AddRegisteredRole": true,
        "RegisteredRole": "Registrado",
        "CreateInitialSubscription": false,
        "InitialSubscriptionState": "Trial",
        "TrialDays": 14
    },
  "Tilopay": {
    "BaseUrl": "https://app.tilopay.com/",
    "TimeoutSeconds": 30,
    "WebhookAccessTokenQueryParameter": "access_token"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
