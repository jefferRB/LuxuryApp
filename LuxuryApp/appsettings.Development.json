{
    "ConnectionStrings": {
        "ConexionSql": "Server=localhost;Database=LuxuryApp;Trusted_Connection=True;Encrypt=False;MultipleActiveResultSets=True"
    },
    "Business": {
        "TimeZoneId": "America/Costa_Rica"
    },
    "Payments": {
        "ProveedorPredeterminado": "Tilopay",
        "PublicBaseUrl": "https://sake-bunt-drove.ngrok-free.dev",
        "EnableValidationPlans": true,
        "ValidatePublicCallbackReachability": true
    },
    "TenantOnboarding": {
        "RegistrationRole": "Administrador",
        "AddRegisteredRole": true,
        "RegisteredRole": "Registrado",
        "CreateInitialSubscription": false,
        "InitialSubscriptionState": "Trial",
        "TrialDays": 14
    },
    "Tilopay": {
        "BaseUrl": "https://app.tilopay.com/",
        "TimeoutSeconds": 30,
        "WebhookAccessTokenQueryParameter": "access_token"
    },
    "MetaWhatsApp": {
        "Enabled": false,
        "GraphApiVersion": "v25.0",
        "BaseUrl": "https://graph.facebook.com",
        "PhoneNumberId": "",
        "WhatsAppBusinessAccountId": "",
        "AccessToken": "",
        "AppSecret": "",
        "WebhookVerifyToken": "",
        "DefaultCountryCode": "506",
        "ConfirmationTemplateName": "luxurycloud_confirmacion_cita_v1",
        "ReminderTemplateName": "luxurycloud_recordatorio_cita_3h_v1",
        "ReminderLeadTimeMinutes": 180,
        "SendConfirmationOnCreate": true,
        "SendReminderBeforeAppointment": true,
        "RequestTimeoutSeconds": 15
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
        }
    }
}
