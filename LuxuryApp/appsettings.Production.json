{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
        }
    },
    "AllowedHosts": "luxurycloud.app;www.luxurycloud.app",
    "Business": {
        "TimeZoneId": "America/Costa_Rica"
    },
    "Payments": {
        "ProveedorPredeterminado": "Tilopay",
        "PublicBaseUrl": "https://www.luxurycloud.app",
        "EnableValidationPlans": false,
        "ValidatePublicCallbackReachability": true
    },
    "TenantOnboarding": {
        "RegistrationRole": "Administrador",
        "AddRegisteredRole": true,
        "RegisteredRole": "Registrado",
        "CreateInitialSubscription": false,
        "InitialSubscriptionState": "Trial",
        "TrialDays": 14
    },
    "Tilopay": {
        "BaseUrl": "https://app.tilopay.com/",
        "TimeoutSeconds": 30,
        "WebhookAccessTokenQueryParameter": "access_token"
    },
    "Email": {
        "SmtpHost": "smtp.resend.com",
        "SmtpPort": "587",
        "SmtpUsername": "resend"
    },
    "Twilio": {
        "WhatsAppFrom": "whatsapp:+14155238886"
    }
}
